# Mailchimp Configuration
# Copy this file to .env and fill in your actual values

# Your Mailchimp API Key (get it from: Account → Extras → API keys)
MAILCHIMP_API_KEY=your_api_key_here

# Your Audience/List ID (get it from: Audience → Settings → Audience name and defaults)
MAILCHIMP_LIST_ID=0c505d5541

# Mailchimp server prefix (usually found in your dashboard URL or API key)
# Examples: us1, us2, us3, etc.
MAILCHIMP_SERVER=us1
