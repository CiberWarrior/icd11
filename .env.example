# Mailchimp Configuration
# Copy this file to .env and fill in your actual values
#
# IMPORTANT: 
# - Replace 'your_api_key_here' with your actual Mailchimp API key
# - Never commit .env file to Git (it's already in .gitignore)
# - Keep this file secure and never share it publicly

# Your Mailchimp API Key
# Get it from: Mailchimp → Account → Extras → API keys
# Format: abc123def456-us22 (usually ends with server prefix)
MAILCHIMP_API_KEY=your_api_key_here

# Your Audience/List ID
# Get it from: Mailchimp → Audience → Settings → Audience name and defaults
# Format: abc123xyz456 (alphanumeric string)
MAILCHIMP_LIST_ID=your_list_id_here

# Mailchimp server prefix
# Usually found in your API key (e.g., -us22) or dashboard URL
# Common values: us1, us2, us3, ..., us22
MAILCHIMP_SERVER=us22
