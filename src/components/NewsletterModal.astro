---
import NewsletterForm from './NewsletterForm.astro';
---

<div
  data-newsletter-modal-root
  class="fixed inset-0 z-[80] hidden items-end sm:items-center justify-center p-0 sm:p-6"
  aria-hidden="true"
>
  <button
    type="button"
    data-newsletter-close
    aria-label="Close newsletter popup"
    class="absolute inset-0 bg-slate-900/60"
  ></button>

  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="newsletter-modal-title"
    class="relative w-full sm:max-w-4xl bg-white sm:rounded-2xl shadow-2xl overflow-hidden"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="bg-gradient-to-br from-[#1e3c72] to-[#2a5298] p-8 sm:p-10 text-white">
        <p class="text-xs font-bold tracking-[0.25em] uppercase text-blue-200 mb-4">Stay Connected</p>
        <h3 id="newsletter-modal-title" class="text-2xl sm:text-3xl font-bold leading-tight mb-4">
          Get ICD XI updates first
        </h3>
        <p class="text-blue-100 leading-relaxed mb-6">
          Join our newsletter for registration deadlines, program highlights, and key congress announcements.
        </p>
        <div class="space-y-2 text-sm text-blue-100">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Important date reminders</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Program and venue news</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>No spam, only congress updates</span>
          </div>
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-white">
        <div class="flex items-center justify-between mb-4">
          <p class="text-sm font-semibold text-gray-800">Sign up for our newsletter</p>
          <button
            type="button"
            data-newsletter-close
            aria-label="Close newsletter popup"
            class="w-8 h-8 rounded-lg border border-gray-200 text-gray-500"
          >
            <span class="sr-only">Close</span>
            <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <NewsletterForm />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_SHOWN_AT = 'icd_newsletter_modal_last_shown_at';
    const STORAGE_SUBSCRIBED = 'icd_newsletter_subscribed';
    const MODAL_COOLDOWN_MS = 7 * 24 * 60 * 60 * 1000;
    const TRIGGER_DELAY_MS = 45000;
    const TRIGGER_SCROLL_RATIO = 0.5;

    const initModal = () => {
      const modalRoot = document.querySelector('[data-newsletter-modal-root]');
      if (!modalRoot || modalRoot.dataset.initialized === 'true') {
        return;
      }
      modalRoot.dataset.initialized = 'true';

      const closeButtons = modalRoot.querySelectorAll('[data-newsletter-close]');
      let hasAutoOpened = false;

      const markAsShown = () => {
        localStorage.setItem(STORAGE_SHOWN_AT, String(Date.now()));
      };

      const isSubscribed = () => localStorage.getItem(STORAGE_SUBSCRIBED) === 'true';

      const canAutoOpen = () => {
        if (isSubscribed()) {
          return false;
        }
        const lastShownAtRaw = localStorage.getItem(STORAGE_SHOWN_AT);
        const lastShownAt = lastShownAtRaw ? Number(lastShownAtRaw) : 0;
        if (!Number.isNaN(lastShownAt) && Date.now() - lastShownAt < MODAL_COOLDOWN_MS) {
          return false;
        }
        return true;
      };

      const closeModal = () => {
        modalRoot.classList.add('hidden');
        modalRoot.classList.remove('flex');
        modalRoot.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('overflow-hidden');
        if (window.location.hash === '#newsletter') {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      };

      // force: true = user clicked a link (bypass cooldown); auto triggers stay polite
      const openModal = ({ force = false } = {}) => {
        if (isSubscribed()) {
          return;
        }
        if (!force) {
          if (hasAutoOpened || !canAutoOpen()) {
            return;
          }
          hasAutoOpened = true;
        }
        markAsShown();
        modalRoot.classList.remove('hidden');
        modalRoot.classList.add('flex');
        modalRoot.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('overflow-hidden');
      };

      const onScroll = () => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll <= 0) {
          return;
        }
        const scrollRatio = window.scrollY / maxScroll;
        if (scrollRatio >= TRIGGER_SCROLL_RATIO) {
          openModal();
          window.removeEventListener('scroll', onScroll);
        }
      };

      closeButtons.forEach((btn) => {
        btn.addEventListener('click', closeModal);
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeModal();
        }
      });

      modalRoot.addEventListener('newsletter:subscribed', () => {
        localStorage.setItem(STORAGE_SUBSCRIBED, 'true');
        // Keep modal open briefly so the welcome message is readable
        window.setTimeout(() => {
          closeModal();
        }, 3500);
      });

      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-newsletter-open], a[href="#newsletter"], a[href="/#newsletter"]');
        if (!trigger) {
          return;
        }
        event.preventDefault();
        openModal({ force: true });
      });

      if (window.location.hash === '#newsletter') {
        openModal({ force: true });
      }

      window.setTimeout(() => {
        openModal();
      }, TRIGGER_DELAY_MS);

      window.addEventListener('scroll', onScroll, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initModal);
    } else {
      initModal();
    }
  })();
</script>
