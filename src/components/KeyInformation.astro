---
import Card from './Card.astro';

// Import icons
import calendar from 'heroicons/24/outline/calendar.svg?raw';
import users from 'heroicons/24/outline/user-group.svg?raw';
import globe from 'heroicons/24/outline/globe-alt.svg?raw';
import clock from 'heroicons/24/outline/clock.svg?raw';
import presentation from 'heroicons/24/outline/presentation-chart-bar.svg?raw';
import document from 'heroicons/24/outline/document-text.svg?raw';

interface Stat {
  number: string;
  label: string;
  icon: string;
  iconSvg: string;
}

const stats: Stat[] = [
  {
    number: '11th',
    label: 'Edition',
    icon: 'calendar',
    iconSvg: calendar,
  },
  {
    number: '500+',
    label: 'Expected Participants',
    icon: 'users',
    iconSvg: users,
  },
  {
    number: '50+',
    label: 'Countries',
    icon: 'globe',
    iconSvg: globe,
  },
  {
    number: '7',
    label: 'Days',
    icon: 'clock',
    iconSvg: clock,
  },
  {
    number: '100+',
    label: 'Presentations',
    icon: 'presentation',
    iconSvg: presentation,
  },
  {
    number: '50+',
    label: 'Posters',
    icon: 'document',
    iconSvg: document,
  },
];
---

<section class="section-padding bg-white">
  <div class="section-container">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Congress at a Glance
      </h2>
      <p class="text-xl text-gray-600">
        Join us for an exceptional scientific gathering bringing together the
        global dipterology community.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {stats.map((stat) => (
        <Card variant="elevated" class="p-6 text-center animate-fade-in-up">
          <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg">
            <span class="w-6 h-6 text-white" set:html={stat.iconSvg} />
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-gray-900 mb-2">
            {stat.number}
          </div>
          <div class="text-sm text-gray-600 font-medium">{stat.label}</div>
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
  /* Ensure Heroicon SVGs display correctly */
  .w-12 span :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
