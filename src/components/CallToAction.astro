---
import Button from './Button.astro';

interface Props {
  registrationUrl?: string;
  abstractUrl?: string;
}

const {
  registrationUrl = '/registration',
  abstractUrl = '/registration/abstract-submission',
} = Astro.props;
---

<section class="section-padding bg-gradient-primary relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 right-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
  </div>

  <div class="section-container relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
        Ready to Join Us?
      </h2>
      <p class="text-xl text-white/90 leading-relaxed mb-8">
        Register now to secure your spot at the 11th International Congress of
        Dipterology. Early bird registration available until March 31, 2027.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button variant="accent" size="lg" href={registrationUrl}>
          Register Now
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"
            />
          </svg>
        </Button>
        <Button variant="secondary" size="lg" href={abstractUrl}>
          Submit Abstract
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
        </Button>
      </div>

      <!-- Important dates -->
      <div class="mt-12 pt-8 border-t border-white/20">
        <p class="text-white/80 text-sm mb-4">Important Dates:</p>
        <div class="flex flex-wrap justify-center gap-6 text-white/90 text-sm">
          <div>
            <span class="font-semibold">Early Bird:</span> March 31, 2027
          </div>
          <div>
            <span class="font-semibold">Abstract Deadline:</span> April 30, 2027
          </div>
          <div>
            <span class="font-semibold">Regular Registration:</span> June 15, 2027
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
