---
import calendar from 'heroicons/24/outline/calendar.svg?raw';
import mapPin from 'heroicons/24/outline/map-pin.svg?raw';
---

<!-- Unified site hero -->
<section class="relative overflow-hidden hero-gradient">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute left-10 top-10 h-96 w-96 rounded-full bg-white/30 blur-3xl animate-pulse"></div>
    <div class="absolute bottom-10 right-10 h-[500px] w-[500px] rounded-full bg-white/20 blur-3xl"></div>
    <div class="absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 transform rounded-full bg-white/10 blur-3xl"></div>
  </div>

  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"
  >
  </div>

  <div class="relative section-container py-12 sm:py-14 lg:py-[4.5rem]">
    <div
      class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.12fr)_minmax(320px,0.88fr)] lg:gap-10 xl:gap-14"
    >
      <div class="max-w-2xl text-white animate-fade-in-up">
        <h1
          class="max-w-[11ch] text-4xl font-bold leading-[1.02] tracking-tight text-white sm:text-5xl lg:text-6xl xl:text-[4.2rem]"
        >
          XI. International Congress of
          <span class="mt-1 block text-white">Dipterology</span>
        </h1>

        <p
          class="mt-4 max-w-xl text-lg leading-8 text-white/90 sm:text-[1.3125rem] sm:leading-9 lg:mt-5"
        >
          Join the world's leading researchers and scientists in Zagreb, Croatia.
        </p>

        <div
          class="mt-6 grid max-w-xl grid-cols-1 gap-2.5 rounded-2xl border border-white/10 bg-white/5 p-2.5 backdrop-blur-sm sm:grid-cols-2 lg:mt-7"
        >
          <div
            class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/8 px-4 py-3"
          >
            <span class="hero-meta-icon h-5 w-5 shrink-0 text-white" set:html={calendar} />
            <div class="min-w-0">
              <div
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70"
              >
                START DATE
              </div>
              <div class="mt-1 text-base font-semibold text-white sm:text-[1.05rem]">
                Jul 11, 2027
              </div>
            </div>
          </div>

          <div
            class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/8 px-4 py-3"
          >
            <span class="hero-meta-icon h-5 w-5 shrink-0 text-white" set:html={mapPin} />
            <div class="min-w-0">
              <div
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70"
              >
                LOCATION
              </div>
              <div class="mt-1 text-base font-semibold text-white sm:text-[1.05rem]">
                Hotel Westin
              </div>
            </div>
          </div>
        </div>

        <div
          class="mt-7 max-w-2xl rounded-[1.75rem] border border-white/10 bg-white/5 p-3 backdrop-blur-sm lg:mt-8"
        >
          <div id="countdown" class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            <div
              class="rounded-2xl border border-white/10 bg-white/8 px-3 py-3.5 text-center sm:px-4 sm:py-4"
            >
              <div id="days" class="text-3xl font-bold leading-none text-white sm:text-4xl lg:text-[2.65rem]">
                --
              </div>
              <div
                class="mt-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70 sm:text-xs"
              >
                Days
              </div>
            </div>
            <div
              class="rounded-2xl border border-white/10 bg-white/8 px-3 py-3.5 text-center sm:px-4 sm:py-4"
            >
              <div
                id="hours"
                class="text-3xl font-bold leading-none text-white sm:text-4xl lg:text-[2.65rem]"
              >
                --
              </div>
              <div
                class="mt-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70 sm:text-xs"
              >
                Hours
              </div>
            </div>
            <div
              class="rounded-2xl border border-white/10 bg-white/8 px-3 py-3.5 text-center sm:px-4 sm:py-4"
            >
              <div
                id="minutes"
                class="text-3xl font-bold leading-none text-white sm:text-4xl lg:text-[2.65rem]"
              >
                --
              </div>
              <div
                class="mt-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70 sm:text-xs"
              >
                Minutes
              </div>
            </div>
            <div
              class="rounded-2xl border border-white/10 bg-white/8 px-3 py-3.5 text-center sm:px-4 sm:py-4"
            >
              <div
                id="seconds"
                class="text-3xl font-bold leading-none text-white sm:text-4xl lg:text-[2.65rem]"
              >
                --
              </div>
              <div
                class="mt-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70 sm:text-xs"
              >
                Seconds
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex animate-fade-in items-center justify-center delay-200 lg:justify-end">
        <div class="w-full max-w-md lg:max-w-xl">
          <div
            class="rounded-[2rem] border border-white/[0.20] bg-white/[0.40] p-3 shadow-[0_22px_64px_-30px_rgba(15,23,42,0.68)] backdrop-blur-sm sm:p-4 lg:p-5"
          >
            <img
              src="/images/logo-icd-2027-wide.png"
              alt="ICD 2027 Logo"
              class="mx-auto h-auto w-full max-w-[37rem]"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-meta-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  // Countdown to conference start: July 11, 2027, 00:00:00 (local time)
  const conferenceDate = new Date('2027-07-11T00:00:00').getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = conferenceDate - now;

    const daysEl = document.getElementById('days');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');

    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

    if (distance < 0) {
      daysEl.textContent = '00';
      hoursEl.textContent = '00';
      minutesEl.textContent = '00';
      secondsEl.textContent = '00';
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    daysEl.textContent = String(days).padStart(2, '0');
    hoursEl.textContent = String(hours).padStart(2, '0');
    minutesEl.textContent = String(minutes).padStart(2, '0');
    secondsEl.textContent = String(seconds).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
