---
/**
 * Heroicons Usage Examples
 * 
 * This file demonstrates how to use Heroicons in Astro components.
 * Copy the imports and usage patterns to your components.
 */

// Import SVG icons as raw strings
import calendar from 'heroicons/24/outline/calendar.svg?raw';
import envelope from 'heroicons/24/outline/envelope.svg?raw';
import phone from 'heroicons/24/outline/phone.svg?raw';
import mapPin from 'heroicons/24/outline/map-pin.svg?raw';
import user from 'heroicons/24/outline/user.svg?raw';
import home from 'heroicons/24/outline/home.svg?raw';
import arrowRight from 'heroicons/24/outline/arrow-right.svg?raw';
import checkCircle from 'heroicons/24/outline/check-circle.svg?raw';
import xCircle from 'heroicons/24/outline/x-circle.svg?raw';
import informationCircle from 'heroicons/24/outline/information-circle.svg?raw';

// Solid variants (when you need filled icons)
import calendarSolid from 'heroicons/24/solid/calendar.svg?raw';
import envelopeSolid from 'heroicons/24/solid/envelope.svg?raw';

// Smaller 20px solid icons
import calendarMini from 'heroicons/20/solid/calendar.svg?raw';
---

<div class="p-8 space-y-8">
  <h1 class="text-3xl font-bold mb-8">Heroicons Examples</h1>

  <!-- Outline Icons (24x24) -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Outline Icons (24x24px)</h2>
    <div class="flex flex-wrap gap-4">
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={calendar} />
        <span>Calendar</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={envelope} />
        <span>Email</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={phone} />
        <span>Phone</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={mapPin} />
        <span>Location</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={user} />
        <span>User</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={home} />
        <span>Home</span>
      </div>
    </div>
  </section>

  <!-- Solid Icons (24x24) -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Solid Icons (24x24px)</h2>
    <div class="flex flex-wrap gap-4">
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={calendarSolid} />
        <span>Calendar (Solid)</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg">
        <span class="w-5 h-5 text-primary-600" set:html={envelopeSolid} />
        <span>Email (Solid)</span>
      </div>
    </div>
  </section>

  <!-- Status Icons -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Status Icons</h2>
    <div class="flex flex-wrap gap-4">
      <div class="flex items-center space-x-2 p-4 border rounded-lg bg-green-50">
        <span class="w-5 h-5 text-green-600" set:html={checkCircle} />
        <span class="text-green-700">Success</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg bg-red-50">
        <span class="w-5 h-5 text-red-600" set:html={xCircle} />
        <span class="text-red-700">Error</span>
      </div>
      <div class="flex items-center space-x-2 p-4 border rounded-lg bg-blue-50">
        <span class="w-5 h-5 text-blue-600" set:html={informationCircle} />
        <span class="text-blue-700">Info</span>
      </div>
    </div>
  </section>

  <!-- Icons in Buttons -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Icons in Buttons</h2>
    <div class="flex flex-wrap gap-4">
      <button class="btn btn-primary flex items-center space-x-2">
        <span>Register Now</span>
        <span class="w-5 h-5 inline-block" set:html={arrowRight} />
      </button>
      <button class="btn btn-secondary flex items-center space-x-2">
        <span class="w-5 h-5 inline-block" set:html={envelope} />
        <span>Contact Us</span>
      </button>
    </div>
  </section>

  <!-- Sizing Examples -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Icon Sizing</h2>
    <div class="flex items-center gap-6">
      <span class="w-4 h-4 text-primary-600" set:html={calendar} />
      <span class="text-sm">w-4 h-4 (16px)</span>
      <span class="w-5 h-5 text-primary-600" set:html={calendar} />
      <span class="text-sm">w-5 h-5 (20px)</span>
      <span class="w-6 h-6 text-primary-600" set:html={calendar} />
      <span class="text-sm">w-6 h-6 (24px)</span>
      <span class="w-8 h-8 text-primary-600" set:html={calendar} />
      <span class="text-sm">w-8 h-8 (32px)</span>
    </div>
  </section>

  <!-- Hover Effects -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Hover Effects</h2>
    <div class="flex flex-wrap gap-4">
      <button class="p-4 border rounded-lg hover:bg-primary-50 transition-colors group">
        <span class="w-5 h-5 text-gray-400 group-hover:text-primary-600 group-hover:translate-x-1 transition-all inline-block" set:html={arrowRight} />
      </button>
      <button class="p-4 border rounded-lg hover:bg-primary-50 transition-colors group">
        <span class="w-5 h-5 text-gray-400 group-hover:text-primary-600 group-hover:scale-110 transition-all inline-block" set:html={envelope} />
      </button>
    </div>
  </section>
</div>

<style>
  /* Ensure Heroicon SVGs take full width/height of their container */
  span :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
