---
// Import SVG icons directly
import calendar from 'heroicons/24/outline/calendar.svg?raw';
import chevronRight from 'heroicons/24/outline/chevron-right.svg?raw';

const currentYear = 2027;

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'Committees', href: '/committees' },
  { name: 'Program', href: '/program' },
  { name: 'Venue', href: '/venue' },
  { name: 'Excursions', href: '/excursions' },
  { name: 'Contact', href: '/contact' },
];

const contactInfo = [
  { label: 'Email', value: 'icd2027@etours.hr', href: 'mailto:icd2027@etours.hr' },
  { label: 'Location', value: 'Zagreb, Croatia' },
];
---

<footer class="bg-gradient-to-br from-primary-900 to-primary-800 text-white">
  <div class="section-container section-padding">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <!-- Partner Logos -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Partners</h3>
        <div class="space-y-5">
          <!-- Dipterists Society -->
          <a
            href="https://dipterists.org"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 group"
            title="Dipterists Society"
          >
            <img
              src="/images/Dipterists_Society_logo.png"
              alt="Dipterists Society"
              class="w-24 h-24 object-contain invert opacity-80 group-hover:opacity-100 transition-opacity flex-shrink-0"
            />
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-white/90 group-hover:text-white transition-colors mb-0.5">
                Dipterists Society
              </div>
              <p class="text-xs text-white/50 leading-relaxed">An International Society for Dipterology</p>
            </div>
          </a>

          <!-- Husek -->
          <a
            href="https://www.husek.hr"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 group"
            title="Husek"
          >
            <img
              src="/images/Husek-logo.png"
              alt="Husek"
              class="h-28 w-auto object-contain group-hover:opacity-80 transition-opacity flex-shrink-0"
            />
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-white/90 group-hover:text-white transition-colors mb-0.5">
                Husek
              </div>
              <p class="text-xs text-white/50 leading-relaxed">Conference Organizer</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Quick Links</h3>
        <ul class="space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white/70 hover:text-white transition-colors inline-flex items-center group"
                >
                  <span class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition-all inline-block" set:html={chevronRight} />
                  <span>{link.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Contact</h3>
        <ul class="space-y-3">
          {
            contactInfo.map((item) => (
              <li>
                <div class="text-white/70">
                  <div class="text-sm text-white/50 mb-1">{item.label}</div>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="hover:text-white transition-colors"
                    >
                      {item.value}
                    </a>
                  ) : (
                    <div>{item.value}</div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Social Media (placeholder) -->
        <div class="mt-6">
          <div class="text-sm text-white/50 mb-3">Follow Us</div>
          <div class="flex space-x-3">
            <a
              href="#"
              class="w-10 h-10 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center transition-all hover:scale-110"
              aria-label="Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
                ></path>
              </svg>
            </a>
            <a
              href="#"
              class="w-10 h-10 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center transition-all hover:scale-110"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
                ></path>
              </svg>
            </a>
            <a
              href="#"
              class="w-10 h-10 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center transition-all hover:scale-110"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"
                ></path>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="max-w-5xl mx-auto">
      <div
        class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0"
      >
      <div class="text-white/60 text-sm">
        © {currentYear} <a href="https://dipterists.org" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Dipterists Society</a>. All rights reserved.
      </div>
      <div class="flex space-x-6 text-sm">
        <a href="#" class="text-white/60 hover:text-white transition-colors">
          Privacy Policy
        </a>
        <a href="#" class="text-white/60 hover:text-white transition-colors">
          Terms of Service
        </a>
      </div>
    </div>
    </div>
  </div>
</footer>

<style>
  /* Ensure Heroicon SVGs take full width/height of their container */
  footer :global(span svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
