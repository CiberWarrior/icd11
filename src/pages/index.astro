---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
---

<Layout
  title="11th International Congress of Dipterology | ICD 2027"
  description="Join us in Zagreb, Croatia for the 11th International Congress of Dipterology, July 11-16, 2027. Register now for this premier scientific event."
>
  <Header />

  <HeroCountdown />

  <main class="home-page overflow-x-hidden">
    <!-- Welcome + Gallery -->
    <section
      id="invitation"
      class="relative py-20 lg:py-28 bg-slate-50"
      data-home-animate
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_90%_60%_at_50%_-10%,rgba(42,82,152,0.14),transparent_55%)]"
        aria-hidden="true"
      >
      </div>
      <div
        class="home-bg-plus-pattern pointer-events-none absolute inset-0"
        aria-hidden="true"
      >
      </div>

      <div class="section-container relative z-10">
        <div class="home-section-header mb-14 lg:mb-16">
          <h2 class="home-title text-[#1e3c72]">ICDXI</h2>
          <p class="home-subtitle">
            Zagreb welcomes the global dipterology community — plan your participation and stay connected.
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 lg:items-start"
        >
          <div class="lg:col-span-7">
            <div
              class="relative rounded-3xl border border-slate-200/80 bg-white p-8 shadow-[0_4px_40px_-12px_rgba(30,60,114,0.12)] sm:p-10 lg:p-12"
            >
              <div
                class="pointer-events-none absolute -right-px -top-px h-24 w-24 rounded-tr-3xl border-t border-r border-primary-600/10"
                aria-hidden="true"
              >
              </div>
              <div class="space-y-6 text-base leading-relaxed text-slate-700 sm:text-lg">
                <p class="text-pretty">
                  On behalf of the Council for International Congresses of
                  Dipterology, the ICDXI Organizing Committee and Croatian
                  Association of Freshwater Ecologists (CAFE), we cordially invite
                  you to attend the 11th International Congress of Dipterology
                  (ICDX) to be held in Zagreb, Croatia, from 11–16 July 2027.
                </p>

                <p>
                  To help us with planning, please indicate your interest in
                  attending by
                  <span class="font-semibold text-[#2a5298]"
                    >signing up through our newsletter popup</span
                  >.
                </p>

                <p>
                  Are you interested in sponsoring the Congress? We welcome
                  sponsorships and support of any amount! Please see our
                  <a
                    href="#sponsors"
                    class="font-semibold text-[#2a5298] underline decoration-primary-600/30 underline-offset-2 transition hover:decoration-primary-600"
                    >packages for exhibitors</a
                  >.
                </p>

                <p>
                  Are you interested in being a vendor at the Congress? If so,
                  please contact us directly at
                  <a
                    href="mailto:11icd2027@gmail.com"
                    class="font-semibold text-[#2a5298] underline decoration-primary-600/30 underline-offset-2 transition hover:decoration-primary-600"
                    >11icd2027@gmail.com</a
                  >
                </p>
              </div>

              <div class="my-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>

              <div class="flex gap-4 rounded-2xl bg-slate-50/90 p-4 sm:p-5">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-[#2a5298]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
                <p class="text-sm leading-relaxed text-slate-600 sm:text-base">
                  <strong class="text-slate-800">Stay informed!</strong> Keep an eye
                  on these ICDXI webpages — we update frequently and more
                  information is coming.
                </p>
              </div>

              <div class="mt-8 flex flex-col gap-4 border-t border-slate-100 pt-8 sm:flex-row sm:items-center">
                <a
                  href="https://dipterists.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group shrink-0"
                  title="Dipterists Society"
                >
                  <img
                    src="/images/Dipterists_Society_logo.png"
                    alt="Dipterists Society"
                    class="h-16 w-16 object-contain opacity-80 transition group-hover:opacity-100 sm:h-20 sm:w-20"
                  />
                </a>
                <p class="text-sm leading-relaxed text-slate-500">
                  This congress is organised under the auspices of the
                  <a
                    href="https://dipterists.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-[#2a5298] underline decoration-primary-600/25 underline-offset-2 hover:decoration-primary-600"
                    >Dipterists Society</a
                  >
                  — An International Society for Dipterology.
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="sticky top-28 space-y-6">
              <p
                class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400 lg:text-left"
              >
                Diptera gallery
              </p>
              <div class="mx-auto grid max-w-sm grid-cols-3 gap-2.5 sm:gap-3 lg:mx-0 lg:max-w-none">
                {[1, 2, 3, 4, 5, 6].map((n) => (
                  <button
                    type="button"
                    class="gallery-thumb group relative aspect-square overflow-hidden rounded-2xl border border-slate-200/80 shadow-sm ring-1 ring-black/[0.04] transition duration-300 hover:z-10 hover:shadow-lg hover:ring-primary-600/20 focus:outline-none focus:ring-2 focus:ring-[#2a5298]/40"
                    data-gallery-src={`/images/fly-${n}.jpg`}
                    aria-label={`Diptera photo ${n}`}
                  >
                    <img
                      src={`/images/fly-${n}.jpg`}
                      alt=""
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>

              <div
                class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm sm:p-6"
              >
                <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
                  <a
                    href="/images/logo-icd-wide-2027.png"
                    download="ICDXI-2027-logo.png"
                    title="Click to download the congress logo"
                    class="group flex shrink-0 flex-col items-center self-center sm:self-start"
                  >
                    <img
                      src="/images/logo-icd-wide-2027.png"
                      alt="ICDXI Congress Logo"
                      class="w-24 drop-shadow-sm transition group-hover:scale-105 sm:w-28"
                    />
                    <span
                      class="mt-2 text-[10px] text-slate-400 transition group-hover:text-[#2a5298]"
                    >
                      ↓ download logo
                    </span>
                  </a>
                  <div>
                    <p
                      class="mb-2 text-xs font-bold uppercase tracking-wider text-[#2a5298]"
                    >
                      About the congress logo
                    </p>
                    <p class="text-xs leading-relaxed text-slate-600">
                      The ICDXI logo combines symbols of Zagreb — Lotrščak Tower
                      and Manduševac well — with <em>Chironomus</em> sp. emerging
                      from the well and an adult resting on the tower.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery Lightbox -->
    <div
      id="gallery-lightbox"
      class="fixed inset-0 z-[80] hidden cursor-zoom-out items-center justify-center bg-black/92 p-4 backdrop-blur-sm"
      aria-modal="true"
      role="dialog"
    >
      <button
        type="button"
        id="gallery-lightbox-close"
        class="fixed right-5 top-5 z-[90] flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-white shadow-xl ring-1 ring-white/20 transition hover:bg-black/80"
        aria-label="Close"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <button
        type="button"
        id="gallery-prev"
        class="absolute left-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
        aria-label="Previous"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        type="button"
        id="gallery-next"
        class="absolute right-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
        aria-label="Next"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      <img
        id="gallery-lightbox-img"
        src=""
        alt=""
        class="max-h-[85vh] max-w-full rounded-2xl object-contain shadow-2xl"
      />
    </div>

    <script is:inline>
      (function () {
        var thumbs = document.querySelectorAll('.gallery-thumb');
        var lightbox = document.getElementById('gallery-lightbox');
        var img = document.getElementById('gallery-lightbox-img');
        var closeBtn = document.getElementById('gallery-lightbox-close');
        var prevBtn = document.getElementById('gallery-prev');
        var nextBtn = document.getElementById('gallery-next');
        var sources = [];
        var current = 0;

        thumbs.forEach(function (thumb, i) {
          sources.push(thumb.getAttribute('data-gallery-src'));
          thumb.addEventListener('click', function () {
            current = i;
            show();
          });
        });

        function show() {
          img.src = sources[current];
          img.alt = 'Diptera photo ' + (current + 1);
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function hide() {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          document.body.style.overflow = '';
        }

        function prev() {
          current = (current - 1 + sources.length) % sources.length;
          img.src = sources[current];
          img.alt = 'Diptera photo ' + (current + 1);
        }

        function next() {
          current = (current + 1) % sources.length;
          img.src = sources[current];
          img.alt = 'Diptera photo ' + (current + 1);
        }

        closeBtn.addEventListener('click', hide);
        prevBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          prev();
        });
        nextBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          next();
        });
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) hide();
        });

        document.addEventListener('keydown', function (e) {
          if (lightbox.classList.contains('hidden')) return;
          if (e.key === 'Escape') hide();
          if (e.key === 'ArrowLeft') prev();
          if (e.key === 'ArrowRight') next();
        });
      })();
    </script>

    <!-- Important Dates -->
    <section
      id="dates"
      class="relative bg-white py-20 lg:py-28"
      data-home-animate
    >
      <div class="section-container">
        <div class="home-section-header">
          <h2 class="home-title text-[#1e3c72]">Important dates</h2>
          <p class="home-subtitle">
            Mark your calendar — registration, abstracts, and late deadlines at
            a glance.
          </p>
        </div>

        <div class="relative mx-auto max-w-5xl">
          <div
            class="pointer-events-none absolute left-[8%] right-[8%] top-10 hidden h-px bg-gradient-to-r from-emerald-200 via-[#7eb8ea] to-rose-200 md:block"
            aria-hidden="true"
          >
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-5">
            <!-- Regular Registration -->
            <article
              class="group relative flex flex-col rounded-3xl border border-slate-200/90 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
            >
              <div
                class="absolute inset-x-0 top-0 h-1 rounded-t-3xl bg-gradient-to-r from-emerald-400 to-teal-500"
              >
              </div>
              <span
                class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-sm font-extrabold text-emerald-700 ring-1 ring-emerald-100"
              >
                01
              </span>
              <h3 class="mb-2 text-lg font-bold text-emerald-800">
                Regular registration
              </h3>
              <p class="mb-6 text-lg font-semibold text-slate-800">
                1 Sep 2026 – 28 Feb 2027
              </p>
              <p class="mt-auto text-sm leading-relaxed text-slate-500">
                Standard rates apply for delegates and accompanying persons.
              </p>
            </article>

            <!-- Abstract Submission -->
            <article
              class="group relative flex flex-col rounded-3xl border border-slate-200/90 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
            >
              <div
                class="absolute inset-x-0 top-0 h-1 rounded-t-3xl bg-gradient-to-r from-[#2a5298] to-sky-400"
              >
              </div>
              <span
                class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-sm font-extrabold text-[#2a5298] ring-1 ring-blue-100"
              >
                02
              </span>
              <h3 class="mb-2 text-lg font-bold text-[#1e3c72]">
                Abstract submission
              </h3>
              <p class="mb-6 text-lg font-semibold text-slate-800">
                1 Oct 2026 – 31 Mar 2027
              </p>
              <p class="mt-auto text-sm leading-relaxed text-slate-500">
                Submit your abstract for oral or poster presentation.
              </p>
            </article>

            <!-- Late Registration -->
            <article
              class="group relative flex flex-col rounded-3xl border border-slate-200/90 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
            >
              <div
                class="absolute inset-x-0 top-0 h-1 rounded-t-3xl bg-gradient-to-r from-[#b1414b] to-rose-500"
              >
              </div>
              <span
                class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-red-50 text-sm font-extrabold text-[#b1414b] ring-1 ring-red-100"
              >
                03
              </span>
              <h3 class="mb-2 text-lg font-bold text-[#8e343b]">
                Late registration
              </h3>
              <p class="mb-6 text-lg font-semibold text-slate-800">
                1 Mar 2027 – 15 Jun 2027
              </p>
              <p class="mt-auto text-sm leading-relaxed text-slate-500">
                Late rates apply — secure your place before the deadline.
              </p>
            </article>
          </div>
        </div>

        <div
          class="mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a
            href="/registration"
            class="inline-flex items-center gap-2 rounded-2xl bg-[#2a5298] px-8 py-4 text-sm font-bold uppercase tracking-wide text-white shadow-lg shadow-primary-900/10 transition hover:bg-[#244a87]"
          >
            Register now
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="/registration"
            class="inline-flex items-center gap-2 rounded-2xl border-2 border-[#2a5298]/20 bg-white px-8 py-4 text-sm font-bold uppercase tracking-wide text-[#2a5298] transition hover:border-[#2a5298]/40 hover:bg-slate-50"
          >
            Submit abstract
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Sponsorship & Exhibition -->
    <section
      id="sponsors"
      class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-50 py-20 lg:py-28"
      data-home-animate
    >
      <div
        class="pointer-events-none absolute -right-40 bottom-20 h-96 w-96 rounded-full bg-[#2a5298]/10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="section-container relative z-10">
        <div class="home-section-header">
          <h2 class="home-title text-[#1e3c72]">Sponsorship & exhibition</h2>
          <p class="home-subtitle max-w-2xl">
            Your partnership strengthens the congress. We welcome sponsorships
            and support at every level.
          </p>
        </div>

        <div class="mx-auto mb-12 grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-2">
          <!-- Golden -->
          <article
            class="relative overflow-hidden rounded-3xl border-2 border-amber-200/80 bg-white shadow-md"
          >
            <div
              class="h-2 bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500"
            >
            </div>
            <div class="absolute right-6 top-6">
              <span
                class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-800"
              >
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                  ></path>
                </svg>
                Golden
              </span>
            </div>
            <div class="p-8 pt-10">
              <p class="mb-1 text-sm font-semibold uppercase tracking-wider text-amber-800">
                Golden sponsor
              </p>
              <div class="mb-6 flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-slate-900">5,000</span>
                <span class="text-lg font-semibold text-slate-500">EUR</span>
              </div>
              <ul class="space-y-3 text-sm text-slate-600">
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-amber-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span
                    ><strong class="text-slate-800">5 days</strong> of exhibition
                    space (4 m²)</span
                  >
                </li>
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-amber-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  Company logo &amp; QR code on the official congress website
                </li>
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-amber-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  Logo in the Book of Abstracts (PDF) and all printed materials
                </li>
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-amber-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  Conference bag insert (leaflets or one promotional item)
                </li>
              </ul>
            </div>
          </article>

          <!-- Silver -->
          <article
            class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm"
          >
            <div
              class="h-2 bg-gradient-to-r from-slate-300 via-slate-200 to-slate-400"
            >
            </div>
            <div class="absolute right-6 top-6">
              <span
                class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-600"
              >
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                  ></path>
                </svg>
                Silver
              </span>
            </div>
            <div class="p-8 pt-10">
              <p class="mb-1 text-sm font-semibold uppercase tracking-wider text-slate-500">
                Silver sponsor
              </p>
              <div class="mb-6 flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-slate-900">2,500</span>
                <span class="text-lg font-semibold text-slate-500">EUR</span>
              </div>
              <ul class="space-y-3 text-sm text-slate-600">
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-slate-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span
                    ><strong class="text-slate-800">4 days</strong> of exhibition
                    space (2 m²)</span
                  >
                </li>
                <li class="flex gap-2.5">
