---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="11th International Congress of Dipterology | ICD 2027"
  description="Join us in Zagreb, Croatia for the 11th International Congress of Dipterology, July 11-16, 2027. Register now for this premier scientific event."
>
  <Header />

  <HeroCountdown />

  <!-- Important Dates Section -->
  <section id="dates" class="section-padding bg-white">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Important Dates
        </h2>
        <p class="text-xl text-gray-600 leading-relaxed">
          Mark your calendar and don't miss registration deadlines.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Regular Registration -->
          <div class="bg-white rounded-2xl shadow-md overflow-hidden border-t-4 border-t-green-500 border border-gray-100">
            <div class="p-6 text-center">
              <div class="text-sm uppercase tracking-wider text-green-600 font-semibold mb-2">Regular Registration</div>
              <div class="text-3xl font-bold text-gray-900 mb-1">1 Sep 2026</div>
              <div class="text-gray-500 text-sm mb-4">to 28 Feb 2027</div>
              <div class="inline-block px-4 py-2 bg-green-50 rounded-lg text-green-700 font-semibold text-sm">
                Standard rates
              </div>
            </div>
          </div>

          <!-- Late Registration -->
          <div class="bg-white rounded-2xl shadow-md overflow-hidden border-t-4 border-t-blue-500 border border-gray-100">
            <div class="p-6 text-center">
              <div class="text-sm uppercase tracking-wider text-blue-600 font-semibold mb-2">Late Registration</div>
              <div class="text-3xl font-bold text-gray-900 mb-1">1 Mar 2027</div>
              <div class="text-gray-500 text-sm mb-4">to 15 Jun 2027</div>
              <div class="inline-block px-4 py-2 bg-blue-50 rounded-lg text-blue-700 font-semibold text-sm">
                Late rates
              </div>
            </div>
          </div>

          <!-- Abstract Submission -->
          <div class="bg-white rounded-2xl shadow-md overflow-hidden border-t-4 border-t-[#2a5298] border border-gray-100">
            <div class="p-6 text-center">
              <div class="text-sm uppercase tracking-wider text-[#2a5298] font-semibold mb-2">Abstract Submission</div>
              <div class="text-3xl font-bold text-gray-900 mb-1">TBD</div>
              <div class="text-gray-500 text-sm mb-4">Deadline to be announced</div>
              <div class="inline-block px-4 py-2 bg-blue-50 rounded-lg text-[#2a5298] font-semibold text-sm">
                Submit your abstract
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
          <Button variant="primary" size="lg" href="#">
            Register Now
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </Button>
          <Button variant="secondary" size="lg" href="#">
            Submit Abstract
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Venue Highlight Section -->
  <section id="venue-highlight" class="section-padding bg-gray-50">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <!-- Image -->
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img 
              src="/images/westin-hotel-1.jpg" 
              alt="Hotel Westin Zagreb" 
              class="w-full h-80 lg:h-96 object-cover"
            />
          </div>

          <!-- Content -->
          <div>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              Hotel Westin, Zagreb
            </h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
              The congress will take place at the prestigious Hotel Westin in the heart of Zagreb, 
              Croatia's vibrant capital. Centrally located near the National Theatre and Mimara Museum, 
              the hotel offers world-class conference facilities and easy access to the city's cultural attractions.
            </p>

            <div class="flex flex-wrap gap-4 mb-8">
              <div class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>City centre</span>
              </div>
              <div class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <span>Conference facilities</span>
              </div>
            </div>

            <Button variant="secondary" href="/venue" size="lg">
              Explore Venue & Zagreb
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Scroll animations -->
  <script>
    const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('animate-fade-in-up'); observer.unobserve(entry.target); }
      });
    }, observerOptions);
    document.querySelectorAll('.card, section').forEach((el) => observer.observe(el));
  </script>
</Layout>
