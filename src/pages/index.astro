---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="11th International Congress of Dipterology | ICD 2027"
  description="Join us in Zagreb, Croatia for the 11th International Congress of Dipterology, July 11-16, 2027. Register now for this premier scientific event."
>
  <Header />

  <HeroCountdown />

  <!-- Important Dates Section -->
  <section id="dates" class="section-padding bg-gradient-to-b from-white via-gray-50 to-white relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -left-40 w-[520px] h-[520px] bg-[#2a5298] rounded-full opacity-[0.06] blur-3xl"></div>
      <div class="absolute -bottom-44 -right-44 w-[620px] h-[620px] bg-amber-400 rounded-full opacity-[0.05] blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[760px] h-[760px] bg-[#2a5298] rounded-full opacity-[0.03] blur-3xl"></div>
    </div>

    <div class="section-container relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-bold tracking-[0.3em] uppercase text-[#2a5298] mb-5">ICD 2027 · Zagreb</span>
        <h2 class="text-5xl lg:text-6xl font-bold text-gray-900 mb-5 leading-tight">
          Important Dates
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed max-w-xl mx-auto">
          Plan ahead and secure your spot at the congress.
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

          <!-- Regular Registration -->
          <div class="group relative bg-white rounded-2xl border border-gray-200 hover:border-green-300 transition-all duration-300 overflow-hidden hover:-translate-y-1 shadow-sm hover:shadow-lg">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-green-400 to-emerald-500"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-green-50 border border-green-100 mb-5">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-green-700 mb-4">Regular Registration</p>
              <p class="text-lg text-gray-600 font-medium">1 Sep 2026 to 28 Feb 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Standard rates apply.</p>
            </div>
          </div>

          <!-- Abstract Submission -->
          <div class="group relative bg-white rounded-2xl border border-gray-200 hover:border-blue-300 transition-all duration-300 overflow-hidden hover:-translate-y-1 shadow-sm hover:shadow-lg">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#2a5298] to-[#6fa3ef]"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 mb-5">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-[#2a5298] mb-4">Abstract Submission</p>
              <p class="text-lg text-gray-600 font-medium">1 Oct 2026 to 31 Mar 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Submit your abstract for oral or poster presentation.</p>
            </div>
          </div>

          <!-- Late Registration -->
          <div class="group relative bg-white rounded-2xl border border-gray-200 hover:border-red-300 transition-all duration-300 overflow-hidden hover:-translate-y-1 shadow-sm hover:shadow-lg">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#b1414b] to-[#8e343b]"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-red-50 border border-red-100 mb-5">
                <svg class="w-5 h-5 text-[#b1414b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-[#b1414b] mb-4">Late Registration</p>
              <p class="text-lg text-gray-600 font-medium">1 Mar 2027 to 15 Jun 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Late rates apply.</p>
            </div>
          </div>

        </div>

        <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="#" class="inline-flex items-center gap-2 px-8 py-4 bg-[#2a5298] text-white font-bold rounded-xl hover:bg-[#244a89] transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-sm tracking-wide">
            Register Now
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="#" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#2a5298] font-bold rounded-xl border border-[#2a5298]/25 hover:border-[#2a5298]/50 hover:bg-[#2a5298]/5 transition-all duration-300 text-sm tracking-wide">
            Submit Abstract
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Venue Highlight Section -->
  <section id="venue-highlight" class="section-padding bg-gray-50">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <!-- Image -->
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img 
              src="/images/westin-hotel-1.jpg" 
              alt="Hotel Westin Zagreb" 
              class="w-full h-80 lg:h-96 object-cover"
            />
          </div>

          <!-- Content -->
          <div>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              Hotel Westin, Zagreb
            </h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
              The congress will take place at the prestigious Hotel Westin in the heart of Zagreb, 
              Croatia's vibrant capital. Centrally located near the National Theatre and Mimara Museum, 
              the hotel offers world-class conference facilities and easy access to the city's cultural attractions.
            </p>

            <div class="flex flex-wrap gap-4 mb-8">
              <div class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>City centre</span>
              </div>
              <div class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <span>Conference facilities</span>
              </div>
            </div>

            <Button variant="secondary" href="/venue" size="lg">
              Explore Venue & Zagreb
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Scroll animations -->
  <script>
    const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('animate-fade-in-up'); observer.unobserve(entry.target); }
      });
    }, observerOptions);
    document.querySelectorAll('.card, section').forEach((el) => observer.observe(el));
  </script>
</Layout>
