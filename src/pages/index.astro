---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
---

<Layout
  title="11th International Congress of Dipterology | ICD 2027"
  description="Join us in Zagreb, Croatia for the 11th International Congress of Dipterology, July 11-16, 2027. Register now for this premier scientific event."
>
  <Header />

  <HeroCountdown />

  <!-- Welcome + Gallery (editorial layout) -->
  <section id="invitation" class="section-padding bg-white">
    <div class="section-container">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <span class="inline-block text-xs font-bold tracking-[0.3em] uppercase text-[#2a5298] mb-5">Welcome</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-0 bg-gradient-to-br from-slate-50 via-white to-blue-50/40 rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

          <!-- Left: Invitation text -->
          <div class="lg:col-span-3 p-8 sm:p-10 space-y-5">
            <p class="text-gray-700 text-lg leading-relaxed">
              On behalf of the Council for International Congresses of Dipterology, the ICDXI Organizing Committee and Croatian Association of Freshwater Ecologists (CAFE), we cordially invite you to attend the 11th International Congress of Dipterology (ICDX) to be held in Zagreb, Croatia, from 11–16 July 2027.
            </p>

            <p class="text-gray-700 leading-relaxed">
              To help us with planning, please indicate your interest in attending by
              <span class="text-[#2a5298] font-semibold">signing up through our newsletter popup</span>.
            </p>

            <p class="text-gray-700 leading-relaxed">
              Are you interested in sponsoring the Congress? We welcome sponsorships and support of any amount! Please see our <a href="#sponsors" class="text-[#2a5298] font-semibold hover:underline">packages for exhibitors</a>.
            </p>

            <p class="text-gray-700 leading-relaxed">
              Are you interested in being a vendor at the Congress? If so, please contact us directly at
              <a href="mailto:11icd2027@gmail.com" class="text-[#2a5298] font-semibold hover:underline">11icd2027@gmail.com</a>
            </p>

            <div class="h-px bg-gray-200"></div>

            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-gray-700 leading-relaxed">
                <strong class="text-gray-800">Stay informed!</strong> Keep an eye on these ICDXI webpages, as we will be updating frequently and there is much more information to come!
              </p>
            </div>

            <!-- Dipterists Society -->
            <div class="flex items-center gap-3">
              <a
                href="https://dipterists.org"
                target="_blank"
                rel="noopener noreferrer"
                class="flex-shrink-0 hover:opacity-60 transition-opacity"
                title="Dipterists Society"
              >
                <img
                  src="/images/Dipterists_Society_logo.png"
                  alt="Dipterists Society"
                  class="w-20 h-20 object-contain opacity-70"
                />
              </a>
              <p class="text-sm text-gray-500 leading-relaxed">
                This congress is organised under the auspices of the <a href="https://dipterists.org" target="_blank" rel="noopener noreferrer" class="text-[#2a5298] font-semibold hover:underline">Dipterists Society</a> — An International Society for Dipterology.
              </p>
            </div>
          </div>

          <!-- Right: Diptera Gallery -->
          <div class="lg:col-span-2 bg-gradient-to-b from-slate-50 to-slate-100/80 lg:bg-gradient-to-br lg:from-slate-50/50 lg:to-slate-100/60 p-6 sm:p-8 lg:border-l border-t lg:border-t-0 border-gray-100 flex flex-col gap-4">

            <!-- Photo grid -->
            <div class="grid grid-cols-3 gap-2 max-w-xs mx-auto lg:max-w-none">
              {[1,2,3,4,5,6].map((n) => (
                <button
                  type="button"
                  class="gallery-thumb relative rounded-lg overflow-hidden aspect-square shadow-sm border border-gray-200/60 focus:outline-none focus:ring-2 focus:ring-[#2a5298]/40"
                  data-gallery-src={`/images/fly-${n}.jpg`}
                  aria-label={`Diptera photo ${n}`}
                >
                  <img
                    src={`/images/fly-${n}.jpg`}
                    alt={`Diptera photo ${n}`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </button>
              ))}
            </div>

            <!-- Congress Logo card -->
            <div class="rounded-xl bg-white border border-gray-200/80 shadow-sm p-4 flex items-center gap-4">
              <a
                href="/images/logo-icd-wide-2027.png"
                download="ICDXI-2027-logo.png"
                title="Click to download the congress logo"
                class="flex-shrink-0 group flex flex-col items-center"
              >
                <img
                  src="/images/logo-icd-wide-2027.png"
                  alt="ICDXI Congress Logo"
                  class="w-20 drop-shadow-sm group-hover:scale-105 transition-transform"
                />
                <span class="text-[10px] text-gray-400 mt-1 group-hover:text-[#2a5298] transition-colors">
                  ↓ download
                </span>
              </a>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#2a5298] mb-1.5">About the Congress Logo</p>
                <p class="text-xs text-gray-600 leading-relaxed">
                  The ICDXI congress logo is based on two symbols of Zagreb, Lotrščak Tower and Manduševac well, <em>Chironomus</em> sp. emerging from the well and adult <em>Chironomus</em> sp. resting on the Lotrščak tower.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Lightbox -->
  <div
    id="gallery-lightbox"
    class="hidden fixed inset-0 z-[80] bg-black/90 items-center justify-center p-4 cursor-zoom-out"
    aria-modal="true"
    role="dialog"
  >
    <button
      type="button"
      id="gallery-lightbox-close"
      class="absolute top-5 right-5 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10"
      aria-label="Close"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button
      type="button"
      id="gallery-prev"
      class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10"
      aria-label="Previous"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      type="button"
      id="gallery-next"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10"
      aria-label="Next"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <img
      id="gallery-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-lg shadow-2xl object-contain"
    />
  </div>

  <script is:inline>
    (function () {
      var thumbs = document.querySelectorAll('.gallery-thumb');
      var lightbox = document.getElementById('gallery-lightbox');
      var img = document.getElementById('gallery-lightbox-img');
      var closeBtn = document.getElementById('gallery-lightbox-close');
      var prevBtn = document.getElementById('gallery-prev');
      var nextBtn = document.getElementById('gallery-next');
      var sources = [];
      var current = 0;

      thumbs.forEach(function (thumb, i) {
        sources.push(thumb.getAttribute('data-gallery-src'));
        thumb.addEventListener('click', function () {
          current = i;
          show();
        });
      });

      function show() {
        img.src = sources[current];
        img.alt = 'Diptera photo ' + (current + 1);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function hide() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      function prev() {
        current = (current - 1 + sources.length) % sources.length;
        img.src = sources[current];
        img.alt = 'Diptera photo ' + (current + 1);
      }

      function next() {
        current = (current + 1) % sources.length;
        img.src = sources[current];
        img.alt = 'Diptera photo ' + (current + 1);
      }

      closeBtn.addEventListener('click', hide);
      prevBtn.addEventListener('click', function (e) { e.stopPropagation(); prev(); });
      nextBtn.addEventListener('click', function (e) { e.stopPropagation(); next(); });
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) hide();
      });

      document.addEventListener('keydown', function (e) {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') hide();
        if (e.key === 'ArrowLeft') prev();
        if (e.key === 'ArrowRight') next();
      });
    })();
  </script>

  <!-- Important Dates Section -->
  <section id="dates" class="pt-4 pb-10 lg:pt-6 lg:pb-14 bg-white">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-4 leading-tight">
          Important Dates
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed max-w-xl mx-auto">
          Plan ahead and secure your spot at the congress.
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

          <!-- Regular Registration -->
          <div class="relative bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-green-400 to-emerald-500"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-green-50 border border-green-100 mb-5">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-green-700 mb-4">Regular Registration</p>
              <p class="text-lg text-gray-600 font-medium">1 Sep 2026 to 28 Feb 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Standard rates apply.</p>
            </div>
          </div>

          <!-- Abstract Submission -->
          <div class="relative bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#2a5298] to-[#6fa3ef]"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 mb-5">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-[#2a5298] mb-4">Abstract Submission</p>
              <p class="text-lg text-gray-600 font-medium">1 Oct 2026 to 31 Mar 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Submit your abstract for oral or poster presentation.</p>
            </div>
          </div>

          <!-- Late Registration -->
          <div class="relative bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#b1414b] to-[#8e343b]"></div>
            <div class="p-7">
              <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-red-50 border border-red-100 mb-5">
                <svg class="w-5 h-5 text-[#b1414b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <p class="text-base font-semibold text-[#b1414b] mb-4">Late Registration</p>
              <p class="text-lg text-gray-600 font-medium">1 Mar 2027 to 15 Jun 2027</p>
              <div class="h-px bg-gray-100 mt-5 mb-4"></div>
              <p class="text-sm text-gray-500">Late rates apply.</p>
            </div>
          </div>

        </div>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/registration" class="inline-flex items-center gap-2 px-8 py-4 bg-[#2a5298] text-white font-bold rounded-xl transition-colors duration-200 shadow-md text-sm tracking-wide">
            Register Now
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/registration" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#2a5298] font-bold rounded-xl border border-[#2a5298]/25 transition-colors duration-200 text-sm tracking-wide">
            Submit Abstract
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship & Exhibition Section -->
  <section id="sponsors" class="section-padding bg-gradient-to-b from-gray-50 via-white to-gray-50 relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-32 -right-32 w-[400px] h-[400px] bg-amber-400 rounded-full opacity-[0.04] blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] bg-[#2a5298] rounded-full opacity-[0.04] blur-3xl"></div>
    </div>

    <div class="section-container relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-[0.3em] uppercase text-[#2a5298] mb-5">Support the Congress</span>
        <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-5 leading-tight">
          Sponsorship & Exhibition
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
          Your partnership opportunities at ICDXI. We welcome sponsorships and support of any amount!
        </p>
      </div>

      <!-- Sponsorship Packages -->
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

        <!-- Golden -->
        <div class="relative bg-white rounded-2xl border-2 border-amber-300 shadow-md overflow-hidden">
          <div class="h-2 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500"></div>
          <div class="absolute top-5 right-5">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-700 px-3 py-1 rounded-full">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
              Golden
            </span>
          </div>
          <div class="p-7 pt-6">
            <p class="text-sm font-semibold text-amber-700 uppercase tracking-wider mb-1">Golden Sponsor</p>
            <div class="flex items-baseline gap-1 mb-5">
              <span class="text-4xl font-extrabold text-gray-900">5,000</span>
              <span class="text-lg font-semibold text-gray-500">EUR</span>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong class="text-gray-800">5 days</strong> of exhibition space (4 m²)</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Company logo &amp; QR code on the official congress website
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Logo in the Book of Abstracts (PDF) and all printed congress materials
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Conference bag insert (leaflets or one promotional item)
              </li>
            </ul>
          </div>
        </div>

        <!-- Silver -->
        <div class="relative bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
          <div class="h-2 bg-gradient-to-r from-gray-300 via-gray-200 to-gray-400"></div>
          <div class="absolute top-5 right-5">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
              Silver
            </span>
          </div>
          <div class="p-7 pt-6">
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Silver Sponsor</p>
            <div class="flex items-baseline gap-1 mb-5">
              <span class="text-4xl font-extrabold text-gray-900">2,500</span>
              <span class="text-lg font-semibold text-gray-500">EUR</span>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong class="text-gray-800">4 days</strong> of exhibition space (2 m²)</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Company logo &amp; QR code on the official congress website
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Logo in the Book of Abstracts (PDF) and all printed congress materials
              </li>
              <li class="flex items-start gap-2.5 text-sm text-gray-600">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Conference bag insert (leaflets or one promotional item)
              </li>
            </ul>
          </div>
        </div>

      </div>

      <!-- Additional packages + Vendor -->
      <div class="max-w-6xl mx-auto mb-10">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
          <div class="h-1.5 bg-gradient-to-r from-[#2a5298] via-[#6fa3ef] to-amber-400"></div>
          <div class="p-7 sm:p-8">
            <h3 class="text-xl sm:text-2xl font-bold text-[#2a5298] mb-6 tracking-wide">
              ADDITIONAL SPONSORSHIP PACKAGES
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">

              <!-- Logo & Branding -->
              <div class="rounded-2xl border border-blue-100 bg-gradient-to-b from-white to-blue-50/60 p-5 flex flex-col">
                <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-blue-100 mb-4">
