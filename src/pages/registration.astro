---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Registration | ICD 2027"
  description="Register for the 11th International Congress of Dipterology. Fees, deadlines, and registration link for ICD 2027 in Zagreb."
>
  <Header />

  <HeroCountdown />

  <main class="bg-gradient-to-b from-slate-50 via-blue-50/20 to-white pb-20 pt-2 lg:pb-28">
    <section class="section-container section-padding !pt-10 lg:!pt-14">
      <div class="mx-auto max-w-5xl">

        <!-- Page header + Register CTA -->
        <div class="mb-12 text-center">
          <div
            class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/20 shadow-sm"
          >
            <svg
              class="h-8 w-8 text-[#2a5298]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <h1 class="mb-6 text-4xl font-bold text-[#2a5298] lg:text-5xl">
            Registration
          </h1>

          <div
            class="relative mx-auto max-w-xl overflow-hidden rounded-2xl border-2 border-[#2a5298]/30 bg-gradient-to-br from-blue-50 to-indigo-50 shadow-lg"
          >
            <div
              class="absolute right-0 top-0 -mr-14 -mt-14 h-28 w-28 rounded-full bg-blue-200/30"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 -mb-10 -ml-10 h-20 w-20 rounded-full bg-indigo-200/30"
            >
            </div>
            <div
              class="relative flex flex-col items-center gap-5 px-6 py-7 sm:px-8 sm:py-8"
            >
              <div class="flex items-center justify-center gap-4">
                <div class="shrink-0">
                  <div
                    class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#2a5298] to-[#1e3c72] shadow-md sm:h-14 sm:w-14"
                  >
                    <svg
                      class="h-6 w-6 text-white sm:h-7 sm:w-7"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <p class="text-left text-lg font-bold leading-snug text-[#1e3c72] sm:text-xl">
                  Registration is open
                </p>
              </div>
              <a
                href="https://register.empl.io/ICD2027"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary px-8 py-4 text-lg"
              >
                Register
              </a>
              <p class="max-w-sm text-sm leading-relaxed text-slate-600">
                Closing registration: 15 June 2027
              </p>
            </div>
          </div>
        </div>

        <!-- Registration Fees Table -->
        <div
          class="mb-10 overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-lg ring-1 ring-black/[0.03] transition-shadow hover:shadow-xl"
        >
          <div class="h-1.5 bg-gradient-to-r from-[#1e3c72] to-[#2a5298]"></div>
          <div
            class="flex flex-col gap-4 border-b border-slate-100 bg-white px-6 py-6 sm:flex-row sm:items-center sm:gap-5 sm:px-8 lg:px-10 lg:py-7"
          >
            <div
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-100 text-[#2a5298]"
            >
              <svg
                class="h-7 w-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"
                ></path>
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-extrabold tracking-tight text-[#1e3c72] lg:text-3xl">
                Registration Fees
              </h2>
            </div>
          </div>

          <div class="bg-white px-4 py-6 sm:px-6 lg:px-10 lg:pb-10 lg:pt-2">
            <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
              <table class="w-full min-w-[640px] border-collapse text-sm sm:text-base">
                <thead>
                  <tr>
                    <th
                      class="bg-[#1e3c72] px-4 py-4 text-left text-base font-bold tracking-tight text-white sm:px-6 sm:py-5"
                    >
                      Registration Type
                    </th>
                    <th
                      class="bg-emerald-600 px-4 py-4 text-center font-bold text-white sm:px-6 sm:py-5"
                    >
                      <span class="block text-base sm:text-lg">Early Bird</span>
                      <span class="mt-0.5 block text-xs font-normal opacity-95 sm:text-sm"
                        >1.9. – 31.10.2026</span
                      >
                    </th>
                    <th
                      class="bg-[#2a5298] px-4 py-4 text-center font-bold text-white sm:px-6 sm:py-5"
                    >
                      <span class="block text-base sm:text-lg">Regular</span>
                      <span class="mt-0.5 block text-xs font-normal opacity-95 sm:text-sm"
                        >1.11. – 28.2.2027</span
                      >
                    </th>
                    <th
                      class="bg-slate-600 px-4 py-4 text-center font-bold text-white sm:px-6 sm:py-5"
                    >
                      <span class="block text-base sm:text-lg">Late</span>
                      <span class="mt-0.5 block text-xs font-normal opacity-95 sm:text-sm"
                        >1.3. – 15.6.2027</span
                      >
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-slate-100 bg-white transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100"
                        >
                          <svg
                            class="h-5 w-5 text-[#2a5298]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                            ></path>
                          </svg>
                        </span>
                        Regular Delegate
                      </div>
                    </td>
                    <td class="bg-emerald-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >590 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >650 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/60 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >800 EUR</span
                      >
                    </td>
                  </tr>
                  <tr class="border-b border-slate-100 bg-slate-50/30 transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100"
                        >
                          <svg
                            class="h-5 w-5 text-amber-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 14l9-5-9-5-9 5 9 5z"></path>
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                            ></path>
                          </svg>
                        </span>
                        Student Delegate
                      </div>
                    </td>
                    <td class="bg-emerald-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >350 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/35 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >390 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >500 EUR</span
                      >
                    </td>
                  </tr>
                  <tr class="border-b border-slate-100 bg-white transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-100"
                        >
                          <svg
                            class="h-5 w-5 text-rose-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                            ></path>
                          </svg>
                        </span>
                        Accompanying Person
                      </div>
                    </td>
                    <td class="bg-emerald-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >350 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/35 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >350 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >450 EUR</span
                      >
                    </td>
                  </tr>
                  <tr class="border-b border-slate-100 bg-slate-50/30 transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-100"
                        >
                          <svg
                            class="h-5 w-5 text-orange-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M2 20h20M4 20C4 13.373 7.582 8 12 8s8 5.373 8 12M12 8V5m-1 0h2"></path>
                          </svg>
                        </span>
                        Congress Dinner
                      </div>
                    </td>
                    <td class="bg-emerald-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/35 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                  </tr>
                  <tr class="border-b border-slate-100 bg-white transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-100"
                        >
                          <svg
                            class="h-5 w-5 text-orange-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M2 20h20M4 20C4 13.373 7.582 8 12 8s8 5.373 8 12M12 8V5m-1 0h2"></path>
                          </svg>
                        </span>
                        Congress Dinner (Accompanying person)
                      </div>
                    </td>
                    <td class="bg-emerald-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/35 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >80 EUR</span
                      >
                    </td>
                  </tr>
                  <tr class="bg-slate-50/30 transition-colors hover:bg-slate-50/80">
                    <td
                      class="border-r border-slate-100 px-4 py-4 font-semibold text-slate-900 sm:px-6 sm:py-5"
                    >
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-purple-100"
                        >
                          <svg
                            class="h-5 w-5 text-purple-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                            ></path>
                          </svg>
                        </span>
                        Printed Abstract Book
                      </div>
                    </td>
                    <td class="bg-emerald-50/40 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-emerald-700 sm:text-2xl"
                        >30 EUR</span
                      >
                    </td>
                    <td class="bg-blue-50/35 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-[#2a5298] sm:text-2xl"
                        >30 EUR</span
                      >
                    </td>
                    <td class="bg-slate-50/50 px-4 py-4 text-center sm:px-6 sm:py-5">
                      <span class="text-xl font-bold text-slate-700 sm:text-2xl"
                        >30 EUR</span
                      >
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- What's Included -->
        <div class="mb-10 grid gap-6 md:grid-cols-2">
          <div
            class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm ring-1 ring-black/[0.03]"
          >
            <div class="h-1 bg-gradient-to-r from-[#1e3c72] to-[#2a5298]"></div>
            <div
              class="flex items-center gap-4 border-b border-slate-100 bg-slate-50/80 px-6 py-5"
            >
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-100 text-[#2a5298]"
              >
                <svg
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold leading-tight text-slate-900">
                  Regular & Student
                </h3>
                <p class="text-sm text-slate-500">Registration Includes</p>
              </div>
            </div>
            <div class="px-6 py-6">
              <ul class="space-y-3">
                {[
                  'Admission to all scientific sessions',
                  'Conference materials',
                  'Welcome reception',
                  'Coffee breaks',
                  'Lunch',
                  'Evening social program',
                  'Zagreb city tour',
                ].map((item) => (
                  <li class="flex items-center gap-3 text-slate-700">
                    <span
                      class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2a5298]"
                    >
                      <svg
                        class="h-3 w-3 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"></path>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div
            class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm ring-1 ring-black/[0.03]"
          >
            <div class="h-1 bg-gradient-to-r from-rose-500 to-rose-700"></div>
            <div
              class="flex items-center gap-4 border-b border-slate-100 bg-rose-50/40 px-6 py-5"
            >
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-rose-100 text-rose-700"
              >
                <svg
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold leading-tight text-slate-900">
                  Accompanying Person
                </h3>
                <p class="text-sm text-slate-500">Registration Includes</p>
              </div>
            </div>
            <div class="px-6 py-6">
              <ul class="space-y-3">
                {[
                  'Welcome reception',
                  'Coffee breaks',
                  'Lunch',
                  'Evening social program',
                  'Zagreb city tour',
                ].map((item) => (
                  <li class="flex items-center gap-3 text-slate-700">
                    <span
                      class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-600"
                    >
                      <svg
                        class="h-3 w-3 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"></path>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              <p
                class="mt-5 border-t border-slate-100 pt-4 text-sm italic text-slate-500"
              >
                Perfect for partners and family members joining the congress experience
              </p>
            </div>
          </div>
        </div>

        <!-- Student Verification Notice -->
        <div
          class="mb-10 rounded-3xl border-2 border-indigo-200/90 bg-white"
        >
          <div
            class="bg-gradient-to-br from-indigo-50/70 via-white to-violet-50/40 px-6 py-6 sm:px-8 sm:py-7"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-indigo-200/60 bg-indigo-100/90"
              >
                <svg
                  class="h-6 w-6 text-indigo-700"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l9-5-9-5-9 5 9 5z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                  ></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1 rounded-2xl border border-indigo-100/90 bg-white/70 px-4 py-4 sm:px-5 sm:py-4">
                <h4 class="mb-2 text-base font-bold tracking-tight text-indigo-950">
                  Student Registration Verification
                </h4>
                <p class="text-sm leading-relaxed text-indigo-950/85">
                  To certify your student status, please provide a copy of your Student ID or a confirmation
                  signed by your advisor/head of department. Send the documentation by e-mail to&nbsp;
