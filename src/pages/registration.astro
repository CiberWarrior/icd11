---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Registration | ICD 2027"
  description="Register for the 11th International Congress of Dipterology. Fees, deadlines, and registration link for ICD 2027 in Zagreb."
>
  <Header />

  <HeroCountdown />

  <!-- Registration Fees Section -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">

        <!-- Registration Fees Table -->
        <div class="mb-8 rounded-2xl overflow-hidden shadow-xl border border-gray-100">
          <!-- Section header banner -->
          <div class="relative bg-gradient-to-r from-blue-900 via-blue-800 to-blue-700 px-8 py-7 overflow-hidden">
            <!-- Decorative background shapes -->
            <div class="absolute -top-8 -right-8 w-40 h-40 bg-white/5 rounded-full"></div>
            <div class="absolute bottom-0 right-24 w-24 h-24 bg-white/5 rounded-full"></div>
            <div class="absolute top-2 right-64 w-12 h-12 bg-white/5 rounded-full"></div>
            <div class="relative flex items-center gap-5">
              <div class="w-14 h-14 rounded-2xl bg-white/15 border border-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-2xl lg:text-3xl font-bold text-white">Registration Fees</h2>
              </div>
            </div>
          </div>

          <!-- White body -->
          <div class="bg-white p-8 lg:p-10">

          <!-- Fees Table -->
          <div class="overflow-x-auto mb-8">
            <table class="w-full border-collapse rounded-xl overflow-hidden shadow-lg">
              <thead>
                <tr>
                  <th class="px-6 py-5 text-left font-bold text-white bg-gradient-to-r from-primary to-primary-dark text-lg">
                    Registration Type
                  </th>
                  <th class="px-6 py-5 text-center font-bold text-white bg-gradient-to-br from-emerald-500 to-emerald-600 relative">
                    <div class="absolute -top-0 left-1/2 -translate-x-1/2 bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-b-lg shadow-md">
                      BEST VALUE
                    </div>
                    <span class="block text-lg mt-2">Regular</span>
                    <span class="block text-sm opacity-90 font-normal">1.9. – 28.2.2027</span>
                  </th>
                  <th class="px-6 py-5 text-center font-bold text-white bg-gradient-to-r from-slate-600 to-slate-700">
                    <span class="block text-lg">Late</span>
                    <span class="block text-sm opacity-90 font-normal">1.3. – 15.6.2027</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white hover:bg-blue-50 transition-all duration-200 group">
                  <td class="px-6 py-5 border-b border-gray-100 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                      </span>
                      Regular Delegate
                    </div>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">630 EUR</span>
                    <span class="block text-xs text-emerald-600 font-medium mt-1">Save 170 EUR</span>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">800 EUR</span>
                  </td>
                </tr>
                <tr class="bg-gradient-to-r from-blue-50/30 to-transparent hover:from-blue-100/50 transition-all duration-200 group">
                  <td class="px-6 py-5 border-b border-gray-100 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                        </svg>
                      </span>
                      Student Delegate
                    </div>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">390 EUR</span>
                    <span class="block text-xs text-emerald-600 font-medium mt-1">Save 110 EUR</span>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">500 EUR</span>
                  </td>
                </tr>
                <tr class="bg-white hover:bg-blue-50 transition-all duration-200 group">
                  <td class="px-6 py-5 border-b border-gray-100 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                      </span>
                      Accompanying Person
                    </div>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">350 EUR</span>
                    <span class="block text-xs text-emerald-600 font-medium mt-1">Save 100 EUR</span>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">450 EUR</span>
                  </td>
                </tr>
                <tr class="bg-gradient-to-r from-blue-50/30 to-transparent hover:from-blue-100/50 transition-all duration-200 group">
                  <td class="px-6 py-5 border-b border-gray-100 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 20h20M4 20C4 13.373 7.582 8 12 8s8 5.373 8 12M12 8V5m-1 0h2"></path>
                        </svg>
                      </span>
                      Congress Dinner
                    </div>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">80 EUR</span>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">80 EUR</span>
                  </td>
                </tr>
                <tr class="bg-white hover:bg-blue-50 transition-all duration-200 group">
                  <td class="px-6 py-5 border-b border-gray-100 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 20h20M4 20C4 13.373 7.582 8 12 8s8 5.373 8 12M12 8V5m-1 0h2"></path>
                        </svg>
                      </span>
                      Congress Dinner (Accompanying person)
                    </div>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">80 EUR</span>
                  </td>
                  <td class="px-6 py-5 border-b border-gray-100 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">80 EUR</span>
                  </td>
                </tr>
                <tr class="bg-gradient-to-r from-blue-50/30 to-transparent hover:from-blue-100/50 transition-all duration-200 group">
                  <td class="px-6 py-5 font-semibold text-gray-900 group-hover:text-primary transition-colors">
                    <div class="flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                      </span>
                      Printed Abstract Book
                    </div>
                  </td>
                  <td class="px-6 py-5 text-center bg-emerald-50/50">
                    <span class="text-2xl font-bold text-emerald-600">30 EUR</span>
                  </td>
                  <td class="px-6 py-5 text-center bg-slate-50/50">
                    <span class="text-2xl font-bold text-slate-600">30 EUR</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          </div>{/* end white body */}
        </div>{/* end fees card */}

        <!-- What's Included -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <!-- Regular & Student Card -->
          <div class="rounded-2xl shadow-lg overflow-hidden border border-blue-100">
            <!-- Coloured header -->
            <div class="bg-gradient-to-r from-blue-700 to-blue-500 px-6 py-5 flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white leading-tight">Regular & Student</h3>
                <p class="text-blue-100 text-sm">Registration Includes</p>
              </div>
            </div>
            <!-- White body -->
            <div class="bg-white px-6 py-5">
              <ul class="space-y-3">
                {[
                  'Admission to all scientific sessions',
                  'Conference materials',
                  'Welcome reception',
                  'Coffee breaks',
                  'Lunch',
                  'Evening social program',
                  'Zagreb city tour',
                ].map((item) => (
                  <li class="flex items-center gap-3 text-gray-700">
                    <span class="w-5 h-5 rounded-full bg-blue-600 flex items-center justify-center flex-shrink-0">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Accompanying Person Card -->
          <div class="rounded-2xl shadow-lg overflow-hidden border border-rose-100">
            <!-- Coloured header -->
            <div class="bg-gradient-to-r from-rose-700 to-rose-500 px-6 py-5 flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white leading-tight">Accompanying Person</h3>
                <p class="text-rose-100 text-sm">Registration Includes</p>
              </div>
            </div>
            <!-- White body -->
            <div class="bg-white px-6 py-5">
              <ul class="space-y-3">
                {[
                  'Welcome reception',
                  'Coffee breaks',
                  'Lunch',
                  'Evening social program',
                  'Zagreb city tour',
                ].map((item) => (
                  <li class="flex items-center gap-3 text-gray-700">
                    <span class="w-5 h-5 rounded-full bg-rose-600 flex items-center justify-center flex-shrink-0">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              <p class="mt-5 pt-4 border-t border-gray-100 text-gray-500 text-sm italic">
                Perfect for partners and family members joining the congress experience
              </p>
            </div>
          </div>
        </div>

        <!-- Student Verification Notice -->
        <div class="flex items-start gap-4 bg-amber-50 border border-amber-200 rounded-2xl px-6 py-5 mb-8">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center mt-0.5">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-amber-900 mb-1">Student Registration Verification</h4>
            <p class="text-amber-800 text-sm leading-relaxed">
              To certify your student status, please provide a copy of your Student ID or a confirmation
              signed by your advisor/head of department. Send the documentation by e-mail to&nbsp;
              <a href="mailto:icd2027@etours.hr" class="font-semibold underline underline-offset-2 hover:text-amber-600 transition-colors">
                icd2027@etours.hr
              </a>.
            </p>
          </div>
        </div>

        <!-- Cancellation Policy -->
        <div class="mb-8 border border-gray-200 rounded-xl p-6">
          <h3 class="text-base font-semibold text-gray-600 mb-4 uppercase tracking-wide">Cancellation & Payment Conditions</h3>

          <div class="space-y-2 mb-5 text-sm">
            <div class="flex items-center gap-3 py-2.5 border-b border-gray-100">
              <span class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></span>
              <span class="text-gray-500 w-52 flex-shrink-0">Before 1 Mar 2027</span>
              <span class="text-gray-700">Full refund (–EUR 30 handling fee)</span>
            </div>
            <div class="flex items-center gap-3 py-2.5 border-b border-gray-100">
              <span class="w-2 h-2 rounded-full bg-yellow-400 flex-shrink-0"></span>
              <span class="text-gray-500 w-52 flex-shrink-0">2 Mar – 10 Jun 2027</span>
              <span class="text-gray-700">30% refund (–EUR 30 handling fee)</span>
            </div>
            <div class="flex items-center gap-3 py-2.5">
              <span class="w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
              <span class="text-gray-500 w-52 flex-shrink-0">After 11 Jun 2027</span>
              <span class="text-gray-700">No refund</span>
            </div>
          </div>

          <p class="text-xs text-gray-400 leading-relaxed">
            All amendments and cancellations must be sent to
            <a href="mailto:icd2027@etours.hr" class="text-gray-500 hover:text-gray-700 underline underline-offset-2 transition-colors">icd2027@etours.hr</a>.
            Refunds are processed after the event. Bank charges and commissions are covered by the participant.
          </p>
        </div>

        <!-- Register Button -->
        <div class="text-center">
          <Button variant="primary" size="lg" href="#">
            Register Now
          </Button>
          <p class="text-gray-500 text-sm mt-3">
            Registration platform link will be added when available.
          </p>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
