---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | ICD 2027"
  description="The page you are looking for could not be found."
>
  <Header />

  <section class="min-h-[60vh] flex items-center justify-center bg-[#f9fafb] px-4">
    <div class="text-center max-w-lg">
      <div class="w-20 h-20 rounded-2xl bg-[#2a5298]/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-6xl font-bold text-[#2a5298] mb-3">404</h1>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Page Not Found</h2>
      <p class="text-gray-600 leading-relaxed mb-8">
        Sorry, the page you are looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-[#2a5298] hover:bg-[#1e3c72] text-white font-semibold px-6 py-3 rounded-full transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Home
      </a>
    </div>
  </section>

  <Footer />
</Layout>
