---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';

const organizingMembers = [
  {
    name: 'Marija Ivković',
    role: 'ICDXI Chair',
    institution: 'Dept. of Biology, Faculty of Science, University of Zagreb',
    image: '/images/marija-ivkovic.jpg',
    bio: '',
  },
  {
    name: 'Vlatka Mičetić Stanković',
    role: '',
    institution: 'Croatian Natural History Museum, Zagreb',
    image: '/images/vlatka-micetic-stankovic.jpg',
    bio: '',
  },
  {
    name: 'Romana Gračan',
    role: '',
    institution: 'Dept. of Biology, Faculty of Science, University of Zagreb',
    image: '/images/romana-gracan.jpg',
    bio: '',
  },
  {
    name: 'Tanja Vojvoda Zeljko',
    role: '',
    institution: 'Dept. of Biochemical Engineering, Faculty of Food Technology and Biotechnology, University of Zagreb',
    image: '/images/tanja-vojvoda-zeljko.jpg',
    bio: '',
  },
  {
    name: 'Mirela Sertić Perić',
    role: '',
    institution: 'Dept. of Biology, Faculty of Science, University of Zagreb',
    image: '/images/mirela-sertic-peric.jpg',
    bio: '',
  },
  {
    name: 'Ana Klobučar',
    role: '',
    institution: 'Andrija Štampar Teaching Institute of Public Health, Zagreb',
    image: '/images/ana-klobucar.jpg',
    bio: '',
  },
  {
    name: 'Mirela Gašpar',
    role: 'Technical Organizer',
    institution: 'e-Tours, Ulica grada Vukovara 5-1, 10000, Zagreb, Croatia',
    image: '/images/mirela-gaspar.jpg',
    bio: '',
  },
];

const scientificMembers = [
  {
    name: 'Marija Ivković',
    role: 'Head of the committee',
    institution:
      'Department of Biology, Faculty of Science, University of Zagreb, Zagreb, Croatia',
  },
  {
    name: 'Jade Savage',
    role: '',
    institution: "Biological Sciences, Bishop's University, Sherbrooke, Canada",
  },
  {
    name: 'Keith M. Bayless',
    role: '',
    institution:
      'Australian National Insect Collection, CSIRO National Research Collections Australia, Canberra, Australia',
  },
  {
    name: 'Martin Hauser',
    role: '',
    institution:
      'Plant Pest Diagnostics Branch, California Department of Food and Agriculture, Sacramento, California, USA',
  },
  {
    name: 'Levente-Péter Kolcsár',
    role: '',
    institution: 'Ditrău, Romania',
  },
  {
    name: 'Stjepan Krčmar',
    role: '',
    institution:
      'Department of Biology, Josip Juraj Strossmayer University of Osijek, Osijek, Croatia',
  },
  {
    name: 'Gunnar M. Kvifte',
    role: '',
    institution:
      'Department of Biosciences and Aquaculture, Nord University, Steinkjer, Norway',
  },
  {
    name: 'Ximo Mengual',
    role: '',
    institution:
      'Museum Koenig Bonn, Leibniz-Institut zur Analyse des Biodiversitätswandels, Bonn, Germany',
  },
  {
    name: 'John Kevin Moulton',
    role: '',
    institution:
      'Department of Entomology and Plant Pathology, University of Tennessee, Knoxville, Tennessee, USA',
  },
  {
    name: 'Adrian C. Pont',
    role: '',
    institution: 'Oxford University Museum of Natural History, Oxford, UK',
  },
  {
    name: 'Bradley J. Sinclair',
    role: '',
    institution:
      'Canadian Food Inspection Agency & Canadian National Collection of Insects, Agriculture and Agri-Food, Ottawa, Ontario, Canada',
  },
  {
    name: 'Daniel Whitmore',
    role: '',
    institution:
      'Department of Entomology, Natural History Museum Stuttgart, Stuttgart, Germany',
  },
];
---

<Layout
  title="Committees | ICD 2027"
  description="Meet the organizing and scientific committees of the 11th International Congress of Dipterology (ICD 2027) in Zagreb, Croatia."
>
  <Header />

  <HeroCountdown />

  <section class="section-padding bg-gradient-to-b from-slate-50 via-white to-slate-50/50">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">

        <!-- Organizing Committee -->
        <div>
          <div class="text-center mb-12 lg:mb-14">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-red-500/10 to-red-600/20 flex items-center justify-center mx-auto mb-5 shadow-sm">
              <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-4">Organizing Committee</h2>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">Meet the dedicated team behind ICD 2027</p>
          </div>

          <!-- Row 1: first 3 members -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 max-w-4xl mx-auto mb-10">
            {organizingMembers.slice(0, 3).map((member, i) => (
              <div
                class={`bg-white rounded-2xl shadow-lg hover:shadow-xl overflow-hidden border-t-4 border-t-red-500 border border-gray-100 text-center transition-all duration-300 ${member.bio ? 'member-card cursor-pointer group' : ''}`}
                data-index={member.bio ? `oc-${i}` : undefined}
              >
                <div class="pt-8 pb-4 flex justify-center">
                  <img src={member.image} alt={member.name} class="w-40 h-40 rounded-full object-cover object-center shadow-xl ring-4 ring-white" />
                </div>
                <div class="px-5 pb-7 pt-2">
                  <h3 class="font-bold text-gray-900 text-base mb-1">{member.name}</h3>
                  {member.role && <p class="text-sm text-[#2a5298] font-semibold mb-2">{member.role}</p>}
                  <p class="text-xs text-gray-500 leading-relaxed min-h-[2.5rem]">{member.institution}</p>
                  {member.bio && (
                    <span class="inline-flex items-center gap-1.5 mt-4 text-xs text-white font-medium bg-[#2a5298] group-hover:bg-[#1e3c72] px-4 py-2 rounded-full transition-colors shadow-sm">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      Read bio
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Row 2: remaining 4 members (centered) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 max-w-5xl mx-auto">
            {organizingMembers.slice(3).map((member, i) => (
              <div
                class={`bg-white rounded-2xl shadow-lg hover:shadow-xl overflow-hidden border-t-4 border-t-red-500 border border-gray-100 text-center transition-all duration-300 ${member.bio ? 'member-card cursor-pointer group' : ''}`}
                data-index={member.bio ? `oc-${i + 3}` : undefined}
              >
                <div class="pt-8 pb-4 flex justify-center">
                  <img src={member.image} alt={member.name} class="w-40 h-40 rounded-full object-cover object-center shadow-xl ring-4 ring-white" />
                </div>
                <div class="px-5 pb-7 pt-2">
                  <h3 class="font-bold text-gray-900 text-base mb-1">{member.name}</h3>
                  {member.role && <p class="text-sm text-[#2a5298] font-semibold mb-2">{member.role}</p>}
                  <p class="text-xs text-gray-500 leading-relaxed min-h-[2.5rem]">{member.institution}</p>
                  {member.bio && (
                    <span class="inline-flex items-center gap-1.5 mt-4 text-xs text-white font-medium bg-[#2a5298] group-hover:bg-[#1e3c72] px-4 py-2 rounded-full transition-colors shadow-sm">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      Read bio
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Scientific Committee -->
        <div class="mt-20 border-t border-slate-200/80 pt-16 lg:mt-24 lg:pt-20">
          <div class="mb-12 text-center lg:mb-14">
            <div
              class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/20 shadow-sm"
            >
              <svg
                class="h-8 w-8 text-[#2a5298]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </div>
            <h2 class="mb-4 text-4xl font-bold text-[#2a5298] lg:text-5xl">
              Scientific Committee
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {scientificMembers.map((member) => (
              <article
                class={`rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-lg transition-all duration-300 hover:shadow-xl sm:p-7 ${
                  member.role
                    ? 'border-t-4 border-t-[#2a5298] ring-1 ring-[#2a5298]/10'
                    : 'border-t-4 border-t-[#2a5298]'
                }`}
              >
                <div class="mb-4 flex justify-center">
                  <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/20 text-[#2a5298]"
                    aria-hidden="true"
                  >
                    <svg
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <h3 class="mb-1 text-base font-bold text-gray-900">{member.name}</h3>
                {member.role && (
                  <p class="mb-2 text-sm font-semibold text-[#2a5298]">{member.role}</p>
                )}
                <p class="text-xs leading-relaxed text-gray-500">{member.institution}</p>
              </article>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Conference Organizer & Co-organizers -->
  <section class="py-16 lg:py-20 bg-gradient-to-b from-white via-blue-50/30 to-white border-t border-gray-100">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        
        <div class="space-y-12">
          
          <!-- Conference Organizer -->
          <div class="text-center">
            <p class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-6">Conference Organizer</p>
            <div class="flex justify-center">
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl px-8 py-6 border border-gray-200 transition-all duration-300 hover:scale-105">
                <a 
                  href="https://www.husek.hr" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-80 transition-opacity"
                  title="Husek - Conference Organizer"
                >
                  <img 
                    src="/images/Husek-logo.png" 
                    alt="Husek Logo" 
                    class="h-28 sm:h-32 w-auto object-contain"
                  />
                </a>
              </div>
            </div>
          </div>

          <!-- Divider -->
          <div class="flex items-center justify-center">
            <div class="h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent w-full max-w-md"></div>
          </div>

          <!-- Co-organizers -->
          <div class="text-center">
            <p class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-6">Co-organizers</p>
            <div class="flex flex-wrap items-center justify-center gap-6 lg:gap-8">
              <!-- Biology Department Logo -->
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl px-6 py-5 border border-gray-200 transition-all duration-300 hover:scale-105">
                <a 
                  href="https://www.pmf.unizg.hr/biol/en" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-80 transition-opacity"
                  title="Biology Department, Faculty of Science"
                >
                  <img 
                    src="/images/logo-biol-pmf.png" 
                    alt="Biology Department Logo" 
                    class="h-16 w-auto object-contain"
                  />
                </a>
              </div>

              <!-- PMF Logo -->
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl px-6 py-5 border border-gray-200 transition-all duration-300 hover:scale-105">
                <a 
                  href="https://www.pmf.unizg.hr/en" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-80 transition-opacity"
                  title="Faculty of Science, University of Zagreb"
                >
                  <img 
                    src="/images/pmf-logo.png" 
                    alt="PMF Logo" 
                    class="h-16 w-auto object-contain"
                  />
                </a>
              </div>

              <!-- Croatian Natural History Museum Logo -->
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl px-6 py-5 border border-gray-200 transition-all duration-300 hover:scale-105">
                <a 
                  href="https://www.hpm.hr/en/homepage-2/" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-80 transition-opacity"
                  title="Croatian Natural History Museum"
                >
                  <img 
                    src="/images/HPM_logo-HR-EN.png" 
                    alt="Croatian Natural History Museum Logo" 
                    class="h-16 w-auto object-contain"
                  />
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Modal -->
  <div id="member-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative flex items-center justify-center min-h-screen p-4">
      <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto relative" id="modal-content">
        <div class="border-t-4 border-t-[#2a5298] rounded-2xl overflow-hidden">
          <button type="button" id="modal-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors z-10" aria-label="Close">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          <div class="p-6 sm:p-8">
            <div class="flex flex-col items-center text-center mb-6">
              <img id="modal-image" src="" alt="" class="w-36 h-36 rounded-full object-cover shadow-lg mb-5 border-4 border-white ring-2 ring-gray-100" />
              <h3 id="modal-name" class="text-2xl font-bold text-gray-900"></h3>
              <p id="modal-role" class="text-sm text-[#2a5298] font-medium mt-1"></p>
              <p id="modal-institution" class="text-sm text-gray-500 mt-2"></p>
            </div>
            <div class="border-t border-gray-100 pt-5">
              <p id="modal-bio" class="text-sm text-gray-600 leading-relaxed"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />

  <script define:vars={{ organizingMembers }}>
    const allMembers = {};
    organizingMembers.forEach((m, i) => { allMembers[`oc-${i}`] = m; });

    const modal = document.getElementById('member-modal');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalClose = document.getElementById('modal-close');
    const modalImage = document.getElementById('modal-image');
    const modalName = document.getElementById('modal-name');
    const modalRole = document.getElementById('modal-role');
    const modalInstitution = document.getElementById('modal-institution');
    const modalBio = document.getElementById('modal-bio');

    function openModal(key) {
      const member = allMembers[key];
      if (!member || !member.bio) return;
      modalImage.src = member.image;
      modalImage.alt = member.name;
      modalName.textContent = member.name;
      modalRole.textContent = member.role || '';
      modalRole.style.display = member.role ? 'block' : 'none';
      modalInstitution.textContent = member.institution;
      modalBio.textContent = member.bio;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.member-card[data-index]').forEach((card) => {
      card.addEventListener('click', () => {
        openModal(card.dataset.index);
      });
    });

    modalBackdrop.addEventListener('click', closeModal);
    modalClose.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
</Layout>
