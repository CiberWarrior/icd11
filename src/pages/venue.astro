  <!-- Weather script -->
  <script is:inline>
  (async function() {
    const API_KEY = 'b1b15e88fa797225412429c1c50c122a1';
    const CITY = 'Zagreb';
    const UNITS = 'metric';
    const STORAGE_KEY = 'icd2027-zagreb-weather-cache';
    const REQUEST_TIMEOUT_MS = 8000;
    const weatherIcons = {
      '01d':'☀️','01n':'🌙','02d':'⛅','02n':'☁️','03d':'☁️','03n':'☁️',
      '04d':'☁️','04n':'☁️','09d':'🌧️','09n':'🌧️','10d':'🌦️','10n':'🌧️',
      '11d':'⛈️','11n':'⛈️','13d':'❄️','13n':'❄️','50d':'🌫️','50n':'🌫️',
    };
    async function fetchJsonWithTimeout(url) {
      const controller = new AbortController();
      const timeoutId = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
      try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error(`Status ${response.status}`);
        return await response.json();
      } finally { window.clearTimeout(timeoutId); }
    }
    function hasCurrentWeatherData(data) {
      return Boolean(data?.main && typeof data.main.temp === 'number' && data.wind && data.weather?.[0]?.icon);
    }
    function hasForecastData(data) { return Boolean(data && Array.isArray(data.list) && data.list.length); }
    function getDailyForecasts(list) {
      const map = new Map();
      list.forEach(item => {
        if (!item?.dt || !item.main || !item.weather?.[0]) return;
        const date = new Date(item.dt * 1000);
        const key = date.toLocaleDateString('en-CA');
        const dist = Math.abs(date.getHours() - 12);
        const ex = map.get(key);
        if (!ex || dist < ex.dist) map.set(key, { item, dist });
      });
      return Array.from(map.values()).slice(0, 5).map(({ item }) => {
        const d = new Date(item.dt * 1000);
        return { day: d.toLocaleDateString('en-US', { weekday: 'short' }), icon: weatherIcons[item.weather[0].icon] || '☁️', temp: Math.round(item.main.temp) };
      });
    }
    function renderWeather(cur, fore, opts = {}) {
      const el = id => document.getElementById(id);
      if (!el('current-temp')) return;
      el('current-temp').textContent = Math.round(cur.main.temp) + '°C';
      el('current-desc').textContent = cur.weather[0].description;
      el('current-icon').textContent = weatherIcons[cur.weather[0].icon] || '☁️';
      el('feels-like').textContent = Math.round(cur.main.feels_like) + '°C';
      el('humidity').textContent = cur.main.humidity + '%';
      el('wind').textContent = cur.wind.speed.toFixed(1) + ' m/s';
      el('forecast-container').innerHTML = getDailyForecasts(fore.list).map(d => `
        <div class="bg-white rounded-xl p-3 text-center border border-gray-200">
          <p class="text-xs font-medium text-gray-400 mb-2">${d.day}</p>
          <div class="text-2xl mb-2">${d.icon}</div>
          <p class="text-base font-bold text-gray-900">${d.temp}°C</p>
        </div>`).join('');
      if (opts.isCached && opts.savedAt) {
        el('weather-meta').textContent = `Last updated: ${new Date(opts.savedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })} (saved data)`;
        el('weather-meta').classList.remove('hidden');
      }
      el('weather-loading').classList.add('hidden');
      el('weather-error').classList.add('hidden');
      el('weather-content').classList.remove('hidden');
    }
    function showWeatherError() {
      const el = id => document.getElementById(id);
      el('weather-loading').classList.add('hidden');
      el('weather-content').classList.add('hidden');
      el('weather-error').classList.remove('hidden');
    }
    try {
      const [cur, fore] = await Promise.all([
        fetchJsonWithTimeout(`https://api.openweathermap.org/data/2.5/weather?q=${CITY}&units=${UNITS}&appid=${API_KEY}`),
        fetchJsonWithTimeout(`https://api.openweathermap.org/data/2.5/forecast?q=${CITY}&units=${UNITS}&appid=${API_KEY}`),
      ]);
      if (!hasCurrentWeatherData(cur) || !hasForecastData(fore)) throw new Error('Bad data');
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ currentData: cur, forecastData: fore, savedAt: Date.now() }));
      renderWeather(cur, fore);
    } catch (e) {
      const cached = localStorage.getItem(STORAGE_KEY);
      if (cached) {
        try {
          const { currentData, forecastData, savedAt } = JSON.parse(cached);
          if (hasCurrentWeatherData(currentData) && hasForecastData(forecastData)) {
            renderWeather(currentData, forecastData, { isCached: true, savedAt });
            return;
          }
        } catch (_) {}
      }
      showWeatherError();
    }
  })();
  </script>

  <!-- Scroll animations: Intersection Observer (same approach as index.astro) -->
  <script>
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-up');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.card-animate').forEach((el) => {
      observer.observe(el);
    });

    // Hotel image lightbox - open on same page, close via button or Escape
    const lightbox = document.getElementById('hotel-image-lightbox');
    const lightboxImg = document.getElementById('hotel-lightbox-image');
    const lightboxClose = document.getElementById('hotel-lightbox-close');

    function openLightbox(src: string) {
      if (!lightbox || !lightboxImg) return;
      (lightboxImg as HTMLImageElement).src = src;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.hotel-image-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        if (src) openLightbox(src);
      });
    });

    if (lightboxClose) {
      lightboxClose.addEventListener('click', closeLightbox);
    }

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  </script>
