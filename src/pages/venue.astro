---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

// Import Lucide icons for transport
import { Plane, Car, Bus, Train } from '@lucide/astro';
---

<Layout
  title="Venue - Hotel Westin Zagreb | ICD 2027"
  description="The 11th International Congress of Dipterology will be held at the Westin Zagreb Hotel in the heart of Croatia's capital city."
>
  <Header />
  <HeroCountdown />

  <div class="venue-page">
    <!-- Hotel Westin Section -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 card-animate">
        <h2 class="text-5xl lg:text-6xl font-bold text-[#2a5298] mb-6 uppercase tracking-wide">
          The Westin Hotel Zagreb
        </h2>
        <p class="text-xl text-gray-600 leading-relaxed">
          Experience world-class hospitality in the heart of Croatia's vibrant capital
        </p>
      </div>

      <!-- Hotel Content Card -->
      <Card variant="elevated" class="p-8 lg:p-10 card-animate max-w-6xl mx-auto no-card-hover">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
            <!-- Hotel Images Grid 2x2 - Left column -->
            <div class="order-2 lg:order-1">
              <div class="grid grid-cols-2 gap-3">
                <!-- Image 1 - click opens lightbox on same page -->
                <button
                  type="button"
                  class="hotel-image-link w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-1.jpg"
                  aria-label="Open image full size"
                >
                  <img
                    src="/images/westin-hotel-1.jpg"
                    alt="The Westin Zagreb Hotel - Exterior"
                    class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-12 h-12 text-primary-600\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\'></path></svg></div>'"
                  />
                </button>

                <!-- Image 2 -->
                <button
                  type="button"
                  class="hotel-image-link w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-2.jpg"
                  aria-label="Open image full size"
                >
                  <img
                    src="/images/westin-hotel-2.jpg"
                    alt="The Westin Zagreb Hotel - Lobby"
                    class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-12 h-12 text-primary-600\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\'></path></svg></div>'"
                  />
                </button>

                <!-- Image 3 -->
                <button
                  type="button"
                  class="hotel-image-link w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-3.jpg"
                  aria-label="Open image full size"
                >
                  <img
                    src="/images/westin-hotel-3.jpg"
                    alt="The Westin Zagreb Hotel - Conference Room"
                    class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-12 h-12 text-primary-600\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\'></path></svg></div>'"
                  />
                </button>

                <!-- Image 4 -->
                <button
                  type="button"
                  class="hotel-image-link w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-4.jpg"
                  aria-label="Open image full size"
                >
                  <img
                    src="/images/westin-hotel-4.jpg"
                    alt="The Westin Zagreb Hotel - Spa"
                    class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-12 h-12 text-primary-600\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\'></path></svg></div>'"
                  />
                </button>
              </div>
            </div>

            <!-- Hotel Description - Right column -->
            <div class="order-1 lg:order-2 flex flex-col justify-start">
              <div class="max-w-none">
                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  The Westin Zagreb Hotel is centrally located in the very heart of Zagreb. Our conference hotel is situated in a leafy area in Zagreb, adjacent to the Mimara Museum and the world-famous National Theatre and Opera House.
                </p>
                
                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  Our location is within easy walking distance to the central square, markets, the many trendy cafés, restaurants, designer boutiques, rich cultural attractions, and capital city business destinations.
                </p>

                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  Recognized for offering discreet surroundings and professional, caring service, our premium business hotel in Croatia is a regular host to high-profile local, national, and international events. It has been the favorite home-away-from-home for visiting royalty, world leaders, international dignitaries, and other travelers seeking the calm comfort of a modern and corporate hotel in Zagreb city center.
                </p>

                <p class="text-base text-gray-700 leading-relaxed">
                  Take it easy in the evenings with a soothing massage at our Zagreb hotel's spa, to make the most of your stay in Croatia.
                </p>
              </div>

              <!-- Hotel Features Icons -->
              <div class="grid grid-cols-2 gap-3 mt-8">
                <a 
                  href="https://www.marriott.com/en-us/hotels/zagwi-the-westin-zagreb/overview/" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 group"
                >
                  <div class="w-8 h-8 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-primary-700 group-hover:text-primary-800 underline">Hotel Westin</span>
                </a>

                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-accent-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-accent-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Conference Facilities</span>
                </div>

                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Wellness & Spa</span>
                </div>

                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Premium Service</span>
                </div>
              </div>
            </div>
          </div>
        </Card>
    </div>
  </section>

  <!-- Hotel image lightbox - opens on same page, user can close -->
  <div
    id="hotel-image-lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4 hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <div class="relative max-w-6xl max-h-[90vh] w-full flex items-center justify-center">
      <img
        id="hotel-lightbox-image"
        src=""
        alt="Hotel image"
        class="max-w-full max-h-[90vh] w-auto h-auto object-contain rounded-lg shadow-2xl"
      />
    </div>
    <button
      type="button"
      id="hotel-lightbox-close"
      class="fixed top-4 right-4 z-[60] flex items-center justify-center w-12 h-12 rounded-full bg-white/95 hover:bg-white text-gray-800 font-bold text-2xl transition-colors focus:outline-none focus:ring-2 focus:ring-white shadow-lg"
      aria-label="Close"
    >
      ×
    </button>
  </div>

  <!-- About Zagreb Section -->
  <section class="pt-16 lg:pt-24 pb-6 bg-[#f9fafb]">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-16 card-animate">

        <!-- Zagreb Logo -->
        <div class="flex justify-center">
          <img
            src="/images/zagreb-logo.png"
            alt="Zagreb Logo"
            class="h-32 lg:h-40 w-auto"
          />
        </div>
      </div>

      <div class="space-y-8 max-w-6xl mx-auto">
        <!-- Zagreb Description Card -->
        <div class="card-animate rounded-2xl shadow-md overflow-hidden bg-gray-50 border border-gray-200 border-t-4 border-t-[#b1414b] no-card-hover">
          <div class="p-8 lg:p-10">
            <!-- Header with Red Heart Icon -->
            <div class="flex items-center gap-3 mb-6 no-card-hover">
              <div class="bg-white rounded-xl p-3 shadow-sm border border-gray-100 flex-shrink-0">
                <svg class="w-8 h-8 text-[#b1414b]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path>
                </svg>
              </div>
              <h3 class="text-2xl lg:text-3xl font-bold text-[#2a5298] leading-tight">Zagreb – City with a Million Hearts</h3>
            </div>

            <div class="space-y-4 text-sm leading-relaxed text-gray-600">
              <p>
                <strong class="text-gray-900">Effervescent, avant-garde and always elegant</strong>, Zagreb embodies the grace and dignity of Old Europe, boasting a rich cultural heritage and artistic vibrancy unlike anywhere else in Croatia. A dynamic, yet unhurried metropolis and capital city, Zagreb's design beckons one to stroll, relax, and observe, with its many gardens, alfresco squares, landscaped promenades, and secret courtyards.
              </p>
              <p>
                Today, Zagreb's long history is evident in every structure and sidewalk, while its vibrant and cutting-edge art scene energizes contemporary society. The city is divided into three sections: <strong class="text-gray-900">Gornji Grad</strong> ("Upper Town") the historic centre, <strong class="text-gray-900">Donji Grad</strong> ("Lower Town") built mostly in the 19th century, and <strong class="text-gray-900">Novi Zagreb</strong> ("New Zagreb"), with the modern metropolis encircling the historic areas.
              </p>
            </div>

            <!-- Things to Do Box -->
            <div class="mt-6 bg-white rounded-xl p-5 border border-gray-200 no-card-hover">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <h4 class="text-base font-bold text-gray-900">Things to do</h4>
              </div>
              <p class="text-sm leading-relaxed text-gray-600 mb-4">
                Ride the funicular, visit Zagreb's many colourful markets, embrace the cafe culture, shop for bespoken goods, visit one-of-a kind museums.
              </p>
              <div class="flex flex-wrap gap-2">
                <a href="https://www.infozagreb.hr/en/" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-2 bg-[#2a5298] text-white font-medium text-xs rounded-lg hover:bg-[#1e3c72] transition-colors">
                  Visit Zagreb info
                </a>
                <a href="https://www.infozagreb.hr/en/multimedia/brochures" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-2 bg-[#2a5298] text-white font-medium text-xs rounded-lg hover:bg-[#1e3c72] transition-colors">
                  Digital brochures & maps
                </a>
              </div>
            </div>

            <!-- Zagreb: tramvaj, uspinjača, Dolac – 3 u redu, povećano da manje praznine -->
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-5xl">
              <button
                type="button"
                class="hotel-image-link w-full block rounded-2xl overflow-hidden shadow-md border border-gray-200 aspect-[4/3] cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left p-0 bg-transparent"
                data-src="/images/zagreb-city.jpg"
                aria-label="Otvori sliku – Zagreb tramvaj"
              >
                <img
                  src="/images/zagreb-city.jpg"
                  alt="Zagreb – tramvaj"
                  class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                  onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-white/10\'><svg class=\'w-12 h-12 text-white/50\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14\'></path></svg></div>'"
                />
              </button>
              <button
                type="button"
                class="hotel-image-link w-full block rounded-2xl overflow-hidden shadow-md border border-gray-200 aspect-[4/3] cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left p-0 bg-transparent"
                data-src="/images/zagreb-funicular.jpg"
                aria-label="Otvori sliku – uspinjača"
              >
                <img
                  src="/images/zagreb-funicular.jpg"
                  alt="Zagreb – uspinjača"
                  class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                  onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-white/10\'><svg class=\'w-12 h-12 text-white/50\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14\'></path></svg></div>'"
                />
              </button>
              <button
                type="button"
                class="hotel-image-link w-full block rounded-2xl overflow-hidden shadow-md border border-gray-200 aspect-[4/3] cursor-pointer group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left p-0 bg-transparent"
                data-src="/images/zagreb-dolac.jpg"
                aria-label="Otvori sliku – Dolac"
              >
                <img
                  src="/images/zagreb-dolac.jpg"
                  alt="Zagreb – Dolac"
                  class="w-full h-full object-cover transition duration-300 group-hover:brightness-110"
                  onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-white/10\'><svg class=\'w-12 h-12 text-white/50\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14\'></path></svg></div>'"
                />
              </button>
            </div>

            <!-- In Zagreb + Weather in grid -->
            <div class="mt-8 pt-8 border-t border-gray-100">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                <!-- In Zagreb (ZET) -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden no-card-hover">
                  <div class="bg-gradient-to-r from-[#b1414b] to-[#d4565f] px-7 py-5">
                    <div class="flex items-center gap-3">
                      <div class="bg-white/20 backdrop-blur-sm rounded-xl p-2.5">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                      </div>
                      <h3 class="text-lg font-bold text-white">In Zagreb</h3>
                    </div>
                  </div>
                  <div class="p-7 space-y-5">
                    <p class="text-gray-600 text-sm leading-relaxed">
                      Zagreb's public transportation system is called <strong class="text-gray-900">ZET</strong> (Zagreb Electric Tram). Made up primarily of buses and trams, it also includes a cable car to Medvednica Mountain and a funicular to Gornji grad.
                    </p>
                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-100 no-card-hover">
                      <div class="flex items-center gap-2 mb-3">
                        <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path>
                        </svg>
                        <h4 class="text-sm font-bold text-gray-900">Tickets & Information</h4>
                      </div>
                      <p class="text-gray-500 text-xs mb-4">Purchase tickets from driver, at kiosk, or via <strong class="text-gray-700">Moj ZET</strong> app.</p>
                      <div class="flex flex-wrap gap-2">
                        <a href="https://www.zet.hr/home/581" target="_blank" rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#2a5298] text-white font-medium text-xs rounded-lg hover:bg-[#1e3c72] transition-colors">
                          ZET Homepage
                        </a>
                        <a href="https://www.zet.hr/tickets-and-fares/fares/605" target="_blank" rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#2a5298] text-white font-medium text-xs rounded-lg hover:bg-[#1e3c72] transition-colors">
                          Fares & Tickets
                        </a>
                      </div>
                    </div>
                    <a href="https://www.meetinzagreb.hr/" target="_blank" rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2.5 text-[#2a5298] font-medium text-sm rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                      Meet in Zagreb
                    </a>
                  </div>
                </div>

                <!-- Weather in Zagreb -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden no-card-hover">
                  <div class="bg-gradient-to-r from-[#2a5298] to-[#3b6fc0] px-7 py-5">
                    <div class="flex items-center gap-3">
                      <div class="bg-white/20 backdrop-blur-sm rounded-xl p-2.5">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                      </div>
                      <h3 class="text-lg font-bold text-white">Weather in Zagreb</h3>
                    </div>
                  </div>
                  <div class="p-7">
                    <div id="weather-container" class="space-y-4">
                      <div id="weather-loading" class="text-center py-8">
                        <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-gray-200 border-t-[#2a5298]"></div>
                        <p class="text-gray-400 mt-3 font-medium text-sm">Loading weather...</p>
                      </div>
                      <div id="weather-content" class="hidden space-y-5">
                        <div class="flex items-start justify-between">
                          <div>
