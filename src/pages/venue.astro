  <!-- Live weather (Open-Meteo, no API key) -->
  <script is:inline>
    (async function () {
      const LAT = 45.8150;
      const LON = 15.9819;
      const URL =
        `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}` +
        '&current_weather=true' +
        '&hourly=temperature_2m,relativehumidity_2m,apparent_temperature,weathercode,windspeed_10m' +
        '&daily=temperature_2m_max,temperature_2m_min,weathercode' +
        '&timezone=auto';

      const elLoading = document.getElementById('weather-loading');
      const elContent = document.getElementById('weather-content');
      const elError = document.getElementById('weather-error');

      const show = (el) => el.classList.remove('hidden');
      const hide = (el) => el.classList.add('hidden');

      const iconMap = {
        0: '☀️',
        1: '🌤️',
        2: '⛅',
        3: '☁️',
        45: '🌫️',
        48: '🌫️',
        51: '🌦️',
        53: '🌦️',
        55: '🌧️',
        56: '🌧️',
        57: '🌧️',
        61: '🌧️',
        63: '🌧️',
        65: '🌧️',
        66: '🌧️',
        67: '🌧️',
        71: '❄️',
        73: '❄️',
        75: '❄️',
        77: '❄️',
        80: '🌧️',
        81: '🌧️',
        82: '🌧️',
        85: '❄️',
        86: '❄️',
        95: '⛈️',
        96: '⛈️',
        99: '⛈️',
      };

      const descMap = {
        0: 'Clear sky',
        1: 'Mainly clear',
        2: 'Partly cloudy',
        3: 'Overcast',
        45: 'Fog',
        48: 'Rime fog',
        51: 'Light drizzle',
        53: 'Moderate drizzle',
        55: 'Dense drizzle',
        56: 'Light freezing drizzle',
        57: 'Dense freezing drizzle',
        61: 'Slight rain',
        63: 'Moderate rain',
        65: 'Heavy rain',
        66: 'Light freezing rain',
        67: 'Heavy freezing rain',
        71: 'Slight snow',
        73: 'Moderate snow',
        75: 'Heavy snow',
        77: 'Snow grains',
        80: 'Rain showers',
        81: 'Moderate showers',
        82: 'Violent showers',
        85: 'Snow showers',
        86: 'Heavy snow showers',
        95: 'Thunderstorm',
        96: 'Thunderstorm w/ hail',
        99: 'Thunderstorm w/ heavy hail',
      };

      const closestIndex = (times, target) => {
        let bestIndex = 0;
        let bestDiff = Infinity;
        const targetTime = new Date(target).getTime();
        for (let i = 0; i < times.length; i += 1) {
          const diff = Math.abs(new Date(times[i]).getTime() - targetTime);
          if (diff < bestDiff) {
            bestDiff = diff;
            bestIndex = i;
          }
        }
        return bestIndex;
      };

      try {
        const res = await fetch(URL);
        if (!res.ok) throw new Error('weather fetch failed');
        const data = await res.json();

        const current = data.current_weather;
        const hourly = data.hourly;
        const daily = data.daily;

        const idx = closestIndex(hourly.time, current.time);

        const toF = (c) => Math.round(c * 9 / 5 + 32);

        const temp = Math.round(current.temperature);
        const feels = Math.round(hourly.apparent_temperature[idx]);
        const humidity = Math.round(hourly.relativehumidity_2m[idx]);
        const wind = Math.round(current.windspeed);
        const code = current.weathercode;

        document.getElementById('current-temp').textContent = `${temp}°C`;
        document.getElementById('current-temp-f').textContent = `${toF(temp)}°F`;
        document.getElementById('current-desc').textContent = descMap[code] || 'Weather';
        document.getElementById('current-icon').textContent = iconMap[code] || '☁️';
        document.getElementById('feels-like').textContent = `${feels}°C / ${toF(feels)}°F`;
        document.getElementById('humidity').textContent = `${humidity}%`;
        document.getElementById('wind').textContent = `${wind} km/h`;

        const forecastEl = document.getElementById('forecast-container');
        const days = daily.time.slice(0, 5);
        forecastEl.innerHTML = days.map((dateStr, i) => {
          const date = new Date(`${dateStr}T12:00:00`);
          const label = date.toLocaleDateString('en-US', { weekday: 'short' });
          const codeDay = daily.weathercode[i];
          const max = Math.round(daily.temperature_2m_max[i]);
          const min = Math.round(daily.temperature_2m_min[i]);
          return `
            <div class="bg-gray-50 rounded-xl p-2.5 text-center border border-gray-100 flex flex-col gap-1">
              <p class="text-[10px] font-bold text-[#2a5298] uppercase tracking-wide">${label}</p>
              <div class="text-2xl leading-none">${iconMap[codeDay] || '☁️'}</div>
              <p class="text-sm font-extrabold text-gray-900">${max}° <span style="font-size:10px;color:#9ca3af;font-weight:500">${toF(max)}°F</span></p>
              <p class="text-[10px] text-gray-400 leading-none">${min}° / ${toF(min)}°F</p>
            </div>`;
        }).join('');

        hide(elLoading);
        hide(elError);
        show(elContent);
      } catch (err) {
        console.error('Weather error:', err);
        hide(elLoading);
        show(elError);
      }
    })();
  </script>

  <!-- Scroll animations: Intersection Observer (same approach as index.astro) -->
  <script>
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-up');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.card-animate').forEach((el) => {
      observer.observe(el);
    });

    // Hotel image lightbox - open on same page, close via button or Escape
    const lightbox = document.getElementById('hotel-image-lightbox');
    const lightboxImgRaw = document.getElementById('hotel-lightbox-image');
    const lightboxImg = lightboxImgRaw instanceof HTMLImageElement ? lightboxImgRaw : null;
    const lightboxClose = document.getElementById('hotel-lightbox-close');

    let lightboxSrc = '';
    const openLightbox = () => {
      if (!lightbox || !lightboxImg || !lightboxSrc) return;
      lightboxImg.src = lightboxSrc;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.hotel-image-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        if (src) {
          lightboxSrc = src;
          openLightbox();
        }
      });
    });

    if (lightboxClose) {
      lightboxClose.addEventListener('click', closeLightbox);
    }

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  </script>
