---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
---

<Layout
  title="Venue - Hotel Westin Zagreb | ICD 2027"
  description="The 11th International Congress of Dipterology will be held at the Westin Zagreb Hotel in the heart of Croatia's capital city."
>
  <Header />
  <HeroCountdown />

  <div class="venue-page">
    <!-- Hotel Westin Section -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 card-animate">
        <h2 class="text-5xl lg:text-6xl font-bold text-gray-900 mb-4 uppercase tracking-wide">
          The Westin Hotel Zagreb
        </h2>
        <p class="text-xl text-gray-600 leading-relaxed">
          Experience world-class hospitality in the heart of Croatia's vibrant capital
        </p>
      </div>

      <!-- Hotel Content Card -->
      <Card variant="elevated" class="p-8 lg:p-10 card-animate max-w-6xl mx-auto no-card-hover">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
            <!-- Hotel Images Grid 2x2 - Left column -->
            <div class="order-2 lg:order-1">
              <div class="grid grid-cols-2 gap-3">
                <!-- Image 1 -->
                <button
                  type="button"
                  class="hotel-image-link relative w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-zoom-in group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-1.jpg"
                  aria-label="Open image full size"
                >
                  <img src="/images/westin-hotel-1.jpg" alt="The Westin Zagreb Hotel - Exterior" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-10 h-10 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                    </div>
                  </div>
                </button>

                <!-- Image 2 -->
                <button
                  type="button"
                  class="hotel-image-link relative w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-zoom-in group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-2.jpg"
                  aria-label="Open image full size"
                >
                  <img src="/images/westin-hotel-2.jpg" alt="The Westin Zagreb Hotel - Lobby" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-10 h-10 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                    </div>
                  </div>
                </button>

                <!-- Image 3 -->
                <button
                  type="button"
                  class="hotel-image-link relative w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-zoom-in group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-3.jpg"
                  aria-label="Open image full size"
                >
                  <img src="/images/westin-hotel-3.jpg" alt="The Westin Zagreb Hotel - Conference Room" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-10 h-10 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                    </div>
                  </div>
                </button>

                <!-- Image 4 -->
                <button
                  type="button"
                  class="hotel-image-link relative w-full block aspect-square rounded-xl overflow-hidden shadow-md cursor-zoom-in group transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg text-left border-0 p-0"
                  data-src="/images/westin-hotel-4.jpg"
                  aria-label="Open image full size"
                >
                  <img src="/images/westin-hotel-4.jpg" alt="The Westin Zagreb Hotel - Spa" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-10 h-10 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                    </div>
                  </div>
                </button>
              </div>
            </div>

            <!-- Hotel Description - Right column -->
            <div class="order-1 lg:order-2 flex flex-col justify-start">
              <div class="max-w-none">
                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  The Westin Zagreb Hotel is centrally located in the very heart of Zagreb, situated in a leafy area adjacent to the Mimara Museum and the world-famous National Theatre and Opera House.
                </p>
                
                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  The hotel is within easy walking distance to the central square, markets, trendy cafés, restaurants, designer boutiques, rich cultural attractions, and capital city business destinations.
                </p>

                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  Recognized for offering discreet surroundings and professional service, the Westin Zagreb is a regular host to high-profile local, national, and international events — a favorite home-away-from-home for visiting dignitaries and travelers seeking the comfort of a modern hotel in Zagreb city centre.
                </p>

                <p class="text-base text-gray-700 leading-relaxed">
                  Guests can unwind in the evenings with a soothing massage at the hotel's spa and wellness centre.
                </p>
              </div>

              <!-- Hotel Address -->
              <div class="mt-8 p-5 bg-blue-50 rounded-xl border border-blue-100">
                <div class="flex items-start gap-3 mb-3">
                  <svg class="w-5 h-5 text-blue-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <p class="font-bold text-gray-900">The Westin Zagreb</p>
                    <p class="text-gray-600 text-sm">Izidora Kršnjavoga 1, 10000 Zagreb, Croatia</p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-3 mt-4">
                  <a
                    href="https://maps.google.com/?q=The+Westin+Zagreb,+Izidora+Kršnjavoga+1,+Zagreb"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                    </svg>
                    Google Maps
                  </a>
                  <a
                    href="https://www.marriott.com/en-us/hotels/zagwi-the-westin-zagreb/overview/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-blue-700 border border-blue-200 text-sm font-medium px-4 py-2 rounded-lg transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Hotel website
                  </a>
                </div>
              </div>

              <!-- Hotel Features -->
              <div class="grid grid-cols-2 gap-3 mt-5">
                <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-100">
                  <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Conference Facilities</span>
                </div>
                <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-100">
                  <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Wellness & Spa</span>
                </div>
                <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-100">
                  <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">Premium Service</span>
                </div>
                <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-100">
                  <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-gray-700">City Centre Location</span>
                </div>
              </div>
            </div>
          </div>
        </Card>

      <!-- Getting Here CTA -->
      <div class="max-w-6xl mx-auto mt-6">
        <div class="rounded-2xl bg-gradient-to-r from-blue-700 to-blue-500 p-6 flex flex-col sm:flex-row items-center justify-between gap-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </div>
            <div>
              <p class="text-white font-bold text-lg leading-tight">Getting to Zagreb</p>
              <p class="text-blue-100 text-sm">Travel options: by air, car, bus and train — with links and tips</p>
            </div>
          </div>
          <a
            href="/information"
            class="flex-shrink-0 inline-flex items-center gap-2 bg-white text-blue-700 font-semibold px-5 py-2.5 rounded-xl hover:bg-blue-50 transition-colors text-sm"
          >
            Travel Information
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hotel image lightbox - opens on same page, user can close -->
  <div
    id="hotel-image-lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4 hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <div class="relative max-w-6xl max-h-[90vh] w-full flex items-center justify-center">
      <img
        id="hotel-lightbox-image"
        src=""
        alt="Hotel image"
        class="max-w-full max-h-[90vh] w-auto h-auto object-contain rounded-lg shadow-2xl"
      />
    </div>
    <button
      type="button"
      id="hotel-lightbox-close"
      class="fixed top-4 right-4 z-[60] flex items-center justify-center w-12 h-12 rounded-full bg-white/95 hover:bg-white text-gray-800 font-bold text-2xl transition-colors focus:outline-none focus:ring-2 focus:ring-white shadow-lg"
      aria-label="Close"
    >
      ×
    </button>
  </div>

  <!-- About Zagreb Section -->
  <section class="section-padding bg-[#f9fafb]">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-16 card-animate">
        <img src="/images/zagreb-logo.png" alt="Zagreb Logo" class="h-32 lg:h-40 w-auto mx-auto" />
      </div>

      <div class="space-y-8 max-w-6xl mx-auto">
        <!-- Zagreb Description -->
        <div class="card-animate rounded-2xl shadow-xl overflow-hidden bg-white border border-gray-100">
          <div class="relative">
            <div class="grid grid-cols-3 h-56 lg:h-72">
              <button type="button" class="hotel-image-link relative overflow-hidden cursor-zoom-in group p-0 bg-transparent border-0" data-src="/images/zagreb-city.jpg" aria-label="Zagreb tram">
                <img src="/images/zagreb-city.jpg" alt="Zagreb – tramvaj" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
              </button>
              <button type="button" class="hotel-image-link relative overflow-hidden cursor-zoom-in group p-0 bg-transparent border-0" data-src="/images/zagreb-funicular.jpg" aria-label="Funicular">
                <img src="/images/zagreb-funicular.jpg" alt="Zagreb – uspinjača" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
              </button>
              <button type="button" class="hotel-image-link relative overflow-hidden cursor-zoom-in group p-0 bg-transparent border-0" data-src="/images/zagreb-dolac.jpg" aria-label="Dolac market">
                <img src="/images/zagreb-dolac.jpg" alt="Zagreb – Dolac" class="w-full h-full object-cover transition duration-300 group-hover:brightness-75" />
              </button>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8 flex items-end gap-4">
              <svg class="w-10 h-10 text-red-500 flex-shrink-0 drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path>
              </svg>
              <h3 class="text-3xl lg:text-4xl font-bold text-white leading-tight drop-shadow-lg">Zagreb – City with a Million Hearts</h3>
            </div>
          </div>
          <div class="p-8 lg:p-10">
            <div class="space-y-5 text-base leading-relaxed text-gray-600">
              <p>
                <strong class="text-gray-900">Effervescent, avant-garde and always elegant</strong>, Zagreb embodies the grace and dignity of Old Europe, boasting a rich cultural heritage and artistic vibrancy unlike anywhere else in Croatia. A dynamic, yet unhurried metropolis and capital city, Zagreb's design beckons one to stroll, relax, and observe, with its many gardens, alfresco squares, landscaped promenades, and secret courtyards.
              </p>
              <p>
                Today, Zagreb's long history is evident in every structure and sidewalk, while its vibrant and cutting-edge art scene energizes contemporary society. The city is divided into three sections: <strong class="text-gray-900">Gornji Grad</strong> ("Upper Town") the historic centre, <strong class="text-gray-900">Donji Grad</strong> ("Lower Town") built mostly in the 19th century, and <strong class="text-gray-900">Novi Zagreb</strong> ("New Zagreb"), with the modern metropolis encircling the historic areas.
              </p>
            </div>
            <div class="mt-8 bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <h4 class="text-xl font-bold text-gray-900">Things to do</h4>
              </div>
              <p class="text-gray-600 text-base leading-relaxed mb-5">
                Ride the funicular, visit Zagreb's many colourful markets, embrace the cafe culture, shop for bespoken goods, visit one-of-a kind museums.
              </p>
              <div class="flex flex-wrap gap-3">
                <a href="https://www.infozagreb.hr/en/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#2a5298] hover:bg-[#1e3c72] px-5 py-2.5 rounded-xl text-white font-medium text-sm transition-colors">
                  Visit Zagreb info
                </a>
                <a href="https://www.infozagreb.hr/en/multimedia/brochures" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white border border-gray-200 hover:border-[#2a5298] hover:text-[#2a5298] px-5 py-2.5 rounded-xl text-gray-700 font-medium text-sm transition-colors">
                  Digital brochures & maps
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- In Zagreb + Weather grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- In Zagreb (ZET transport) -->
          <div class="bg-gray-100 rounded-2xl shadow-md border-t-4 border-t-red-500 border border-gray-200 p-6">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900">In Zagreb</h3>
            </div>
            <div class="space-y-5">
              <p class="text-gray-600 text-sm leading-relaxed">
                Zagreb's public transportation system is called <strong class="text-gray-900">ZET</strong> (Zagreb Electric Tram). Made up primarily of buses and trams, it also includes a cable car to Medvednica Mountain and a funicular to Gornji grad.
              </p>
              <div class="bg-white rounded-xl p-5 border border-gray-200">
                <div class="flex items-center gap-2 mb-3">
                  <svg class="w-5 h-5 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path>
                  </svg>
                  <h4 class="text-sm font-bold text-gray-900">Tickets & Information</h4>
                </div>
                <p class="text-gray-500 text-sm mb-3">Purchase tickets from driver, at kiosk, or via <strong class="text-gray-700">Moj ZET</strong> app.</p>
                <div class="flex flex-wrap gap-2">
                  <a href="https://www.zet.hr/home/581" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-[#2a5298] hover:bg-[#1e3c72] px-3 py-1.5 rounded-lg text-white font-medium text-xs transition-colors">ZET Homepage</a>
                  <a href="https://www.zet.hr/tickets-and-fares/fares/605" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-[#2a5298] hover:bg-[#1e3c72] px-3 py-1.5 rounded-lg text-white font-medium text-xs transition-colors">Fares & Tickets</a>
                </div>
              </div>
              <div class="border-t border-gray-200 pt-4">
                <p class="text-sm text-gray-900 font-bold mb-3">More information</p>
                <a href="https://www.meetinzagreb.hr/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#2a5298] hover:bg-[#1e3c72] px-4 py-2 rounded-lg text-white font-medium text-sm transition-colors">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  Meet in Zagreb
                </a>
              </div>
            </div>
          </div>

          <!-- Weather in Zagreb -->
          <div class="bg-gray-100 rounded-2xl shadow-md border-t-4 border-t-[#2a5298] border border-gray-200 p-6 lg:p-8">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 rounded-lg bg-[#2a5298]/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
