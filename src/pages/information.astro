---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import { Plane, Car, Bus, Train } from '@lucide/astro';
---

<Layout
  title="Practical Information | ICD 2027"
  description="Practical information for ICD 2027: visa, travel, accommodation, and useful links for participants in Zagreb."
>
  <Header />
  <HeroCountdown />

  <!-- Content: Visa, Getting to Zagreb, Accommodation link, Useful Information (from venue) -->
  <section class="section-padding bg-[#f9fafb] text-gray-900 font-medium">
    <div class="section-container">
      <div class="space-y-8 max-w-6xl mx-auto">
        <!-- Getting to Zagreb – copied from venue -->
        <div class="space-y-6">
          <h3 class="text-4xl font-bold text-gray-900 uppercase tracking-wide">Getting to Zagreb</h3>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- BY AIR – plava pozadina -->
            <div class="rounded-2xl shadow-lg hover:shadow-lg overflow-hidden no-card-hover border-0 bg-gradient-to-br from-blue-100 to-blue-200 transition-none transform-none hover:transform-none">
              <div class="p-8 text-gray-900">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl flex items-center justify-center shadow-lg flex-shrink-0">
                    <Plane class="w-7 h-7 text-white" />
                  </div>
                  <h4 class="text-3xl font-bold text-gray-900">BY AIR</h4>
                </div>
                <div class="space-y-4 text-gray-700">
                  <p class="text-base leading-relaxed">
                    Croatia's national air company is Croatia airlines with direct flights to major European cities: London, Amsterdam, Brussels, Paris, Frankfurt, Munich, Vienna, and many more.
                  </p>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <p class="font-bold text-gray-900 mb-2">Dr. Franjo Tuđman airport</p>
                    <p class="text-sm text-gray-600 mb-4">17 km from city centre (20-25 min by car)</p>
                    <div class="space-y-2">
                      <a href="https://www.zagreb-airport.hr/en" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#1e3c72] font-medium text-sm underline">
                        Airport website
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </a>
                      <br />
                      <a href="https://www.infozagreb.hr/travel-plan/arrival#by-plane" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#1e3c72] font-medium text-sm underline">
                        More info
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </a>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                      <p class="font-semibold text-gray-900 mb-2 text-sm">🚐 Shuttle bus</p>
                      <p class="text-xs text-gray-600 mb-2">Airport to bus station</p>
                      <a href="https://www.plesoprijevoz.hr/en/zagreb-croatia/" target="_blank" rel="noopener noreferrer" class="text-[#1e3c72] font-medium text-xs underline">Book shuttle</a>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                      <p class="font-semibold text-gray-900 mb-2 text-sm">🚕 Taxi</p>
                      <p class="text-xs text-gray-600 mb-2">Uber or:</p>
                      <div class="space-y-1 text-xs">
                        <a href="https://www.ekotaxi.hr/en" target="_blank" rel="noopener noreferrer" class="block text-[#1e3c72] font-medium underline">Eko taxi</a>
                        <a href="https://taxi1717.hr/en/" target="_blank" rel="noopener noreferrer" class="block text-[#1e3c72] font-medium underline">Taxi 1717</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- BY CAR – narančasta pozadina -->
            <div class="rounded-2xl shadow-lg hover:shadow-lg overflow-hidden no-card-hover border-0 bg-gradient-to-br from-orange-100 to-orange-200 transition-none transform-none hover:transform-none">
              <div class="p-8 text-gray-900">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-orange-700 rounded-xl flex items-center justify-center shadow-lg flex-shrink-0">
                    <Car class="w-7 h-7 text-white" />
                  </div>
                  <h4 class="text-3xl font-bold text-gray-900">BY CAR</h4>
                </div>
                <div class="space-y-4 text-gray-700">
                  <p class="text-base leading-relaxed">
                    Zagreb is perfectly positioned between Central and Southeastern Europe and the Adriatic Sea, providing easy access to all major Croatian cities and neighboring capitals.
                  </p>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <p class="font-bold text-gray-900 mb-3 text-sm">Major international routes:</p>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start gap-2"><span class="text-[#1e3c72] font-bold">•</span><span>Trieste - Ljubljana - Zagreb</span></li>
                      <li class="flex items-start gap-2"><span class="text-[#1e3c72] font-bold">•</span><span>Graz - Maribor - Zagreb</span></li>
                      <li class="flex items-start gap-2"><span class="text-[#1e3c72] font-bold">•</span><span>Klagenfurt - Ljubljana - Zagreb</span></li>
                      <li class="flex items-start gap-2"><span class="text-[#1e3c72] font-bold">•</span><span>Budapest - Varaždin - Zagreb</span></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
            <!-- BY BUS – ljubičasta pozadina -->
            <div class="rounded-2xl shadow-lg hover:shadow-lg overflow-hidden no-card-hover border-0 bg-gradient-to-br from-purple-100 to-purple-200 transition-none transform-none hover:transform-none">
              <div class="p-8 text-gray-900">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center shadow-lg flex-shrink-0">
                    <Bus class="w-7 h-7 text-white" />
                  </div>
                  <h4 class="text-3xl font-bold text-gray-900">BY BUS</h4>
                </div>
                <div class="space-y-4 text-gray-700">
                  <p class="text-base leading-relaxed">
                    Zagreb main bus station (Autobusni kolodvor, Avenija Marina Držića 4) connects Zagreb with numerous cities in Croatia and Europe on daily basis.
                  </p>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <p class="font-bold text-gray-900 mb-3">Bus Station Information</p>
                    <a href="https://www.akz.hr/en" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#1e3c72] font-medium underline">
                      www.akz.hr/en
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <!-- BY TRAIN – zelena pozadina -->
            <div class="rounded-2xl shadow-lg hover:shadow-lg overflow-hidden no-card-hover border-0 bg-gradient-to-br from-green-100 to-green-200 transition-none transform-none hover:transform-none">
              <div class="p-8 text-gray-900">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center shadow-lg flex-shrink-0">
                    <Train class="w-7 h-7 text-white" />
                  </div>
                  <h4 class="text-3xl font-bold text-gray-900">BY TRAIN</h4>
                </div>
                <div class="space-y-4 text-gray-700">
                  <p class="text-base leading-relaxed">
                    Zagreb Main Train Station (Glavni kolodvor, Trg kralja Tomislava 12) and Croatian Railways offer cheap connections to main Croatian cities and neighboring countries.
                  </p>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <p class="font-bold text-gray-900 mb-3">Train Station Information</p>
                    <a href="https://hzpp.hr/en" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#1e3c72] font-medium underline">
                      https://hzpp.hr/en
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Useful Information – copied from venue -->
        <div class="space-y-6">
          <h3 class="text-4xl font-bold text-gray-900 uppercase tracking-wide">Useful Information</h3>
          <!-- Useful Information – svijetlo siva pozadina -->
          <div class="rounded-2xl shadow-lg hover:shadow-lg overflow-hidden no-card-hover border-0 bg-gradient-to-br from-gray-100 to-gray-200 transition-none transform-none hover:transform-none">
            <div class="p-8 lg:p-10 text-gray-900">
              <div class="space-y-6">
                <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
                  <h4 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b-2 border-gray-200">General information</h4>
                  <div class="space-y-4 pt-2 text-gray-700">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide">Visa and confirmation letter</h5>
                    <p class="text-base leading-relaxed mb-2">
                      Please make sure you have the necessary valid documents to enter Croatia.
                      If you're citizen of an EU member country you only need your ID. Otherwise, you will need a valid passport.
                    </p>
                    <p class="text-base leading-relaxed mb-2">
                      It is the sole responsibility of the attendee to take care of their visa requirements. For more information please check: <a href="https://mvep.gov.hr/en" target="_blank" rel="noopener noreferrer" class="text-[#1e3c72] font-medium underline">https://mvep.gov.hr/en</a>
                    </p>
                    <p class="text-base leading-relaxed mb-2">
                      An official confirmation / invitation letter can be sent upon request to <a href="mailto:11icd2027@gmail.com" class="text-[#1e3c72] font-medium underline">11icd2027@gmail.com</a> only for participants who have registered, paid the registration fee, and submitted an abstract that was not rejected. It does not cover any fees, nor is a guarantee to obtain the visa.
                    </p>
                    <p class="text-base leading-relaxed">
                      Participants should make their own arrangements with respect to health and travel insurance.
                    </p>
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">GSM Operators</h5>
                    <p class="text-sm leading-relaxed text-gray-700">
                      Currently, there are five GSM operators offering the GSM service in Croatia. Please contact your local GSM operator to check the availability and the costs of roaming services.
                    </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Useful telephone numbers</h5>
                    <p class="text-sm leading-relaxed text-gray-700 mb-1">Country code: (+/00) 385 · Area code (Zagreb): (0)1</p>
                    <p class="text-sm leading-relaxed text-gray-700">General emergency: 112 · Police: 192 · Fire: 193 · Emergency: 194</p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Opening hours</h5>
                    <p class="text-sm leading-relaxed text-gray-700">
                      Banks and post offices are normally open from 8:00 or 19:30. Most grocery stores and department stores are open non-stop, from 6:00 to 20:00.
                    </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Currency & exchange</h5>
                    <p class="text-sm leading-relaxed text-gray-700">
                      The basic Croatian currency unit is the Euro. Foreign currency can be exchanged at banks, post offices, and exchange offices. Visit the exchange office on the Web for valid exchange rates.
                    </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Credit cards</h5>
                    <p class="text-sm leading-relaxed text-gray-700">
                      All major credit cards are normally accepted (Visa, Mastercard, Maestro, Diners Club), as advertised at points of sale.
                    </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Electricity</h5>
                    <p class="text-sm leading-relaxed text-gray-700">220 V, 50 Hz</p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Time zone</h5>
                    <p class="text-sm leading-relaxed text-gray-700">Central European Time (CET).</p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Water</h5>
                    <p class="text-sm leading-relaxed text-gray-700">Tap water is drinkable in all parts of Croatia.</p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 md:col-span-2">
                    <h5 class="font-bold text-gray-900 mb-2 text-sm uppercase tracking-wide border-l-4 border-teal-500 pl-3">Customs</h5>
                    <p class="text-sm leading-relaxed text-gray-700">
                      Customs Administration of the Republic of Croatia: <a href="https://carina.gov.hr" target="_blank" rel="noopener noreferrer" class="text-[#1e3c72] font-medium underline">carina.gov.hr</a>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
