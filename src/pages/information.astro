---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import { Plane, Car, Bus, Train } from '@lucide/astro';
---

<Layout
  title="General Information | ICD 2027"
  description="General information for ICD 2027: visa, travel, collecting permits for Diptera, and useful links for participants in Zagreb."
>
  <Header />
  <HeroCountdown />

  <main class="bg-slate-50/80 pb-20 pt-10 lg:pb-28 lg:pt-14">
    <!-- Page intro + anchor nav -->
    <section class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="home-title text-[#1e3c72]">General information</h1>
        <p class="home-subtitle mb-10">
          Visa, travel, collecting permits, and practical details for your stay
          in Zagreb.
        </p>
        <nav
          class="flex flex-wrap items-center justify-center gap-2 border-y border-slate-200/80 py-4 text-sm"
          aria-label="Page sections"
        >
          <a
            href="#visa"
            class="rounded-lg px-3 py-2 font-medium text-slate-600 transition hover:bg-white hover:text-[#2a5298]"
            >Visa & entry</a
          >
          <span class="text-slate-300" aria-hidden="true">·</span>
          <a
            href="#travel"
            class="rounded-lg px-3 py-2 font-medium text-slate-600 transition hover:bg-white hover:text-[#2a5298]"
            >Getting to Zagreb</a
          >
          <span class="text-slate-300" aria-hidden="true">·</span>
          <a
            href="#collecting-permits"
            class="rounded-lg px-3 py-2 font-medium text-slate-600 transition hover:bg-white hover:text-[#2a5298]"
            >Collecting permits</a
          >
          <span class="text-slate-300" aria-hidden="true">·</span>
          <a
            href="#useful"
            class="rounded-lg px-3 py-2 font-medium text-slate-600 transition hover:bg-white hover:text-[#2a5298]"
            >Useful info</a
          >
        </nav>
      </div>
    </section>

    <!-- Visa & Entry -->
    <section id="visa" class="section-container section-padding !pt-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="sr-only">Visa & entry requirements</h2>
        <div
          class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm"
        >
          <div
            class="border-b border-slate-100 bg-gradient-to-r from-[#1e3c72] to-[#2a5298] px-6 py-5 sm:px-8"
          >
            <p
              class="text-xs font-semibold uppercase tracking-wider text-white/95"
            >
              Visa & entry
            </p>
            <p class="mt-1 text-sm text-white/75">
              Check requirements before you travel.
            </p>
          </div>
          <div class="space-y-6 px-6 py-6 sm:px-8 sm:py-8">
            <div class="grid gap-4 sm:grid-cols-2">
              <div
                class="rounded-2xl border border-emerald-200/80 bg-emerald-50/50 p-4"
              >
                <p class="text-sm font-semibold text-emerald-900">EU citizens</p>
                <p class="mt-1 text-sm leading-relaxed text-emerald-900/80">
                  A valid national ID card is sufficient to enter Croatia.
                </p>
              </div>
              <div
                class="rounded-2xl border border-sky-200/80 bg-sky-50/50 p-4"
              >
                <p class="text-sm font-semibold text-sky-950">
                  Non-EU citizens
                </p>
                <p class="mt-1 text-sm leading-relaxed text-sky-900/85">
                  A valid passport is required. Check visa requirements at
                  <a
                    href="https://mvep.gov.hr/en"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-[#2a5298] underline decoration-primary-600/25 underline-offset-2 hover:decoration-primary-600"
                    >mvep.gov.hr/en</a
                  >
                </p>
              </div>
            </div>

            <div
              class="rounded-2xl border border-blue-100 border-l-4 border-l-[#2a5298] bg-gradient-to-r from-blue-50/60 to-slate-50/40 px-4 py-4 sm:px-5"
            >
              <p class="text-sm font-semibold text-slate-900">
                Invitation / confirmation letter
              </p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">
                An official letter can be requested at
                <a
                  href="mailto:11icd2027@gmail.com"
                  class="font-semibold text-[#2a5298] underline decoration-primary-600/25 underline-offset-2"
                  >11icd2027@gmail.com</a
                >
                — for registered participants who have paid and submitted an
                abstract that was not rejected. The letter does not cover fees
                and does not guarantee a visa.
              </p>
            </div>

            <p class="text-xs italic text-slate-500">
              Arrange your own health and travel insurance.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Getting to Zagreb -->
    <section id="travel" class="section-container section-padding !pt-0">
      <div class="mx-auto max-w-5xl">
        <div class="home-section-header">
          <h2 class="home-title text-[#1e3c72]">Getting to Zagreb</h2>
          <p class="home-subtitle">
            Zagreb is well connected to the rest of Europe by air, road, bus,
            and rail.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <!-- By Air -->
          <article
            class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-gradient-to-b from-sky-50/50 to-white shadow-sm"
          >
            <div class="h-1.5 bg-gradient-to-r from-sky-400 to-blue-600"></div>
            <div class="flex flex-col p-6 sm:p-7">
            <div
              class="mb-5 flex items-center gap-3 border-b border-sky-100/80 pb-4"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-700"
              >
                <Plane class="h-5 w-5" stroke-width={1.75} />
              </span>
              <h3 class="text-lg font-bold text-sky-950">By air</h3>
            </div>
            <p class="text-sm leading-relaxed text-sky-900/80">
              Croatia Airlines and other carriers offer connections to major
              European cities: London, Amsterdam, Brussels, Paris, Frankfurt,
              Munich, Vienna, and more.
            </p>
            <div
              class="mt-5 rounded-2xl border border-sky-100 bg-sky-50/60 p-4"
            >
              <div class="mb-2 flex flex-wrap items-start justify-between gap-2">
                <p class="text-sm font-semibold text-sky-950">
                  Dr. Franjo Tuđman Airport
                </p>
                <span
                  class="rounded-md bg-sky-200/90 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-900"
                  >ZAG</span
                >
              </div>
              <p class="text-xs text-sky-800/70">
                ~17 km from the centre (about 20–25 min by car)
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <a
                  href="https://www.zagreb-airport.hr/en"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-lg border border-sky-200/80 bg-white px-3 py-1.5 text-xs font-semibold text-sky-800 transition hover:border-sky-400"
                  >Airport website</a
                >
                <a
                  href="https://www.infozagreb.hr/travel-plan/arrival#by-plane"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-lg border border-sky-200/80 bg-white px-3 py-1.5 text-xs font-semibold text-sky-800 transition hover:border-sky-400"
                  >Visitor info</a
                >
              </div>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-xl border border-sky-100/90 bg-white/80 p-3">
                <p class="text-sm font-semibold text-sky-950">Shuttle</p>
                <p class="mt-0.5 text-xs text-sky-800/70">Airport ↔ bus station</p>
                <a
                  href="https://www.plesoprijevoz.hr/en/zagreb-croatia/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block text-xs font-semibold text-sky-800"
                  >Book shuttle</a
                >
              </div>
              <div class="rounded-xl border border-sky-100/90 bg-white/80 p-3">
                <p class="text-sm font-semibold text-sky-950">Taxi</p>
                <p class="mt-0.5 text-xs text-sky-800/70">Uber or local</p>
                <div class="mt-2 space-y-1 text-xs font-semibold">
                  <a
                    href="https://www.ekotaxi.hr/en"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-sky-800"
                    >Eko taxi</a
                  >
                  <a
                    href="https://taxi1717.hr/en/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-sky-800"
                    >Taxi 1717</a
                  >
                </div>
              </div>
            </div>
            </div>
          </article>

          <!-- By Car -->
          <article
            class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-gradient-to-b from-emerald-50/40 to-white shadow-sm"
          >
            <div class="h-1.5 bg-gradient-to-r from-emerald-400 to-teal-600"></div>
            <div class="flex flex-col p-6 sm:p-7">
            <div
              class="mb-5 flex items-center gap-3 border-b border-emerald-100/80 pb-4"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800"
              >
                <Car class="h-5 w-5" stroke-width={1.75} />
              </span>
              <h3 class="text-lg font-bold text-emerald-950">By car</h3>
            </div>
            <p class="text-sm leading-relaxed text-emerald-950/80">
              Zagreb lies between Central and South-Eastern Europe and the
              Adriatic, with good road links across Croatia and to neighbouring
              capitals.
            </p>
            <div
              class="mt-5 rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4"
            >
              <p class="mb-3 text-sm font-semibold text-emerald-950">
                Major international routes
              </p>
              <ul class="space-y-2 text-sm text-emerald-900/80">
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500"
                  ></span>
                  Trieste – Ljubljana – Zagreb
                </li>
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500"
                  ></span>
                  Graz – Maribor – Zagreb
                </li>
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500"
                  ></span>
                  Klagenfurt – Ljubljana – Zagreb
                </li>
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500"
                  ></span>
                  Budapest – Varaždin – Zagreb
                </li>
              </ul>
            </div>
            </div>
          </article>

          <!-- By Bus -->
          <article
            class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-gradient-to-b from-violet-50/40 to-white shadow-sm"
          >
            <div class="h-1.5 bg-gradient-to-r from-violet-400 to-purple-600"></div>
            <div class="flex flex-col p-6 sm:p-7">
            <div
              class="mb-5 flex items-center gap-3 border-b border-violet-100/80 pb-4"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 text-violet-800"
              >
                <Bus class="h-5 w-5" stroke-width={1.75} />
              </span>
              <h3 class="text-lg font-bold text-violet-950">By bus</h3>
            </div>
            <p class="text-sm leading-relaxed text-violet-950/80">
              Main bus station (Autobusni kolodvor, Avenija Marina Držića 4)
              connects Zagreb with cities across Croatia and Europe daily.
            </p>
            <div
              class="mt-5 rounded-2xl border border-violet-100 bg-violet-50/50 p-4"
            >
              <p class="text-sm font-semibold text-violet-950">
                Bus station
              </p>
              <p class="mt-0.5 text-xs text-violet-800/70">Avenija Marina Držića 4</p>
              <a
                href="https://www.akz.hr/en"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1 rounded-lg border border-violet-200/80 bg-white px-3 py-1.5 text-xs font-semibold text-violet-900 transition hover:border-violet-400"
                >www.akz.hr/en</a
              >
            </div>
            </div>
          </article>

          <!-- By Train -->
          <article
            class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-gradient-to-b from-amber-50/50 to-white shadow-sm"
          >
            <div class="h-1.5 bg-gradient-to-r from-amber-400 to-orange-500"></div>
            <div class="flex flex-col p-6 sm:p-7">
            <div
              class="mb-5 flex items-center gap-3 border-b border-amber-100/80 pb-4"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-amber-900"
              >
                <Train class="h-5 w-5" stroke-width={1.75} />
              </span>
              <h3 class="text-lg font-bold text-amber-950">By train</h3>
            </div>
            <p class="text-sm leading-relaxed text-amber-950/80">
              Zagreb Glavni kolodvor (Trg kralja Tomislava 12) and HZPP offer
              connections across Croatia and to neighbouring countries.
            </p>
            <div
              class="mt-5 rounded-2xl border border-amber-100 bg-amber-50/60 p-4"
            >
              <p class="text-sm font-semibold text-amber-950">
                Train station
              </p>
              <p class="mt-0.5 text-xs text-amber-900/70">Trg kralja Tomislava 12</p>
              <a
                href="https://hzpp.hr/en"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1 rounded-lg border border-amber-200/80 bg-white px-3 py-1.5 text-xs font-semibold text-amber-900 transition hover:border-amber-400"
                >www.hzpp.hr</a
              >
            </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Collecting permits for Diptera -->
    <section
      id="collecting-permits"
      class="section-container section-padding !pt-0"
    >
      <div class="mx-auto max-w-3xl">
        <div class="home-section-header !mb-8 text-center sm:text-left">
          <h2 class="home-title text-[#1e3c72]">Collecting permits for Diptera</h2>
          <p class="home-subtitle">
            What you need to know before sampling in Croatia.
          </p>
        </div>

        <div class="space-y-5">
          <!-- Overview -->
          <div
            class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm"
          >
            <div
              class="border-b border-slate-100 bg-gradient-to-r from-[#1e3c72] to-[#2a5298] px-6 py-5 sm:px-8"
            >
              <p
                class="text-xs font-semibold uppercase tracking-wider text-white/95"
              >
                Legal overview
              </p>
              <p class="mt-1 text-sm text-white/75">
                Regulation on Strictly Protected Species
              </p>
            </div>
            <div class="space-y-5 px-6 py-6 sm:px-8 sm:py-8">
              <p class="text-sm leading-relaxed text-slate-600">
                There are no specifically named (nominal) dipteran species on
                the list of strictly protected insects in Croatia. Instead,
                collective protection is applied through ecological systems and
                speleological sites.
              </p>

              <div class="grid gap-4 sm:grid-cols-2">
                <div
                  class="relative overflow-hidden rounded-2xl border border-emerald-200/90 bg-emerald-50/60 p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800"
                    aria-hidden="true"
                  >
                    <svg
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                  </div>
                  <p
                    class="text-xs font-semibold uppercase tracking-wider text-emerald-800/80"
                  >
                    No permit needed
                  </p>
                  <p class="mt-1.5 text-sm font-semibold text-emerald-950">
                    Outside protected areas
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-emerald-900/80">
                    If you are not planning to collect Diptera in protected
                    areas, you do not need any permits.
                  </p>
                </div>

                <div
                  class="relative overflow-hidden rounded-2xl border border-amber-200/90 bg-amber-50/60 p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-800"
                    aria-hidden="true"
                  >
                    <svg
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                      ></path>
                    </svg>
                  </div>
                  <p
                    class="text-xs font-semibold uppercase tracking-wider text-amber-800/80"
                  >
                    Permit required
                  </p>
                  <p class="mt-1.5 text-sm font-semibold text-amber-950">
                    Inside protected areas
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-amber-950/80">
                    Scientific and/or professional research on natural
                    components within a protected area requires an official
                    permit.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Application checklist -->
          <div
            class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm"
          >
            <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
              <h3 class="text-base font-bold text-slate-900">
                What your permit application must include
              </h3>
              <p class="mt-1 text-sm text-slate-500">
                Provide all of the following when applying for research in a
                protected area.
              </p>
            </div>
            <div class="px-6 py-6 sm:px-8 sm:py-7">
              <ol class="grid gap-3 sm:grid-cols-2">
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >1</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >The party conducting the research</span
                  >
                </li>
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >2</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >The research location</span
                  >
                </li>
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >3</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >The purpose of the research</span
                  >
                </li>
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >4</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >Duration and timing of the research</span
                  >
                </li>
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >5</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >The research methodology</span
                  >
                </li>
                <li
                  class="flex gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5"
                >
                  <span
                    class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[#1e3c72] text-xs font-bold text-white"
                    >6</span
                  >
                  <span class="text-sm leading-snug text-slate-700"
                    >Equipment, tools, machinery, etc. used</span
                  >
                </li>
              </ol>
            </div>
          </div>

          <!-- Who issues permits -->
          <div
            class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm"
          >
            <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
              <h3 class="text-base font-bold text-slate-900">
                Who issues the permit
              </h3>
              <p class="mt-1 text-sm text-slate-500">
                Depends on the type of protected area.
              </p>
            </div>
            <div class="grid gap-0 sm:grid-cols-2">
              <div
                class="border-b border-slate-100 p-5 sm:border-b-0 sm:border-r sm:p-6"
              >
                <p
                  class="text-xs font-semibold uppercase tracking-wider text-[#2a5298]"
                >
                  Ministry
                </p>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">
                  Strict reserves, national parks, special reserves, and nature
                  parks.
                </p>
              </div>
              <div class="p-5 sm:p-6">
                <p
                  class="text-xs font-semibold uppercase tracking-wider text-[#2a5298]"
                >
                  Administrative body
                </p>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">
                  Natural monuments, regional parks, significant landscapes,
                  forest parks, and monuments of park architecture.
                </p>
              </div>
            </div>
          </div>

          <!-- Resources -->
          <div class="grid gap-3 sm:grid-cols-2">
            <a
              href="https://bioportal.hr/gis/"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-4 overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm transition hover:border-[#2a5298]/35 hover:shadow-md"
            >
              <span
                class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-800 transition group-hover:bg-[#1e3c72] group-hover:text-white"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.75"
