---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';

const plenaryLecturers = [
  {
    name: 'Amrita Srivathsan',
    role: '',
    institution: 'Museum für Naturkunde Berlin, Germany',
    image: '/images/amrita-srivathsan.jpg',
    bio: 'Dr Amrita Srivathsan is a scientist at the Museum für Naturkunde Berlin\'s Center for Integrative Biodiversity Discovery. Her research focuses on enabling species discovery and understanding species interactions, particularly in hyperdiverse and understudied dark taxa. Her work centers on developing tools and workflows that support molecular approaches to biodiversity research. She developed ONTbarcoder, a tool for real-time DNA barcoding using nanopore sequencing data, and IntegraTax, which supports the clustering and annotation of barcode datasets to facilitate taxonomic projects at both small and large scales. She has also contributed workflows for iDNA-based vertebrate monitoring, using fly-derived DNA to study ecological interactions. Across these areas, her work focuses on developing low-cost molecular approaches and analytical tools that lower practical barriers to applying molecular methods in biodiversity research, alongside empirical studies of species interactions using molecular data. Amrita holds a Bachelor\'s degree from the National University of Singapore and a PhD from the joint National University of Singapore-Imperial College London PhD program.',
  },
  {
    name: 'Art Borkent',
    role: '',
    institution: 'Independent Researcher, Canada',
    image: '/images/art-borkent.jpg',
    bio: 'Art Borkent entered the Department of Entomology at the University of Alberta (Canada) at the age of 16. He did his B.Sc. and M.Sc. there and then on to Ottawa for his Ph.D. (supervised by Monty Wood), followed by 8 years as a research scientist in Ottawa at the CNC. In 1989 he started working independently, through the support of his wife Annette Borkent, allowing a great deal of freedom. He has published on all 8 families of the Culicomorpha as well as the phylogenetic relationships between nematocerous families. Most of the past 40 years have focused particularly on Ceratopogonidae, the biting midges. Studies have included numbers of revisions, reclassification of the family based on phylogenetic relationships of the 109 genera, the first detailed description and keys to the genera of pupae, along with studies of their amazing fossil record going back to the early Cretaceous. A lovely diversion into the world of frog biting midges (Corethrellidae) led to a world revision of all species; the 456 page publication was recognized with the 2010 Westwood award. He has now published over 5,300 pages of science.',
  },
  {
    name: 'Andrzej Grzywacz',
    role: '',
    institution: 'Nicolaus Copernicus University, Toruń, Poland',
    image: '/images/andrzej-grzywacz.jpg',
    bio: 'Dr Andrzej Grzywacz earned his MSc and PhD at Nicolaus Copernicus University in Toruń, Poland, where he works since 2013 in the Department of Ecology and Biogeography, currently as an Assistant Professor. From the very beginning of his interest in entomology, his research has been driven by the application of carrion-breeding flies in forensic investigations, with a strong focus on developing tools for species identification and their application into medico-legal practice. He has also been actively involved in the co-organization of international training workshops dedicated to the identification of forensically important Diptera. Throughout his academic career, Andrzej has specialized in the morphology of immature stages, initially concentrating on Muscidae and later expanding his work to explore the diversity of preimaginal stages across multiple dipteran families. His current research focuses on natural history, taxonomy, and evolutionary biology of calyptrate Diptera, combining detailed morphological studies of larvae and adults with genomic approaches to resolve phylogenetic relationships and improve systematics.',
  },
  {
    name: 'Snežana Radenković',
    role: '',
    institution: 'University of Novi Sad, Serbia',
    image: '/images/snezana-radenkovic.jpg',
    bio: 'Snežana Radenković is Full Professor at Department of Biology and Ecology, Faculty of Sciences, University of Novi Sad. Teaching experience includes Zoology of Invertebrates, Entomology, Animal Taxonomy and Invertebrate Conservation. Her research is focused on taxonomy and systematics of hoverflies, as well as on faunal investigations of Mediterranean Basin, including zoogeographical analysis and conservation planning for rare and endemic species. Of her special interest are phytophagous genera (Merodon, Eumerus and Cheilosia), resolving of taxonomical problems and systematic positions. She has contributed to about 70 publications. She has been Principal investigator of the national project Serbian Pollinator Advice Strategy (SPAS), and participated in several European projects related to pollinators: SAFEGUARD, TAXO-FLY, SPRING, FlyHigh, and STEP. She was also Species Assessor of the IUCN SSC Hoverfly Specialist Group in the European Red List of Hoverflies.',
  },
  {
    name: 'Viktor Baranov',
    role: '',
    institution: 'Estación Biológica de Doñana (CSIC), Seville, Spain',
    image: '/images/viktor-baranov.jpg',
    bio: 'Viktor Baranov is an entomologist and evolutionary ecologist whose research focuses on freshwater insects, Diptera, and long-term ecological change. He began his scientific career in 2012 at the Institute of Zoology of the National Academy of Sciences of Ukraine (Kyiv). He earned a Doctoral degree from the Leibniz Institute of Freshwater Ecology and Inland Fisheries and Humboldt University of Berlin. His doctoral research addressed the ecological functions of dipteran larvae in lake sediments. Following his PhD, Dr. Baranov held postdoctoral positions at the Senckenberg Research Institute and subsequently at Ludwig Maximilian University of Munich. His widely cited 2020 Conservation Biology paper demonstrated complex, nonlinear climate-driven restructuring of freshwater insect communities over four decades, representing a benchmark study for understanding biodiversity responses to climate change. Dr. Baranov is currently a Ramón y Cajal tenure-track fellow at the Estación Biológica de Doñana (CSIC) in Seville, Spain, where he leads a research group focused on the palaeoecology of true flies (Diptera).',
  },
];

const symposia = [
  { title: 'Acalyptratae', convenor: 'Keith Bayless' },
  { title: 'Advances in Afrotropical Dipterology', convenor: 'Ashley Kirk-Spriggs & Bradley J. Sinclair' },
  { title: 'Applied Dipterology', convenor: 'Jade Savage' },
  { title: 'Biodiversity surveys and conservation', convenor: 'Marc Pollet' },
  { title: 'Calyptrate systematics and diversity', convenor: 'Daniel Whitmore' },
  { title: 'Culicomorpha', convenor: 'John Kevin Moulton' },
  { title: 'Empidoidea', convenor: 'Bradley J. Sinclair & Marija Ivković' },
  { title: 'Lower Cyclorrhapha', convenor: 'Ximo Mengual' },
  { title: 'Psychodomorpha', convenor: 'Gunnar M. Kvifte' },
  {
    title: 'Tipulomorpha & Ptychopteromorpha',
    convenor: 'Levente-Péter Kolcsár & Pavel Starkevič',
  },
  {
    title: 'Integrative taxonomy and vertical stratification of the fly fauna',
    convenor: 'Dalton de Souza Amorim',
  },
  { title: 'Deep time Dipterology', convenor: 'Agnieszka Soszyńska & Vladimir Blagoderov' },
  { title: 'Phylogenomics', convenor: 'Paula Riccardi' },
  {
    title: 'Taxonomy and ecology of lower Brachycera',
    convenor: 'Martin Hauser',
  },
  {
    title: 'Diptera in Forensic Entomology',
    convenor: 'Krzysztof Szpila',
  },
  {
    title: 'Medical and Veterinary Diptera',
    convenor: 'Tamara Szentiványi & Miguel Ángel Miranda Chueca',
  },
  {
    title: 'Advances in Automated Diptera Identification and Monitoring',
    convenor: 'Xuankun Li & Emily Hartop',
  },
];
---

<Layout
  title="Program | ICD 2027"
  description="Congress program: scientific sessions, workshops, field excursion, and social events for ICD 2027 in Zagreb."
>
  <Header />

  <HeroCountdown />

  <!-- Plenary Lectures -->
  <section class="section-padding bg-[#f9fafb]">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
          <div class="w-14 h-14 rounded-2xl bg-[#2a5298]/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#2a5298] mb-3">Plenary Lectures</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mx-auto">
          {plenaryLecturers.map((member, i) => (
            <button
              type="button"
              class="member-card bg-white rounded-2xl shadow-md overflow-hidden border-t-4 border-t-[#2a5298] border border-gray-100 text-center cursor-pointer p-0 w-full group"
              data-index={`pl-${i}`}
              aria-label={`View bio of ${member.name}`}
            >
              <div class="pt-6 pb-2 flex justify-center">
                <img src={member.image} alt={member.name} class="w-32 h-32 lg:w-36 lg:h-36 rounded-full object-cover object-center shadow-xl" />
              </div>
              <div class="px-4 pb-5 pt-2">
                <h3 class="font-bold text-gray-900 text-base mb-1">{member.name}</h3>
                {member.role && <p class="text-sm text-[#2a5298] font-medium mb-2">{member.role}</p>}
                <p class="text-sm text-gray-500 leading-relaxed">{member.institution}</p>
                {member.bio && (
                  <span class="inline-flex items-center gap-1.5 mt-4 text-xs text-white font-medium bg-[#2a5298] group-hover:bg-[#1e3c72] px-4 py-2 rounded-full transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Read bio
                  </span>
                )}
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Program Section -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">

        <!-- Header -->
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-4">Program</h2>
          
        </div>

        <!-- Coming Soon notice -->
        <div class="flex items-start gap-4 bg-blue-50 border border-blue-200 rounded-2xl px-6 py-5 mb-10">
          <svg class="w-6 h-6 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-blue-800 text-sm leading-relaxed">
            The detailed scientific program is currently being prepared. The overview below shows the daily structure of the congress. Full session schedules, speaker lists and abstracts will be published closer to the event.
          </p>
        </div>

        <!-- Timeline -->
        <div class="relative">
          <!-- Vertical line -->
          <div class="absolute left-[2.75rem] top-0 bottom-0 w-0.5 bg-gray-200 hidden sm:block"></div>

          <div class="space-y-4">

            <!-- Day 1 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#2a5298] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Sun</div>
                  <div class="text-2xl font-bold leading-none">11</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2a5298]/10 text-[#2a5298] px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    Registration
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-amber-50 text-amber-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                    Opening
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Registration &amp; Opening Ceremony</h3>
                <p class="text-gray-500 text-sm mt-1">Participant check-in and official opening of the 11th International Congress of Dipterology.</p>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#1565c0] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Mon</div>
                  <div class="text-2xl font-bold leading-none">12</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                    </svg>
                    Scientific Sessions
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-teal-50 text-teal-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    City Tour
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Scientific Sessions &amp; City Tour</h3>
                <p class="text-gray-500 text-sm mt-1">Morning and afternoon scientific sessions followed by a guided tour of Zagreb's historic city centre.</p>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#1565c0] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Tue</div>
                  <div class="text-2xl font-bold leading-none">13</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                    </svg>
                    Scientific Sessions
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Scientific Sessions</h3>
                <p class="text-gray-500 text-sm mt-1">Full day of scientific sessions and presentations.</p>
              </div>
            </div>

            <!-- Day 4 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#1565c0] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Wed</div>
                  <div class="text-2xl font-bold leading-none">14</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                    </svg>
                    Scientific Sessions
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-purple-50 text-purple-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18z" />
                    </svg>
                    Congress Dinner
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Scientific Sessions &amp; Congress Dinner</h3>
                <p class="text-gray-500 text-sm mt-1">Scientific sessions throughout the day, followed by the official Congress Dinner in the evening.</p>
              </div>
            </div>

            <!-- Day 5 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#1565c0] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Thu</div>
                  <div class="text-2xl font-bold leading-none">15</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                    </svg>
                    Scientific Sessions
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Scientific Sessions</h3>
                <p class="text-gray-500 text-sm mt-1">Full day of scientific sessions and presentations.</p>
              </div>
            </div>

            <!-- Day 6 -->
            <div class="flex gap-5 items-start group">
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-22 sm:w-24 bg-[#2a5298] text-white rounded-xl px-3 py-3 text-center shadow-md z-10">
                  <div class="text-xs font-semibold uppercase tracking-wider opacity-80">Fri</div>
                  <div class="text-2xl font-bold leading-none">16</div>
                  <div class="text-xs font-medium opacity-80">Jul</div>
                </div>
              </div>
              <div class="flex-1 bg-white border border-gray-100 rounded-2xl shadow-sm p-5">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                    </svg>
                    Scientific Sessions
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2a5298]/10 text-[#2a5298] px-3 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                    Closing
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Scientific Sessions &amp; Closing Ceremony</h3>
                <p class="text-gray-500 text-sm mt-1">Final scientific sessions and the official closing ceremony of ICD 2027.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Bottom notice -->
        <p class="text-center text-gray-400 text-sm mt-10">
          Detailed session schedules and speaker information will be added as the program is finalised.
        </p>

      </div>
    </div>
  </section>

  <!-- Symposia -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <div class="w-14 h-14 rounded-2xl bg-teal-500/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#2a5298] mb-3">Symposia</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {symposia.map((s, i) => (
            <div class="relative bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden group hover:shadow-md hover:border-[#2a5298]/30 transition-all duration-300">
              <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-[#1e3c72] to-[#2a5298]"></div>
              <div class="pl-6 pr-5 py-5">
                <div class="flex items-center gap-2.5 mb-1.5">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[#2a5298]/10 text-[#2a5298] text-[10px] font-bold flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="font-semibold text-gray-900 text-sm leading-snug">{s.title}</h3>
                </div>
                <div class="flex items-center gap-2 ml-[34px]">
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                  <p class="text-sm text-gray-500">{s.convenor}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Symposium Guidelines -->
  <section class="section-padding bg-[#f9fafb]">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <div class="w-14 h-14 rounded-2xl bg-amber-500/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#2a5298] mb-3">Symposium Guidelines</h2>
        </div>

        <div class="space-y-6">
          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
            <p class="text-gray-700 leading-relaxed">
              The ICD<span class="font-semibold">XI</span> Organizing Committee now invites potential symposia organizers (hereafter termed convenors) to submit titles for symposia to be included on this website. Symposia may have one or more convenors. Note that delegates must cover their own costs and this invitation to organize a symposium does not represent an offer of funding to attend.
            </p>
            <p class="text-gray-700 leading-relaxed mt-4">
              The scope of this Congress will support symposia dealing with all aspects of dipterology and representing all regions of the world, with no specific overall theme or focus. Dipterology is a very diverse field, and we are hopeful for a diverse array of symposia.
            </p>
          </div>

          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="bg-gradient-to-r from-[#1e3c72] to-[#2a5298] px-6 py-4">
              <h3 class="text-lg font-bold text-white flex items-center gap-2.5">
                <svg class="w-5 h-5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                Responsibilities of Symposia Convenors
              </h3>
            </div>
            <div class="px-6 py-5">
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Contact potential contributors and solicit speakers, acting as the primary contact person for your symposium</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Selection or solicitation of a keynote speaker for your symposium if you wish</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Provide a list of titles and authors to the Organizing Committee</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Finalize the order of speakers for inclusion in the Congress Program</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Initial editing of abstracts for symposium talks (final editing will be done by the Scientific Committee)</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Keep open communication with the Organizing Committee about your progress, and provide relevant information so the website can be updated</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">Convene the symposium session at ICDXI (e.g., introducing speakers, ensuring speakers stay on time, coordinate questions, etc.)</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#2a5298] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path></svg>
                  <span class="text-gray-700 text-sm leading-relaxed">May allocate the last 15 minute slot of the symposium to open discussion</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="bg-gradient-to-r from-[#1e3c72] to-[#2a5298] px-6 py-4">
              <h3 class="text-lg font-bold text-white flex items-center gap-2.5">
                <svg class="w-5 h-5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
                Instructions for Submitting Title Suggestions
              </h3>
            </div>
            <div class="px-6 py-5 space-y-4">
              <p class="text-gray-700 text-sm leading-relaxed">
                Provide symposium title, name of all submitting convenors with their email addresses to the Chair Organizer <strong>Marija Ivković</strong> until <strong>1 June 2026</strong> to email address:
              </p>
              <a href="mailto:ivkovicmar@gmail.com" class="inline-flex items-center gap-2 bg-[#2a5298]/10 hover:bg-[#2a5298]/20 text-[#2a5298] font-semibold px-5 py-2.5 rounded-full transition-colors text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                ivkovicmar@gmail.com
              </a>
              <p class="text-gray-700 text-sm leading-relaxed">
                As symposia are received they will be posted to the Symposia page. Potential symposium convenors are asked to view the submitted symposia titles to limit overlap. Where applications for symposia overlap significantly, the Organizing Committee will reach out to symposia convenors to coordinate combining sessions.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Bio Modal -->
  <div id="member-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative flex items-center justify-center min-h-screen p-4">
      <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto relative" id="modal-content">
        <div class="border-t-4 border-t-[#2a5298] rounded-2xl overflow-hidden">
          <button type="button" id="modal-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors z-10" aria-label="Close">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          <div class="p-6 sm:p-8">
            <div class="flex flex-col items-center text-center mb-6">
              <img id="modal-image" src="" alt="" class="w-36 h-36 rounded-full object-cover shadow-lg mb-5 border-4 border-white ring-2 ring-gray-100" />
              <h3 id="modal-name" class="text-2xl font-bold text-gray-900"></h3>
              <p id="modal-role" class="text-sm text-[#2a5298] font-medium mt-1"></p>
              <p id="modal-institution" class="text-sm text-gray-500 mt-2"></p>
            </div>
            <div class="border-t border-gray-100 pt-5">
              <p id="modal-bio" class="text-sm text-gray-600 leading-relaxed"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />

  <script define:vars={{ plenaryLecturers }}>
    const allMembers = {};
    plenaryLecturers.forEach((m, i) => { allMembers[`pl-${i}`] = m; });

    const modal = document.getElementById('member-modal');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalClose = document.getElementById('modal-close');
    const modalImage = document.getElementById('modal-image');
    const modalName = document.getElementById('modal-name');
    const modalRole = document.getElementById('modal-role');
    const modalInstitution = document.getElementById('modal-institution');
    const modalBio = document.getElementById('modal-bio');

    function openModal(key) {
      const member = allMembers[key];
      if (!member || !member.bio) return;
      modalImage.src = member.image;
      modalImage.alt = member.name;
      modalName.textContent = member.name;
      modalRole.textContent = member.role || '';
      modalRole.style.display = member.role ? 'block' : 'none';
      modalInstitution.textContent = member.institution;
      modalBio.textContent = member.bio;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.member-card[data-index]').forEach((card) => {
      card.addEventListener('click', () => {
        openModal(card.dataset.index);
      });
    });

    modalBackdrop.addEventListener('click', closeModal);
    modalClose.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
</Layout>
