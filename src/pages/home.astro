---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Layout
  title="11th International Congress of Dipterology | ICD 2027"
  description="Join us in Zagreb, Croatia for the 11th International Congress of Dipterology, July 10-16, 2027. Register now for this premier scientific event."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700">
    <!-- Decorative elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="relative section-container py-20 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
        <div class="text-white animate-fade-in-up">
          <div class="inline-block mb-6 px-4 py-2 bg-white/10 backdrop-blur-lg rounded-full border border-white/20">
            <span class="text-sm font-semibold">July 10-16, 2027</span>
          </div>
          
          <h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 leading-tight">
            International Congress of
            <span class="block text-primary-200">Dipterology</span>
          </h1>
          
          <p class="text-xl lg:text-2xl text-white/90 mb-8 leading-relaxed">
            Join the world's leading researchers and scientists in Zagreb, Croatia for the 11th edition of this premier scientific gathering.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <Button variant="accent" size="lg" href="#newsletter">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
              </svg>
              Get Notified
            </Button>
            <Button variant="secondary" size="lg" href="#about">
              Learn More
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </Button>
          </div>

          <!-- Stats -->
          <div class="mt-12 grid grid-cols-3 gap-6">
            <div class="text-center lg:text-left">
              <div class="text-3xl lg:text-4xl font-bold mb-1">11th</div>
              <div class="text-sm text-white/70">Edition</div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl lg:text-4xl font-bold mb-1">500+</div>
              <div class="text-sm text-white/70">Participants</div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl lg:text-4xl font-bold mb-1">7</div>
              <div class="text-sm text-white/70">Days</div>
            </div>
          </div>
        </div>

        <!-- Right Image/Logo -->
        <div class="relative animate-fade-in delay-200">
          <div class="relative glass rounded-3xl p-8 lg:p-12 shadow-xl-colored">
            <img 
              src="/images/logo-icd-2027-wide.png" 
              alt="ICD 2027 Logo" 
              class="w-full h-auto animate-float"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <a href="#about" class="text-white/60 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="section-padding bg-gray-50">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-in-up">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          About the Congress
        </h2>
        <p class="text-xl text-gray-600 leading-relaxed">
          The International Congress of Dipterology is the premier global gathering for researchers, 
          scientists, and professionals in the field of fly research and taxonomy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature Card 1 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-100">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">World-Class Speakers</h3>
          <p class="text-gray-600 leading-relaxed">
            Learn from leading experts and pioneers in dipterology from universities 
            and research institutions worldwide.
          </p>
        </Card>

        <!-- Feature Card 2 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-200">
          <div class="w-14 h-14 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Cutting-Edge Research</h3>
          <p class="text-gray-600 leading-relaxed">
            Discover the latest research findings, methodologies, and innovations 
            in fly taxonomy and ecology.
          </p>
        </Card>

        <!-- Feature Card 3 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-300">
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Global Networking</h3>
          <p class="text-gray-600 leading-relaxed">
            Connect with researchers and professionals from over 50 countries 
            and build lasting collaborations.
          </p>
        </Card>

        <!-- Feature Card 4 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-100">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Workshops & Sessions</h3>
          <p class="text-gray-600 leading-relaxed">
            Participate in hands-on workshops, poster sessions, and interactive 
            discussions on specialized topics.
          </p>
        </Card>

        <!-- Feature Card 5 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-200">
          <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-orange-700 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Explore Zagreb</h3>
          <p class="text-gray-600 leading-relaxed">
            Experience the beautiful Croatian capital with its rich history, 
            culture, and Mediterranean atmosphere.
          </p>
        </Card>

        <!-- Feature Card 6 -->
        <Card variant="elevated" class="p-8 animate-fade-in-up delay-300">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Exhibition & Resources</h3>
          <p class="text-gray-600 leading-relaxed">
            Visit the exhibition area featuring publishers, equipment manufacturers, 
            and research organizations.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Program Section -->
  <section id="program" class="section-padding bg-white">
    <div class="section-container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Congress Program
        </h2>
        <p class="text-xl text-gray-600 leading-relaxed">
          Seven days of inspiring presentations, workshops, and networking opportunities.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="space-y-6">
          <!-- Timeline Item 1 -->
          <Card variant="elevated" class="p-6 lg:p-8 hover:scale-[1.02] transition-transform">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="flex-shrink-0 text-center md:text-left">
                <div class="inline-block px-4 py-2 bg-primary-100 rounded-lg">
                  <div class="text-2xl font-bold text-primary-700">July 10</div>
                  <div class="text-sm text-primary-600">Thursday</div>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Registration & Opening Ceremony</h3>
                <p class="text-gray-600 leading-relaxed mb-4">
                  Welcome reception, registration, and official opening ceremony with keynote presentations 
                  from distinguished speakers in the field.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Welcome Reception</span>
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Keynote</span>
                </div>
              </div>
            </div>
          </Card>

          <!-- Timeline Item 2 -->
          <Card variant="elevated" class="p-6 lg:p-8 hover:scale-[1.02] transition-transform">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="flex-shrink-0 text-center md:text-left">
                <div class="inline-block px-4 py-2 bg-accent-100 rounded-lg">
                  <div class="text-2xl font-bold text-accent-700">July 11-14</div>
                  <div class="text-sm text-accent-600">Fri - Mon</div>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Scientific Sessions</h3>
                <p class="text-gray-600 leading-relaxed mb-4">
                  Plenary sessions, oral presentations, poster sessions, and workshops covering 
                  the latest research in dipterology, taxonomy, and ecology.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Presentations</span>
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Posters</span>
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Workshops</span>
                </div>
              </div>
            </div>
          </Card>

          <!-- Timeline Item 3 -->
          <Card variant="elevated" class="p-6 lg:p-8 hover:scale-[1.02] transition-transform">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="flex-shrink-0 text-center md:text-left">
                <div class="inline-block px-4 py-2 bg-green-100 rounded-lg">
                  <div class="text-2xl font-bold text-green-700">July 15</div>
                  <div class="text-sm text-green-600">Tuesday</div>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Field Excursion</h3>
                <p class="text-gray-600 leading-relaxed mb-4">
                  Guided field trip to explore Croatian biodiversity, collecting sites, 
                  and natural habitats relevant to dipterology research.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Field Trip</span>
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Collecting</span>
                </div>
              </div>
            </div>
          </Card>

          <!-- Timeline Item 4 -->
          <Card variant="elevated" class="p-6 lg:p-8 hover:scale-[1.02] transition-transform">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="flex-shrink-0 text-center md:text-left">
                <div class="inline-block px-4 py-2 bg-purple-100 rounded-lg">
                  <div class="text-2xl font-bold text-purple-700">July 16</div>
                  <div class="text-sm text-purple-600">Wednesday</div>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Closing Ceremony & Gala Dinner</h3>
                <p class="text-gray-600 leading-relaxed mb-4">
                  Final presentations, awards ceremony, and farewell gala dinner celebrating 
                  the achievements and contributions of the congress.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Awards</span>
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-700">Gala Dinner</span>
                </div>
              </div>
            </div>
          </Card>
        </div>

        <!-- CTA -->
        <div class="mt-12 text-center">
          <p class="text-gray-600 mb-6">Full program details will be announced soon</p>
          <Button variant="primary" size="lg" href="#newsletter">
            Get Program Updates
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section id="location" class="section-padding bg-gray-50">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
        <div>
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
            Zagreb, Croatia
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed mb-8">
            The congress will take place in Zagreb, the vibrant capital of Croatia. 
            Known for its historic charm, beautiful architecture, and warm hospitality, 
            Zagreb offers the perfect setting for this international gathering.
          </p>

          <div class="space-y-6">
            <!-- Info Item -->
            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lg font-semibold text-gray-900 mb-2">Central Location</h4>
                <p class="text-gray-600">
                  Easily accessible from all major European cities with excellent transport connections.
                </p>
              </div>
            </div>

            <!-- Info Item -->
            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-accent-100 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-accent-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lg font-semibold text-gray-900 mb-2">Accommodation</h4>
                <p class="text-gray-600">
                  Wide range of hotels and accommodation options near the congress venue.
                </p>
              </div>
            </div>

            <!-- Info Item -->
            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lg font-semibold text-gray-900 mb-2">Cultural Experience</h4>
                <p class="text-gray-600">
                  Rich cultural heritage, museums, restaurants, and beautiful parks to explore.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-8">
            <Button variant="secondary" href="#" size="lg">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Venue Information (Coming Soon)
            </Button>
          </div>
        </div>

        <!-- Right Map Placeholder -->
        <Card variant="elevated" class="p-4">
          <div class="aspect-square bg-gradient-to-br from-primary-100 to-primary-200 rounded-xl flex items-center justify-center">
            <div class="text-center">
              <svg class="w-24 h-24 mx-auto text-primary-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <p class="text-primary-700 font-semibold text-lg">Interactive Map</p>
              <p class="text-primary-600 text-sm">Coming Soon</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section id="newsletter" class="section-padding bg-gradient-primary relative overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 right-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
            Stay Updated
          </h2>
          <p class="text-xl text-white/90 leading-relaxed">
            Sign up to receive the latest news, program updates, and important announcements 
            about the congress.
          </p>
        </div>

        <Card variant="glass" class="p-8 lg:p-12 border border-white/20">
          <NewsletterForm />
        </Card>

        <p class="text-center text-white/70 text-sm mt-6">
          We respect your privacy. Unsubscribe at any time.
        </p>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Scroll animations -->
  <script>
    // Intersection Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-up');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observe all cards and sections
    document.querySelectorAll('.card, section').forEach((el) => {
      observer.observe(el);
    });
  </script>
</Layout>
