---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

// Import icons
import envelope from 'heroicons/24/outline/envelope.svg?raw';
import phone from 'heroicons/24/outline/phone.svg?raw';
import mapPin from 'heroicons/24/outline/map-pin.svg?raw';
import clock from 'heroicons/24/outline/clock.svg?raw';
---

<Layout
  title="Contact Us | ICD 2027"
  description="Get in touch with the organizing committee of the 11th International Congress of Dipterology. Contact us for questions, registration, and general inquiries."
>
  <Header />

  <HeroCountdown />

  <!-- Contact Information Section -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- Email -->
        <Card variant="elevated" class="p-6 text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <span class="w-7 h-7 text-white" set:html={envelope} />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Email</h3>
          <a
            href="mailto:11icd2027@gmail.com"
            class="text-primary-600 hover:text-primary-700 transition-colors"
          >
            11icd2027@gmail.com
          </a>
        </Card>

        <!-- Phone -->
        <Card variant="elevated" class="p-6 text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <span class="w-7 h-7 text-white" set:html={phone} />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Phone</h3>
          <p class="text-gray-600">+385 1 XXX XXXX</p>
          <p class="text-sm text-gray-500 mt-1">(Coming soon)</p>
        </Card>

        <!-- Location -->
        <Card variant="elevated" class="p-6 text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <span class="w-7 h-7 text-white" set:html={mapPin} />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Location</h3>
          <p class="text-gray-600">Zagreb, Croatia</p>
          <p class="text-sm text-gray-500 mt-1">Hotel Westin</p>
        </Card>

        <!-- Office Hours -->
        <Card variant="elevated" class="p-6 text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <span class="w-7 h-7 text-white" set:html={clock} />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            Office Hours
          </h3>
          <p class="text-gray-600">Mon - Fri</p>
          <p class="text-sm text-gray-500 mt-1">9:00 AM - 5:00 PM CET</p>
        </Card>
      </div>

      <!-- Contact Details -->
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Technical organizer -->
          <Card variant="elevated" class="p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
              Technical organizer
            </h2>
            <p class="text-gray-600 leading-relaxed mb-2">
              e-Tours d.o.o., Ulica grada Vukovara 5/1, 10000 Zagreb
            </p>
            <p class="text-gray-600 leading-relaxed">
              Contact: Mirela Gašpar, Tel: +385 1 55 08 239, E-mail: <a href="mailto:icd2027@etours.hr" class="text-primary-600 hover:text-primary-700 transition-colors">icd2027@etours.hr</a>
            </p>
          </Card>

          <!-- Scientific Program -->
          <Card variant="elevated" class="p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
              Scientific Program
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              For questions regarding the scientific program, abstract
              submission, or sessions, please contact:
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="w-5 h-5 text-primary-600 mt-1" set:html={envelope} />
                <div>
                  <div class="font-semibold text-gray-900">Email</div>
                  <a
                    href="mailto:11icd2027@gmail.com"
                    class="text-primary-600 hover:text-primary-700 transition-colors"
                  >
                    11icd2027@gmail.com
                  </a>
                </div>
              </div>
            </div>
          </Card>
        </div>

        <!-- Additional Information -->
        <Card variant="elevated" class="p-8 mt-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            Additional Information
          </h2>
          <div class="prose prose-lg max-w-none">
            <p class="text-gray-600 leading-relaxed">
              We aim to respond to all inquiries within 2-3 business days.
              Please note that during peak periods (close to registration
              deadlines), response times may be slightly longer.
            </p>
            <p class="text-gray-600 leading-relaxed mt-4">
              For urgent matters, please include "URGENT" in your email subject
              line.
            </p>
          </div>
        </Card>

        <!-- Technical organizer -->
        <Card variant="elevated" class="p-8 mt-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            Technical organizer
          </h2>
          <p class="text-gray-700 leading-relaxed mb-2">
            e-Tours d.o.o., Ulica grada Vukovara 5/1, 10000 Zagreb
          </p>
          <p class="text-gray-700 leading-relaxed">
            Contact: Mirela Gašpar, Tel: +385 1 55 08 239, E-mail: <a href="mailto:icd2027@etours.hr" class="text-primary-600 hover:text-primary-700 transition-colors">icd2027@etours.hr</a>
          </p>
        </Card>
      </div>
    </div>
  </section>

  <Footer />

  <style>
    /* Ensure Heroicon SVGs display correctly */
    .w-14 span :global(svg),
    .w-5 span :global(svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
</Layout>
