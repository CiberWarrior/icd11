---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

import envelope from 'heroicons/24/outline/envelope.svg?raw';
import phone from 'heroicons/24/outline/phone.svg?raw';
---

<Layout
  title="Contact Us | ICD 2027"
  description="Get in touch with the organizing committee of the 11th International Congress of Dipterology. Contact us for questions, registration, and general inquiries."
>
  <Header />

  <HeroCountdown />

  <section class="section-padding bg-gradient-to-b from-slate-50 via-white to-blue-50/40">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-3">Contact</h2>
        <p class="text-lg text-gray-500">We are happy to answer any questions about ICD 2027.</p>
      </div>

      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Scientific inquiries -->
        <Card variant="elevated" class="p-0 overflow-hidden border border-blue-100/80 shadow-[0_20px_55px_rgba(15,23,42,0.10)]">
          <div class="bg-gradient-to-r from-primary-800 via-primary-700 to-blue-500 px-8 py-6">
            <h2 class="text-2xl font-bold text-white">Scientific Inquiries</h2>
            <p class="text-blue-100 text-sm mt-1">Scientific program, abstracts &amp; sessions</p>
          </div>
          <div class="p-8 bg-white">
            <p class="text-gray-500 leading-relaxed mb-6 text-sm">
              For questions regarding the scientific program, abstract submission, or sessions, please contact the Scientific Committee:
            </p>
            <div class="flex items-center gap-4 p-4 rounded-xl border border-blue-100 bg-blue-50/60 hover:bg-blue-50 transition-colors group">
              <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
                <span class="w-5 h-5 text-primary-600" set:html={envelope} />
              </div>
              <div>
                <div class="text-xs text-gray-400 uppercase tracking-wide mb-0.5">E-mail</div>
                <a
                  href="mailto:11icd2027@gmail.com"
                  class="text-primary-700 font-semibold hover:text-primary-800 transition-colors"
                >
                  11icd2027@gmail.com
                </a>
              </div>
            </div>
          </div>
        </Card>

        <!-- Technical organizer -->
        <Card variant="elevated" class="p-0 overflow-hidden border border-rose-100/80 shadow-[0_20px_55px_rgba(15,23,42,0.10)]">
          <div class="bg-gradient-to-r from-accent-600 via-accent-500 to-rose-500 px-8 py-6">
            <h2 class="text-2xl font-bold text-white">Technical Organizer</h2>
            <p class="text-rose-100 text-sm mt-1">Registration, payments &amp; logistics</p>
          </div>
          <div class="p-8 bg-white space-y-5">
            <div>
              <div class="text-xs text-gray-400 uppercase tracking-wide mb-1">Organization</div>
              <p class="text-gray-700 font-medium">e-Tours d.o.o.</p>
              <p class="text-gray-500 text-sm">Ulica grada Vukovara 5/1, 10000 Zagreb</p>
            </div>
            <div class="border-t border-gray-100 pt-5 space-y-3">
              <div>
                <div class="text-xs text-gray-400 uppercase tracking-wide mb-1">Contact person</div>
                <p class="text-gray-700 font-medium">Mirela Gašpar</p>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl border border-rose-100 bg-rose-50/50 hover:bg-rose-50 transition-colors">
                <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center flex-shrink-0">
                  <span class="w-5 h-5 text-rose-500" set:html={envelope} />
                </div>
                <div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mb-0.5">E-mail</div>
                  <a href="mailto:icd2027@etours.hr" class="text-gray-800 font-semibold hover:text-primary-700 transition-colors">
                    icd2027@etours.hr
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4 px-4 py-2">
                <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 text-gray-400">
                  <span class="w-5 h-5" set:html={phone} />
                </div>
                <div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mb-0.5">Tel</div>
                  <a href="tel:+38515508239" class="text-gray-500 hover:text-gray-700 transition-colors text-sm">
                    +385 1 55 08 239
                  </a>
                </div>
              </div>
            </div>
          </div>
        </Card>

      </div>
    </div>
  </section>

  <Footer />

  <style>
    .w-5 span :global(svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
</Layout>
