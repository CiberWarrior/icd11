---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';
import envelope from 'heroicons/24/outline/envelope.svg?raw';
import phone from 'heroicons/24/outline/phone.svg?raw';
---

<Layout
  title="Contact Us | ICD 2027"
  description="Get in touch with the organizing committee of the 11th International Congress of Dipterology. Contact us for questions, registration, and general inquiries."
>
  <Header />

  <HeroCountdown />

  <section class="section-padding bg-gradient-to-b from-slate-50 via-white to-blue-50/40">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-3">Contact</h2>
        <p class="text-lg text-gray-500">We are happy to answer any questions about ICDXI 2027</p>
      </div>

      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Scientific inquiries -->
        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100">
          <!-- Header -->
          <div class="bg-gradient-to-r from-[#1e3c72] to-[#2a5298] px-8 py-7">
            <div class="flex items-center gap-3 mb-1">
              <div class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center flex-shrink-0">
                <span class="w-4 h-4 text-white" set:html={envelope} />
              </div>
              <h2 class="text-xl font-bold text-white">Scientific Inquiries</h2>
            </div>
            <p class="text-blue-200 text-sm pl-11">Scientific program, abstracts &amp; sessions</p>
          </div>
          <!-- Body -->
          <div class="bg-white p-8 flex flex-col gap-6">
            <p class="text-gray-500 leading-relaxed text-sm">
              For questions regarding the scientific program, abstract submission, or sessions, please contact the Scientific Committee:
            </p>
            <a
              href="mailto:11icd2027@gmail.com"
              class="flex items-center gap-4 p-4 rounded-xl border border-[#2a5298]/20 bg-[#2a5298]/5 group"
            >
              <div class="w-10 h-10 rounded-xl bg-[#2a5298]/10 flex items-center justify-center flex-shrink-0">
                <span class="w-5 h-5 text-[#2a5298]" set:html={envelope} />
              </div>
              <div>
                <div class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">E-mail</div>
                <span class="text-[#2a5298] font-bold text-sm">11icd2027@gmail.com</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Technical organizer -->
        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100">
          <!-- Header -->
          <div class="bg-gradient-to-r from-primary-900 to-primary-800 px-8 py-7 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold text-white">Technical Organizer</h2>
              <p class="text-blue-200 text-sm mt-1">Registration, payments &amp; logistics</p>
            </div>
            <img
              src="/images/etours-logo.svg"
              alt="e-Tours logo"
              class="h-12 w-auto flex-shrink-0"
            />
          </div>
          <!-- Body -->
          <div class="bg-white p-8 flex flex-col gap-5">
            <div class="flex items-start gap-3 pb-5 border-b border-gray-100">
              <div>
                <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">Organization</p>
                <p class="text-gray-800 font-bold">e-Tours d.o.o.</p>
                <p class="text-gray-500 text-sm">Ulica grada Vukovara 5/1, 10000 Zagreb</p>
              </div>
            </div>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Contact person</p>
              <p class="text-gray-800 font-semibold">Mirela Gašpar</p>
            </div>
            <a
              href="mailto:icd2027@etours.hr"
              class="flex items-center gap-4 p-4 rounded-xl border border-red-100 bg-red-50/50 group"
            >
              <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
                <span class="w-5 h-5 text-red-600" set:html={envelope} />
              </div>
              <div>
                <div class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">E-mail</div>
                <span class="text-gray-800 font-bold text-sm">icd2027@etours.hr</span>
              </div>
            </a>
            <div class="flex items-center gap-4 px-1">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-gray-400">
                <span class="w-5 h-5" set:html={phone} />
              </div>
              <div>
                <div class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">Tel</div>
                <a href="tel:+38515508239" class="text-gray-600 font-medium text-sm">+385 1 55 08 239</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />

  <style>
    .w-5 span :global(svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
</Layout>
