---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCountdown from '../components/HeroCountdown.astro';
import Footer from '../components/Footer.astro';

const templateHref = '';

const symposia = [
  'Acalyptratae',
  'Advances in Afrotropical Dipterology',
  'Applied Dipterology',
  'Biodiversity surveys and conservation',
  'Calyptrate systematics and diversity',
  'Culicomorpha',
  'Empidoidea',
  'Lower Cyclorrhapha',
  'Psychodomorpha',
  'Tipulomorpha & Ptychopteromorpha',
  'Integrative taxonomy and vertical stratification of the fly fauna',
  'Deep time Dipterology',
  'Phylogenomics',
  'Taxonomy and ecology of lower Brachycera',
  'Diptera in Forensic Entomology',
  'Medical and Veterinary Diptera',
  'Advances in Automated Diptera Identification and Monitoring',
  'Diptera ecology and behaviour',
  'Bibionomorpha Systematics, Diversity and Ecology',
  'General',
];
---

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out;
  }

  .animate-scaleIn {
    animation: scaleIn 0.3s ease-out;
  }
</style>

<Layout
  title="Abstract Submission | ICD 2027"
  description="Submit your oral or poster abstract for the 11th International Congress of Dipterology. Download the Word template and upload your completed file by 31 March 2027."
>
  <Header />
  <HeroCountdown />

  <section class="section-padding bg-gradient-to-b from-slate-50 via-blue-50/20 to-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">

        <div class="text-center mb-12">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/20 flex items-center justify-center mx-auto mb-5 shadow-sm">
            <svg class="w-8 h-8 text-[#2a5298]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-[#2a5298] mb-6">Abstract Submission</h1>

          <div class="relative overflow-hidden bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-[#2a5298]/30 rounded-2xl shadow-lg max-w-xl mx-auto">
            <div class="absolute top-0 right-0 w-28 h-28 bg-blue-200/30 rounded-full -mr-14 -mt-14"></div>
            <div class="absolute bottom-0 left-0 w-20 h-20 bg-indigo-200/30 rounded-full -ml-10 -mb-10"></div>
            <div class="relative flex items-center justify-center gap-4 px-6 py-5 sm:px-8 sm:py-6">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-br from-[#2a5298] to-[#1e3c72] rounded-xl flex items-center justify-center shadow-md">
                  <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
              <div class="text-left">
                <p class="text-sm font-medium text-[#2a5298]/80">Submission period</p>
                <p class="text-2xl sm:text-3xl font-bold text-[#1e3c72]">
                  1 Oct 2026 – 31 Mar 2027
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 mb-8">
          <p class="text-gray-700 leading-relaxed">
            Only delegates who have registered and fully paid are permitted to submit abstracts.
          </p>
          <p class="text-gray-700 leading-relaxed mt-4">
            Abstracts must be submitted until <strong>31 March 2027</strong>. This deadline is to make sure your abstract will be published in the Abstract Volume, as we will be sending this out to press very shortly after the deadline.
          </p>
          <p class="text-gray-700 leading-relaxed mt-4">
            Once submitted, you should receive an acknowledgement of receipt. Abstract acceptance will be communicated by <strong>30 April 2027</strong>.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-3">How to submit</h2>
          <ol class="list-decimal pl-5 space-y-2 text-gray-700 leading-relaxed">
            <li>Download the official Word template.</li>
            <li>Prepare your abstract in that file, following the instructions below.</li>
            <li>Upload the completed Word document using the form on this page.</li>
          </ol>
          <p class="text-sm text-gray-500 mt-4">
            Title, keywords, authors, addresses and abstract text belong in the Word file — not in the web form. Use the same presenting author details in both.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 mb-8">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-900">Word template</h2>
              <p class="text-gray-600 mt-2">
                Use this file to prepare your abstract. Do not change the template formatting except where the instructions require italics, underline, or superscripts.
              </p>
            </div>
            {templateHref ? (
              <a
                href={templateHref}
                class="btn-primary shrink-0 px-6 py-3"
                download
              >
                Download template
              </a>
            ) : (
              <span class="inline-flex shrink-0 items-center rounded-lg border border-slate-200 bg-slate-50 px-6 py-3 text-sm font-semibold text-slate-500">
                Template coming soon
              </span>
            )}
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 mb-8 space-y-8">
          <h2 class="text-2xl font-bold text-gray-900">Instructions for preparing your abstracts</h2>

          <div>
            <h3 class="text-lg font-bold text-[#1e3c72] mb-2">Abstract title</h3>
            <p class="text-gray-700 leading-relaxed">
              Should be in lower case throughout, except the first word and proper nouns. Genus- and species-group names should be in italics, and their authors (but not dates) should be indicated, with family-group names indicated in parentheses.
            </p>
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Example</p>
              <p class="text-sm text-slate-700 leading-relaxed">
                A new record of aquatic dance fly (Empididae) for Croatia, <em>Wiedemannia artemisa</em> Ivković &amp; Plant
              </p>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-[#1e3c72] mb-2">Keywords</h3>
            <p class="text-gray-700 leading-relaxed">
              Not more than <strong>five</strong> keywords (or two-word phrases) should be provided, arranged in alphabetical order with the first keyword (and any proper nouns) capitalized. These keywords will be used to create the subject index for the Abstracts volume, so carefully consider which words and phrases to use, including words that also appear in the title.
            </p>
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Example</p>
              <p class="text-sm text-slate-700 leading-relaxed">
                Clinocerinae, Croatia, Empididae, new record, <em>Wiedemannia artemisa</em>
              </p>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-[#1e3c72] mb-2">Abstract authors</h3>
            <p class="text-gray-700 leading-relaxed">
              For all authors, use a standard full name format. For multi-authored abstracts, each name should be listed in full, in citation order, separated by commas and using superscript numbers for different addresses. The presenting author name should be underlined. Take care to ensure diacritic marks are correctly applied to author names as necessary.
            </p>
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Example</p>
              <p class="text-sm text-slate-700 leading-relaxed">
                <span class="underline">Marija Ivković</span><sup>1</sup>, Adrian C. Pont<sup>2</sup> &amp; Vlatka Mičetić Stanković<sup>3</sup>
              </p>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-[#1e3c72] mb-2">Author addresses</h3>
            <p class="text-gray-700 leading-relaxed">
              Provide the full postal address and email for the first author, and abridged addresses for subsequent authors, i.e., only institution (if applicable), city, state/province (if applicable), country. Each should be on a separate line.
            </p>
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Example</p>
              <p class="text-sm text-slate-700 leading-relaxed">
                <sup>1</sup>Department of Biology, Faculty of Science, University of Zagreb, HR-10000 Zagreb, Croatia, marija.ivkovic@biol.pmf.hr<br />
                <sup>2</sup>Oxford University Museum of Natural History, Oxford, United Kingdom<br />
                <sup>3</sup>Croatian Natural History Museum, Zagreb, Croatia
              </p>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-[#1e3c72] mb-2">Abstract text</h3>
            <p class="text-gray-700 leading-relaxed">
              The main abstract text should be a single paragraph in Arial 10 pt font, not exceeding <strong>2000 characters, including spaces</strong>. Please italicize genus- and species-group names and indicate their authors, but not dates, the first time they are mentioned in the text. Do not use any font style other than italics.
            </p>
          </div>
        </div>

        <form id="abstractForm" class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 space-y-6">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Upload your abstract</h2>
            <p class="text-gray-600 mt-2">
              Complete the fields below and attach your Word file. The person named here will receive the confirmation email.
            </p>
          </div>

          <div class="hidden" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">
                First name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                maxlength="100"
                autocomplete="given-name"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#2a5298] focus:border-transparent hover:border-gray-400 transition-all"
                placeholder="First name"
              />
            </div>
            <div>
              <label for="middleName" class="block text-sm font-medium text-gray-700 mb-2">
                Middle name <span class="text-gray-400 font-normal">(optional)</span>
              </label>
              <input
                type="text"
                id="middleName"
                name="middleName"
                maxlength="100"
                autocomplete="additional-name"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#2a5298] focus:border-transparent hover:border-gray-400 transition-all"
                placeholder="Middle name"
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
                Last name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                maxlength="100"
                autocomplete="family-name"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#2a5298] focus:border-transparent hover:border-gray-400 transition-all"
                placeholder="Last name"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              maxlength="254"
              autocomplete="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#2a5298] focus:border-transparent hover:border-gray-400 transition-all"
              placeholder="your email"
            />
          </div>

          <div class="rounded-xl border border-blue-100 bg-blue-50/50 px-5 py-4">
            <p class="text-sm leading-relaxed text-slate-700">
              <strong>Note:</strong> This form is for administrative purposes only (file naming and email confirmation). Your abstract title, authors, affiliations, keywords, presentation type, suggested symposium, and abstract text belong in the Word template.
            </p>
          </div>

          <div>
            <label for="file" class="block text-sm font-medium text-gray-700 mb-2">
              Word document <span class="text-red-500">*</span>
            </label>
            <div
              id="dropZone"
              class="relative rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center transition hover:border-[#2a5298]/50 hover:bg-blue-50/40"
            >
              <input
                type="file"
                id="file"
                name="file"
                required
                accept=".doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
              />
              <p class="text-sm font-medium text-slate-700">
                Drop your file here, or click to browse
              </p>
              <p class="text-xs text-slate-500 mt-1">
                .doc or .docx, maximum 5 MB
              </p>
              <p id="fileName" class="mt-3 text-sm font-semibold text-[#2a5298] hidden"></p>
            </div>
          </div>

          <div class="flex justify-center pt-2">
            <button
              type="submit"
              id="submitBtn"
              class="group relative px-10 py-5 bg-gradient-to-r from-[#2a5298] to-[#1e3c72] text-white text-lg font-bold rounded-xl hover:from-[#1e3c72] hover:to-[#2a5298] transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center gap-3"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
              </svg>
              <span>Submit abstract</span>
            </button>
          </div>
        </form>

        <div
          id="modalOverlay"
          class="hidden fixed inset-0 z-50 items-center justify-center bg-black bg-opacity-50 p-4 animate-fadeIn"
          role="dialog"
          aria-modal="true"
          aria-labelledby="modalTitle"
        >
          <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all animate-scaleIn">
            <div id="successMessage" class="hidden p-8">
              <div class="flex flex-col items-center text-center">
                <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mb-6">
                  <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <h3 id="modalTitle" class="text-2xl font-bold text-gray-900 mb-3">
                  Thank you, <span id="successName"></span>!
                </h3>
                <p class="text-gray-600 mb-2">Your abstract has been received.</p>
                <p class="text-sm text-gray-500 mb-6">
                  You should also receive an acknowledgement by email. Acceptance decisions will be communicated by 30 April 2027.
                </p>
                <button
                  type="button"
                  id="closeSuccessBtn"
                  class="btn-primary px-6 py-3"
                >
                  Close
                </button>
              </div>
            </div>

            <div id="errorMessage" class="hidden p-8">
              <div class="flex flex-col items-center text-center">
                <div class="w-20 h-20 bg-red-500 rounded-full flex items-center justify-center mb-6">
                  <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Submission unsuccessful</h3>
                <p class="text-gray-600 mb-2" id="errorText">There was an error submitting your abstract.</p>
                <p class="text-sm text-gray-500 mb-6">Please try again, or contact the organisers if the problem continues.</p>
                <button
                  type="button"
                  id="closeErrorBtn"
                  class="btn-secondary px-6 py-3"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('abstractForm') as HTMLFormElement | null;
  const fileInput = document.getElementById('file') as HTMLInputElement | null;
  const fileName = document.getElementById('fileName');
  const dropZone = document.getElementById('dropZone');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const modalOverlay = document.getElementById('modalOverlay');
  const successMessage = document.getElementById('successMessage');
  const successName = document.getElementById('successName');
  const errorMessage = document.getElementById('errorMessage');
  const errorText = document.getElementById('errorText');
  const closeSuccessBtn = document.getElementById('closeSuccessBtn');
  const closeErrorBtn = document.getElementById('closeErrorBtn');

  const maxBytes = 5 * 1024 * 1024;
  const allowedExtensions = ['.doc', '.docx'];
  const defaultSubmitHtml = submitBtn ? submitBtn.innerHTML : '';

  function isWordFile(file: File): boolean {
    const name = file.name.toLowerCase();
    return allowedExtensions.some((ext) => name.endsWith(ext));
  }

  function showSelectedFile(file: File | undefined) {
    if (!fileName) return;
    if (!file) {
      fileName.textContent = '';
      fileName.classList.add('hidden');
      return;
    }
    fileName.textContent = file.name;
    fileName.classList.remove('hidden');
  }

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file && !isWordFile(file)) {
      fileInput.value = '';
      showSelectedFile(undefined);
      showError('Only Word documents (.doc or .docx) are accepted.');
      return;
    }
    if (file && file.size > maxBytes) {
      fileInput.value = '';
      showSelectedFile(undefined);
      showError('The file must be 5 MB or smaller.');
      return;
    }
    showSelectedFile(file);
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.add('border-[#2a5298]', 'bg-blue-50/60');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.remove('border-[#2a5298]', 'bg-blue-50/60');
    });
  });

  dropZone?.addEventListener('drop', (event) => {
    const dragEvent = event as DragEvent;
    const file = dragEvent.dataTransfer?.files?.[0];
    if (!file || !fileInput) return;
    if (!isWordFile(file)) {
      showError('Only Word documents (.doc or .docx) are accepted.');
      return;
    }
    if (file.size > maxBytes) {
      showError('The file must be 5 MB or smaller.');
      return;
    }
    const transfer = new DataTransfer();
    transfer.items.add(file);
    fileInput.files = transfer.files;
    showSelectedFile(file);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !fileInput) return;

    const file = fileInput.files?.[0];
    if (!file) {
      showError('Please attach a Word document (.doc or .docx).');
      return;
    }
    if (!isWordFile(file)) {
      showError('Only Word documents (.doc or .docx) are accepted.');
      return;
    }
    if (file.size > maxBytes) {
      showError('The file must be 5 MB or smaller.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Uploading…</span>
    `;

    try {
      const response = await fetch('/api/abstract-submission', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.success) {
        showError(data.error || 'There was an error submitting your abstract.');
        resetSubmitButton();
        return;
      }

      const firstNameInput = document.getElementById('firstName') as HTMLInputElement | null;
      showSuccess(firstNameInput?.value.trim() || 'colleague');
      form.reset();
      showSelectedFile(undefined);
      resetSubmitButton();
    } catch {
      showError('There was an error submitting your abstract. Please try again.');
      resetSubmitButton();
    }
  });

  function resetSubmitButton() {
    if (!submitBtn) return;
    submitBtn.disabled = false;
    submitBtn.innerHTML = defaultSubmitHtml;
  }

  function showSuccess(name: string) {
    if (successName) successName.textContent = name;
    modalOverlay?.classList.remove('hidden');
    modalOverlay?.classList.add('flex');
    successMessage?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    document.body.style.overflow = 'hidden';
    closeSuccessBtn?.focus();
  }

  function showError(message: string) {
    if (errorText) errorText.textContent = message;
    modalOverlay?.classList.remove('hidden');
    modalOverlay?.classList.add('flex');
    errorMessage?.classList.remove('hidden');
    successMessage?.classList.add('hidden');
    document.body.style.overflow = 'hidden';
    closeErrorBtn?.focus();
  }

  function hideModal() {
    modalOverlay?.classList.add('hidden');
    modalOverlay?.classList.remove('flex');
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  closeSuccessBtn?.addEventListener('click', hideModal);
  closeErrorBtn?.addEventListener('click', hideModal);
  modalOverlay?.addEventListener('click', (event) => {
    if (event.target === modalOverlay) hideModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modalOverlay && !modalOverlay.classList.contains('hidden')) {
      hideModal();
    }
  });
</script>
